.{
    .name = "librsync",
    .version = "2.3.4",
    .release = 1,
    .description = "Library for computing and applying network deltas, with the rdiff tool",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        // Upstream publishes no checksum for the release archive.
        .{ .url = "https://github.com/librsync/librsync/releases/download/v2.3.4/librsync-2.3.4.tar.gz", .sha256 = "a0dedf9fff66d8e29e7c25d23c1f42beda2089fb4eac1b36e6acd8a29edfbd1f" },
    },
    // popt: the rdiff command line.
    .depends = .{ "glibc", "popt" },
    .build_depends = .{ "cmake", "ninja" },
}
