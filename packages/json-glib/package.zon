.{
    .name = "json-glib",
    .version = "1.10.8",
    .release = 1,
    .description = "JSON reading and writing library built on GLib",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/json-glib/1.10/json-glib-1.10.8.tar.xz", .sha256 = "55c5c141a564245b8f8fbe7698663c87a45a7333c2a2c56f06f811ab73b212dd" },
    },
    .depends = .{ "glibc", "glib" },
    // glib provides g-ir-scanner; docutils provides rst2man.
    .build_depends = .{ "meson", "ninja", "pkgconf", "python", "gettext", "docutils" },
}
