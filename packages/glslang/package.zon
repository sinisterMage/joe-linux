.{
    .name = "glslang",
    .version = "16.6.0",
    .release = 1,
    .description = "Khronos reference compiler for GLSL and HLSL shaders to SPIR-V (glslang, glslangValidator)",
    .license = "BSD-3-Clause AND BSD-2-Clause AND MIT AND Apache-2.0 AND GPL-3.0-or-later WITH Bison-exception-2.2",
    .sources = .{
        // Checked against the book's MD5. The release that goes with SPIR-V
        // tools 1.4.363.0 (the Vulkan SDK 1.4.363.0).
        .{ .url = "https://github.com/KhronosGroup/glslang/archive/16.6.0/glslang-16.6.0.tar.gz", .sha256 = "9c09b901149c729df745057dafa815278aaa101b84d2b6e14f16a42de52f97f2" },
    },
    // spirv-tools: libSPIRV-Tools-opt and libSPIRV-Tools (the optimizer
    // behind glslang's -O and the SPIRV library).
    .depends = .{ "glibc", "gcc", "spirv-tools" },
    // python: StandAlone generates its intrinsic header with a script.
    .build_depends = .{ "cmake", "ninja", "python", "spirv-headers" },
}
