.{
    .name = "sudo",
    .version = "1.9.17p2",
    .release = 2,
    .description = "Lets permitted users run commands as root or another user",
    .license = "ISC AND BSD-2-Clause AND BSD-3-Clause AND Zlib",
    .sources = .{
        .{ .url = "https://www.sudo.ws/dist/sudo-1.9.17p2.tar.gz", .sha256 = "4a38a1ab3adb1199257edc2a7c4a2bd714665eb605b04368843b06dada2cfcfb" },
    },
    .depends = .{ "glibc", "linux-pam", "libxcrypt", "openssl", "zlib" },
    .build_depends = .{"gettext"},
    // Set-uid root. Run by an ordinary user, a program holds only what its
    // seal declares (packages/linux/joe-lsm), so these declare all;
    // narrower lists are rule 3's work.
    .operations = .{
        .{ .programs = .{ "usr/bin/sudo" }, .allow = .{"all"} },
    },
}
