.{
    .name = "apache",
    .version = "2.4.71",
    .release = 1,
    .description = "Apache HTTP Server (httpd), with its modules and support programs",
    .license = "Apache-2.0",
    .sources = .{
        .{ .url = "https://archive.apache.org/dist/httpd/httpd-2.4.71.tar.bz2", .sha256 = "2bc5da5a33c247341de082717d4ebcb5cb49e8b73a05b7fddf7d5d6dc2f8de62" },
        .{ .url = "https://www.linuxfromscratch.org/patches/blfs/svn/httpd-blfs_layout-1.patch", .sha256 = "19cb001e8b09614ea4544d88706a327724fe93c39ea4293e8aa6d087e8762c6d" },
    },
    // Modules: OpenSSL (mod_ssl, mod_md), zlib (mod_deflate), Brotli,
    // nghttp2 (mod_http2, mod_proxy_http2), curl and jansson (mod_md), Lua
    // (mod_lua), libxml2 (mod_xml2enc, mod_proxy_html), systemd
    // (mod_systemd). libcrypt (libxcrypt) for htpasswd and libuuid
    // (util-linux) come with apr's link flags. perl runs apxs and
    // dbmmanage.
    .depends = .{ "glibc", "apr", "apr-util", "pcre2", "expat", "openssl", "zlib", "brotli", "nghttp2", "curl", "jansson", "lua", "libxml2", "systemd", "libxcrypt", "util-linux", "perl" },
    .build_depends = .{ "pkgconf", "perl" },
    // suexec is set-uid root, as the book installs it (chmod 4754): it
    // switches to the owner of a CGI program before running it.
    .operations = .{
        .{ .programs = .{"usr/lib/httpd/suexec"}, .allow = .{"all"} },
    },
}
