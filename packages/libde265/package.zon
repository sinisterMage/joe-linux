.{
    .name = "libde265",
    .version = "1.1.3",
    .release = 1,
    .description = "H.265/HEVC video decoder library, used for HEIF images",
    // The library is LGPL; the dec265 example program is MIT.
    .license = "LGPL-3.0-or-later AND MIT",
    .sources = .{
        .{ .url = "https://github.com/strukturag/libde265/releases/download/v1.1.3/libde265-1.1.3.tar.gz", .sha256 = "554228bd17788c99a7e63b37ab5634722190e6e2bf60c1dcb01cef328e133905" },
    },
    // C++.
    .depends = .{ "glibc", "gcc" },
    .build_depends = .{ "cmake", "ninja" },
}
