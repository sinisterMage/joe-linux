.{
    .name = "libgweather",
    .version = "4.6.0",
    .release = 1,
    .description = "Library for weather information from online services",
    .license = "GPL-2.0-or-later AND LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/libgweather/4.6/libgweather-4.6.0.tar.xz", .sha256 = "7f5d0e8c9685ef2ff46c2f3a57cae48d7bf3540b2d83921f889ef28e6a876788" },
    },
    .depends = .{ "glibc", "glib", "libsoup", "libxml2", "geocode-glib", "json-glib", "gweather-locations" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "vala" },
}
