.{
    .name = "gnome-calculator",
    .version = "51.1",
    .release = 1,
    .description = "GNOME Calculator",
    .license = "GPL-3.0-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/gnome-calculator/51/gnome-calculator-51.1.tar.xz", .sha256 = "03edf5972adc020b7e872233caba42f759e9879fc4b96f014580f136179c4fa0" },
    },
    // gmp, mpfr and mpc: arbitrary-precision arithmetic. libsoup: currency
    // exchange rates are downloaded from the IMF and the ECB.
    .depends = .{ "glibc", "glib", "gtk4", "libadwaita", "gtksourceview5", "libgee", "libsoup", "libxml2", "gmp", "mpfr", "mpc", "pango" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "itstool", "vala", "blueprint-compiler", "desktop-file-utils", "appstream" },
}
