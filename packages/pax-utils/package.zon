.{
    .name = "pax-utils",
    .version = "1.3.11",
    .release = 1,
    .description = "ELF utilities for checking binaries for security properties: scanelf, dumpelf, pspax, lddtree",
    .license = "GPL-2.0-only",
    .sources = .{
        .{ .url = "https://distfiles.gentoo.org/pub/proj/toolchain/pax-utils/pax-utils-1.3.11.tar.xz", .sha256 = "0ca000bca244e22589e38f1db0daaeaf4cc8b2960381fc7cf673cc3296b8d6f5" },
    },
    // libcap for pspax's capability listing. lddtree is the Python version
    // (pyelftools); symtree is a shell script.
    .depends = .{ "glibc", "libcap", "python", "pyelftools", "bash" },
    .build_depends = .{ "meson", "ninja", "pkgconf" },
}
