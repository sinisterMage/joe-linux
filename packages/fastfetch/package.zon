.{
    .name = "fastfetch",
    .version = "2.71.0",
    .release = 1,
    .description = "Shows information about the system next to the distribution's logo",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://github.com/fastfetch-cli/fastfetch/archive/2.71.0/fastfetch-2.71.0.tar.gz", .sha256 = "e71d93de41e8e4b2554c36d2ae51758112a21ecf3a8c98605a2c689251e62987" },
    },
    // fastfetch dlopen()s every optional library when it runs and does
    // without the ones that are missing, so only glibc is needed at run time.
    // The build needs their headers: they are the build_depends below.
    .depends = .{"glibc"},
    .build_depends = .{
        "cmake",  "ninja",  "pkgconf",
        "dbus",   "dconf",  "glib",
        "elfutils", "libdrm", "libva",
        "libxcb", "libxrandr", "wayland",
        "mesa",   "lua",    "sqlite",
        "zlib",
    },
}
