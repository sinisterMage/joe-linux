.{
    .name = "secrets",
    .version = "14.0",
    .release = 1,
    .description = "GNOME password manager for KeePass (KDBX) databases",
    .license = "GPL-3.0-only",
    .sources = .{
        .{ .url = "https://gitlab.gnome.org/World/secrets/-/releases/14.0/downloads/secrets-14.0.tar.xz", .sha256 = "44f82a6cfa06b84e066ab16ed83f4c1a8ee8df572c7207fa19b7b4a8a14ac376" },
    },
    // A Python program using GTK 4, libadwaita and GtkSourceView through
    // PyGObject. meson insists on every Python module below being
    // importable: pykeepass (the databases), pyotp (one-time codes),
    // validators, zxcvbn-rs-py (password strength), pykcs11 and
    // python-yubico (unlocking with smart cards and YubiKeys); pyhibp
    // checks passwords against Have I Been Pwned and pycryptodomex is used
    // directly as well.
    .depends = .{ "python", "pygobject", "glib", "gtk4", "libadwaita", "gtksourceview5", "pango", "gdk-pixbuf", "graphene", "pykeepass", "pyotp", "validators", "zxcvbn-rs-py", "pykcs11", "python-yubico", "pyhibp", "pycryptodomex" },
    // The Python modules are needed while configuring too, because meson
    // checks for them. appstream provides the gettext rules for the
    // metainfo file.
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "appstream", "pykeepass", "pyotp", "validators", "zxcvbn-rs-py", "pykcs11", "python-yubico" },
}
