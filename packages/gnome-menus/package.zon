.{
    .name = "gnome-menus",
    .version = "3.38.1",
    .release = 1,
    .description = "Implementation of the XDG desktop menu specification, with the GNOME menu layout",
    .license = "GPL-2.0-or-later AND LGPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/gnome-menus/3.38/gnome-menus-3.38.1.tar.xz", .sha256 = "1198a91cdbdcfb232df94e71ef5427617d26029e327be3f860c3b0921c448118" },
    },
    .depends = .{ "glibc", "glib" },
    // glib provides g-ir-scanner.
    .build_depends = .{ "pkgconf", "python", "gettext" },
}
