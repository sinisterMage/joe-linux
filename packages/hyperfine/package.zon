.{
    .name = "hyperfine",
    .version = "2.0.0",
    .release = 1,
    .description = "Command-line benchmarking tool",
    .license = "MIT OR Apache-2.0",
    .sources = .{
        .{ .url = "https://github.com/sharkdp/hyperfine/archive/v2.0.0/hyperfine-2.0.0.tar.gz", .sha256 = "f4b71df3c78e4cf752ca6fb6ebc4b025f7ea6a5ca5c48fea75f8a1fdb4c7d721" },
    },
    // cargo downloads the crates hyperfine depends on from crates.io; they
    // are not vendored yet.
    .network = true,
    // libgcc_s (gcc) for unwinding. Benchmarked commands run with sh.
    .depends = .{ "glibc", "gcc" },
    .build_depends = .{"rust"},
}
