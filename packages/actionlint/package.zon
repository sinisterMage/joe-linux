.{
    .name = "actionlint",
    .version = "1.7.12",
    .release = 1,
    .description = "Static checker for GitHub Actions workflow files",
    .license = "MIT",
    .sources = .{
        // Upstream's checksums file covers only the binary archives, not the
        // source archive.
        .{ .url = "https://github.com/rhysd/actionlint/archive/v1.7.12/actionlint-1.7.12.tar.gz", .sha256 = "454800bd4f854592bcfe79b161f71d56e35940eb7016e48a26dd356adc9d400a" },
    },
    // go downloads the modules actionlint depends on; they are not vendored
    // yet.
    .network = true,
    // Built without cgo, as upstream does, so no library is linked; as a
    // position-independent executable it is still relocated by glibc's
    // dynamic loader. It also checks run: scripts with shellcheck and
    // Python ones with pyflakes when those are installed; neither is
    // required.
    .depends = .{"glibc"},
    .build_depends = .{"go"},
}
