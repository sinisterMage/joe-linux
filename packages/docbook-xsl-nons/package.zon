.{
    .name = "docbook-xsl-nons",
    .version = "1.79.2",
    .release = 1,
    .description = "XSL stylesheets for transforming DocBook XML into HTML, man pages and other formats",
    .license = "DocBook-Stylesheet",
    .sources = .{
        .{ .url = "https://github.com/docbook/xslt10-stylesheets/releases/download/release/1.79.2/docbook-xsl-nons-1.79.2.tar.bz2", .sha256 = "ee8b9eca0b7a8f89075832a2da7534bce8c5478fc8fc2676f512d5d87d832102" },
        .{ .url = "https://www.linuxfromscratch.org/patches/blfs/svn/docbook-xsl-nons-1.79.2-stack_fix-1.patch", .sha256 = "a92c39715c54949ba9369add1809527b8f155b7e2a2b2e30cb4b39ee715f2e30" },
    },
    // docbook-xml owns /etc/xml/catalog and writes the entries there that
    // make these stylesheets reachable by their canonical URLs. The version
    // is repeated in packages/docbook-xml/build.sh: change both together.
    .depends = .{"docbook-xml"},
}
