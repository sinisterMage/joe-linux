.{
    .name = "nanobind",
    .version = "3.1.0",
    .release = 2,
    .description = "Small, efficient C++ and Python binding library (headers, sources and CMake files)",
    .license = "BSD-3-Clause",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/n/nanobind/nanobind-3.1.0.tar.gz", .sha256 = "6661e3dc1434d78781ccf7913442d90361dab395c3424efadb63bbb6ddea7ea3" },
    },
    // A pure Python package carrying the C++ headers and sources (with
    // tsl::robin_map) that extension modules compile in; "python -m
    // nanobind --cmake_dir" tells CMake where its config is. Projects that
    // use it list it, cmake and ninja as build_depends.
    .depends = .{"python"},
    // scikit-build-core runs cmake and ninja to lay out the wheel.
    .build_depends = .{ "python", "scikit-build-core", "cmake", "ninja" },
}
