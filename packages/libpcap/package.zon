.{
    .name = "libpcap",
    .version = "1.10.7",
    .release = 1,
    .description = "System-independent interface for user-level packet capture",
    .license = "BSD-3-Clause",
    .sources = .{
        .{ .url = "https://www.tcpdump.org/release/libpcap-1.10.7.tar.gz", .sha256 = "0b394ac90dbc0a9838ff97468e05c9c9a3e873dec2514cd58db65d859d296e31" },
    },
    // libnl: monitor mode on Wi-Fi interfaces; dbus: capturing D-Bus
    // traffic.
    .depends = .{ "glibc", "libnl", "dbus" },
    // bluez provides only the headers for Bluetooth capture.
    .build_depends = .{ "pkgconf", "flex", "bison", "bluez" },
}
