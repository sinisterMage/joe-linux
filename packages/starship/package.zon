.{
    .name = "starship",
    .version = "1.27.0",
    .release = 1,
    .description = "Minimal, fast and customizable prompt for any shell",
    .license = "ISC",
    .sources = .{
        .{ .url = "https://github.com/starship/starship/archive/v1.27.0/starship-1.27.0.tar.gz", .sha256 = "f1887ffa88a7ba437d2932501794047e28d03387996f7d1c364631c053cffc44" },
    },
    // cargo downloads the crates starship depends on from crates.io; they
    // are not vendored yet.
    .network = true,
    // libgcc_s (gcc) for unwinding. Git status comes from gix, the battery
    // module reads sysfs and notifications go over D-Bus through zbus, all
    // written in Rust.
    .depends = .{ "glibc", "gcc" },
    .build_depends = .{"rust"},
}
