.{
    .name = "gdk-pixbuf",
    .version = "2.44.8",
    .release = 1,
    .description = "Image loading library for GTK",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/gdk-pixbuf/2.44/gdk-pixbuf-2.44.8.tar.xz", .sha256 = "919f529512961a12e81cd4b4b466a48c3933469e7f9a310c6513cd4fb252ba3c" },
    },
    // Not glycin: glycin needs librsvg and librsvg needs gdk-pixbuf. The
    // book breaks that cycle by building gdk-pixbuf twice; here it is built
    // once, with its own loaders instead.
    .depends = .{ "glibc", "glib", "shared-mime-info", "libpng", "libjpeg-turbo", "tiff" },
    // glib provides g-ir-scanner and glib-compile-resources; docutils
    // provides rst2man.
    .build_depends = .{ "meson", "ninja", "pkgconf", "python", "gettext", "docutils" },
}
