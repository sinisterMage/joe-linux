.{
    .name = "sphinxcontrib-applehelp",
    .version = "2.0.0",
    .release = 1,
    .description = "Sphinx extension that outputs Apple help books",
    .license = "BSD-2-Clause",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/s/sphinxcontrib-applehelp/sphinxcontrib_applehelp-2.0.0.tar.gz", .sha256 = "2f29ef331735ce958efa4734873f084941970894c6090408b079c61b2e1c06d1" },
    },
    // Sphinx loads it; it does not depend on sphinx itself (that would be a
    // cycle, as in the book).
    .depends = .{"python"},
    .build_depends = .{ "python", "flit-core" },
}
