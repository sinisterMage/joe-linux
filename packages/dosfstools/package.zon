.{
    .name = "dosfstools",
    .version = "4.2",
    .release = 2,
    .description = "Utilities for creating, checking and labelling FAT file systems",
    .license = "GPL-3.0-or-later",
    .sources = .{
        .{ .url = "https://github.com/dosfstools/dosfstools/releases/download/v4.2/dosfstools-4.2.tar.gz", .sha256 = "64926eebf90092dca21b14259a5301b7b98e7b1943e8a201c7d726084809b527" },
    },
    .depends = .{"glibc"},
    .operations = .{
        // Making, checking and labelling FAT file systems, on any device or image
        // file.
        .{ .programs = .{ "usr/sbin/mkfs.fat", "usr/sbin/fatlabel", "usr/sbin/fsck.fat" }, .allow = .{ "cap:sys_admin", "cap:sys_rawio", "cap:dac_override", "write:*" } },
    },
}
