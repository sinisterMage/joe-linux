.{
    .name = "borgmatic",
    .version = "2.2.0",
    .release = 1,
    .description = "Configuration-driven wrapper around Borg: backups, pruning, checks and database dumps",
    .license = "GPL-3.0-or-later",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/b/borgmatic/borgmatic-2.2.0.tar.gz", .sha256 = "2f3a1e8f697b267e64fac9aaec628e68f89075854807436956c64d3b8542af3b" },
    },
    // borgmatic runs borg. The database hooks run pg_dump, mariadb-dump and
    // the like when configured; those are not dependencies. The Apprise
    // notifications and the "browse" interface (textual) are optional extras
    // and are not packaged.
    .depends = .{ "python", "borg", "jsonschema", "packaging", "psutil", "requests", "ruamel-yaml" },
    // The runtime modules are needed while building too: the shell
    // completions are generated by running borgmatic.
    .build_depends = .{ "python", "setuptools", "jsonschema", "packaging", "psutil", "requests", "ruamel-yaml" },
}
