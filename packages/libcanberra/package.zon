.{
    .name = "libcanberra",
    .version = "0.30",
    .release = 1,
    .description = "Implementation of the XDG sound theme and name specifications, for event sounds",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://0pointer.de/lennart/projects/libcanberra/libcanberra-0.30.tar.xz", .sha256 = "c2b671e67e0c288a69fc33dc1b6f1b534d07882c2aceed37004bf48c601afa72" },
        .{ .url = "https://www.linuxfromscratch.org/patches/blfs/svn/libcanberra-0.30-wayland-1.patch", .sha256 = "e48ce8f952c2b71e38866b95aa21e02437924ed6f9c4409b64e8e4cb392b9013" },
    },
    // libtool provides libltdl, which loads the backends. systemd provides
    // libudev. sound-theme-freedesktop is the default theme, at run time.
    .depends = .{ "glibc", "libvorbis", "libogg", "libtool", "alsa-lib", "gstreamer", "glib", "gtk3", "libx11", "systemd", "sound-theme-freedesktop" },
    .build_depends = .{"pkgconf"},
}
