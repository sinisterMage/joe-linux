.{
    .name = "exempi",
    .version = "2.6.6",
    .release = 1,
    .description = "Library for reading and writing XMP metadata, based on Adobe's XMP SDK",
    .license = "BSD-3-Clause",
    .sources = .{
        .{ .url = "https://libopenraw.freedesktop.org/download/exempi-2.6.6.tar.xz", .sha256 = "900fb9957be2095c78e5111b99c49378adac58161a358f52f93c55126f34eb8f" },
    },
    // gcc: libstdc++ (the SDK is C++). It links the system expat and zlib.
    .depends = .{ "glibc", "gcc", "expat", "zlib" },
}
