.{
    .name = "libfyaml",
    .version = "0.9.6",
    .release = 1,
    .description = "YAML 1.2 parser and emitter library",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://github.com/pantoniou/libfyaml/releases/download/v0.9.6/libfyaml-0.9.6.tar.gz", .sha256 = "a59cc3331e2eb903ec36933ad52a45888041cac31e44f553a00511131242c483" },
    },
    .depends = .{"glibc"},
    // libyaml is only linked into helper programs that are built and not
    // installed; it is listed so they are built the same way every time.
    .build_depends = .{ "pkgconf", "m4", "libyaml" },
}
