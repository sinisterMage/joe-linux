.{
    .name = "glycin",
    .version = "2.2.6",
    .release = 2,
    .description = "Sandboxed image loading library and its loaders",
    .license = "MPL-2.0 OR LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/glycin/2.2/glycin-2.2.6.tar.xz", .sha256 = "6a114aa1117ec2d7bd578c8cefd235d993304dedfd1a62575dc31be9a146b791" },
    },
    // cargo downloads the crates glycin depends on from crates.io; the
    // tarball does not vendor them.
    .network = true,
    // The loaders run inside bubblewrap. HEIF/AVIF links libheif, JPEG XL
    // links libjxl, and SVG links librsvg with cairo. Little CMS, which the
    // book lists, is not linked by this version (no lcms crate in Cargo.lock).
    .depends = .{ "glibc", "gcc", "glib", "fontconfig", "libseccomp", "libheif >=1.20", "libjxl", "librsvg", "cairo", "bubblewrap" },
    .build_depends = .{ "rust", "meson", "ninja", "pkgconf", "gettext", "vala" },
}
