.{
    .name = "libraw",
    .version = "0.22.3",
    .release = 1,
    .description = "Library for reading raw files from digital cameras",
    .license = "LGPL-2.1-only OR CDDL-1.0",
    .sources = .{
        .{ .url = "https://www.libraw.org/data/LibRaw-0.22.3.tar.gz", .sha256 = "789f3c33466210a1a0907f747a97c715d21bbf4af712f257fcbbd90111b227e4" },
    },
    // C++ with OpenMP (GCC's libgomp); libjpeg-turbo for lossy DNG files,
    // zlib for deflate-compressed DNG files, lcms2 for colour profiles.
    .depends = .{ "glibc", "gcc", "libjpeg-turbo", "zlib", "lcms2" },
    .build_depends = .{"pkgconf"},
}
