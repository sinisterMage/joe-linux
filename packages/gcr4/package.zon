.{
    .name = "gcr4",
    .version = "4.4.1",
    .release = 1,
    .description = "Certificate and key libraries and viewer for GTK 4 (gcr-4, gck-2)",
    .license = "LGPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/gcr/4.4/gcr-4.4.1.tar.xz", .sha256 = "c4442c15d4330f17a1f5194df08c576877af68412ab2521446a93bd5e24c931b" },
    },
    .depends = .{ "glibc", "glib", "libgcrypt", "p11-kit", "gtk4", "pango", "cairo", "gdk-pixbuf", "graphene" },
    // glib provides g-ir-scanner and glib-compile-resources.
    .build_depends = .{ "meson", "ninja", "pkgconf", "python", "vala", "gettext" },
}
