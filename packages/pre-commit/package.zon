.{
    .name = "pre-commit",
    .version = "4.7.0",
    .release = 1,
    .description = "Framework for managing and running multi-language git pre-commit hooks",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/p/pre-commit/pre_commit-4.7.0.tar.gz", .sha256 = "1f3deee12b914c8fa184bd2b5953391c2e4f36763e403d4a23dc9983fa7c6e86" },
    },
    // pre-commit runs git for everything it does. Hooks in other languages
    // need that language's toolchain, found at run time when installed.
    .depends = .{ "python", "cfgv", "identify", "nodeenv", "pyyaml", "python-virtualenv", "git" },
    .build_depends = .{ "python", "setuptools" },
}
