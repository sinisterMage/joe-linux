.{
    .name = "lilv",
    .version = "0.28.0",
    .release = 1,
    .description = "Library for hosting LV2 plugins, with the lv2ls, lv2info, lv2apply and lv2bench tools",
    .license = "ISC",
    .sources = .{
        // Checked against upstream's detached signature (.sig, David
        // Robillard's key 907D226E7E13FA337F014A083672782A9BF368F3).
        .{ .url = "https://download.drobilla.net/lilv-0.28.0.tar.xz", .sha256 = "8dcb70adb5cf072335115a6b091f4113710bdc73abaadaa3f9e9c1e55957b149" },
    },
    // lv2: lilv's headers include it (lilv-0.pc requires it) and hosts need
    // its specification bundles in /usr/lib/lv2. libsndfile is for
    // lv2apply and lv2bench.
    .depends = .{ "glibc", "zix", "serd", "sord", "sratom", "lv2", "libsndfile" },
    .build_depends = .{ "meson", "ninja", "pkgconf" },
}
