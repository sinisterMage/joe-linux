.{
    .name = "libcdio",
    .version = "2.4.0",
    .release = 1,
    .description = "Libraries for CD-ROM and CD image access, ISO 9660 and UDF (libcdio, libiso9660, libudf)",
    .license = "GPL-3.0-or-later",
    .sources = .{
        // Verified against the SHA-256 digest GitHub lists for the release asset.
        .{ .url = "https://github.com/libcdio/libcdio-C/releases/download/2.4.0/libcdio-2.4.0.tar.bz2", .sha256 = "8e6a305f81e45a78b41ce696d34497cc208d97075469d7304c11a6d44bf006ac" },
    },
    // gcc for libcdio++'s libstdc++; ncurses for cdda-player.
    .depends = .{ "glibc", "gcc", "ncurses" },
    .build_depends = .{ "pkgconf" },
}
