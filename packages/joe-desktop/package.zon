.{
    .name = "joe-desktop",
    .version = "0.2",
    .release = 4,
    .description = "The joe Linux desktop: GNOME on Wayland",
    .license = "MIT",
    // Depends on joe-base, whose directory layout cannot be installed over
    // the build root's.
    .build_only = true,
    .depends = .{
        "joe-base",
        "gdm",
        "gnome-shell",
        "gnome-session",
        "gnome-settings-daemon",
        "gnome-control-center",
        "gnome-keyring",
        "gnome-backgrounds",
        "nautilus",
        "gnome-terminal",
        "gnome-text-editor",
        "tecla",
        "ibus",
        "xwayland",
        "mesa",
        "xdg-desktop-portal-gnome",
        "xdg-user-dirs",
        "adwaita-icon-theme",
        "hicolor-icon-theme",
        "adwaita-fonts",
        "dejavu-fonts",
        "sound-theme-freedesktop",
        "networkmanager",
        "pipewire",
        "wireplumber",
        "gst-plugins-good",
        "glib-networking",
        "librsvg",
        "glycin",
        "polkit",
        "accountsservice",
        "upower",
        "udisks",
        "colord",
        // The first boot of a system nobody has an account on yet.
        "gnome-initial-setup",
        // Sound on Intel laptops of the last few years.
        "sof-firmware",
        // Applications.
        "firefox",
        "loupe",
        "evince",
        "showtime",
        "decibels",
        "gnome-calculator",
        "gnome-clocks",
        "gnome-weather",
        "gnome-maps",
        "gnome-characters",
        "gnome-font-viewer",
        "gnome-disk-utility",
        "baobab",
        "file-roller",
        "gnome-system-monitor",
        // Trash, network places, removable media and archives in Files.
        "gvfs",
        // Decoders for the formats people actually have (H.264, AAC, MP3).
        "gst-libav",
        // Text: scripts the Adwaita fonts lack, metric-compatible stand-ins
        // for the common office fonts, and a dictionary to check spelling
        // against.
        "noto-fonts",
        "noto-fonts-cjk",
        "noto-fonts-emoji",
        "liberation-fonts",
        "hunspell-en",
        // Command-line tools. libarchive is named for its unzip.
        "git",
        "rsync",
        "wget",
        "zip",
        "libarchive",
        "gnupg",
        "pinentry",
        "htop",
        "strace",
        "lsof",
        "pciutils",
        "usbutils",
    },
}
