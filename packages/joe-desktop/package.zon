.{
    .name = "joe-desktop",
    .version = "0.2",
    .release = 1,
    .description = "The joe Linux desktop: GNOME on Wayland",
    .license = "MIT",
    // Depends on joe-base, whose directory layout cannot be installed over
    // the build root's.
    .build_only = true,
    .depends = .{
        "joe-base",
        "gdm",
        "gnome-shell",
        "gnome-session",
        "gnome-settings-daemon",
        "gnome-control-center",
        "gnome-keyring",
        "gnome-backgrounds",
        "nautilus",
        "gnome-terminal",
        "gnome-text-editor",
        "tecla",
        "ibus",
        "xwayland",
        "mesa",
        "xdg-desktop-portal-gnome",
        "xdg-user-dirs",
        "adwaita-icon-theme",
        "hicolor-icon-theme",
        "adwaita-fonts",
        "dejavu-fonts",
        "sound-theme-freedesktop",
        "networkmanager",
        "pipewire",
        "wireplumber",
        "gst-plugins-good",
        "glib-networking",
        "librsvg",
        "glycin",
        "polkit",
        "accountsservice",
        "upower",
        "udisks",
        "colord",
    },
}
