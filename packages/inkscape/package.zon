.{
    .name = "inkscape",
    .version = "1.4.4",
    .release = 2,
    .description = "Vector graphics editor using SVG as its native format",
    .license = "GPL-2.0-or-later AND GPL-3.0-or-later AND LGPL-2.1-or-later AND LGPL-3.0-or-later AND MPL-1.1 AND OFL-1.1",
    .sources = .{
        .{ .url = "https://inkscape.org/gallery/item/59505/inkscape-1.4.4.tar.xz", .sha256 = "bbce5753a1e08b871a5cf16c665eb060700aaab9a6a379dc63f4c4d9b3b8856e" },
        .{ .url = "https://www.linuxfromscratch.org/patches/blfs/svn/inkscape-1.4.4-poppler_fixes-3.patch", .sha256 = "37707fbc5818e082071ebc511fe593637f79030eb59c14f98ad332f376cd9941" },
    },
    // The C++ bindings are the GTK 3 series (gtkmm-3.0 on glibmm-2.4 and
    // sigc++-2.0). gcc: libstdc++ and OpenMP's libgomp. potrace is Trace
    // Bitmap and the bucket fill. libcanberra provides the GTK 3 module that
    // GTK otherwise warns about. python, lxml and pygobject run the Python
    // extensions (see build.sh).
    .depends = .{
        "glibc",      "gcc",        "glib",      "gtk3",      "gdk-pixbuf", "cairo",     "pango",
        "harfbuzz",   "fontconfig", "freetype",  "gtkmm3",    "glibmm2.4",  "cairomm1.0", "pangomm1.4",
        "atkmm1.6",   "libsigcxx2", "gspell",    "boost",     "double-conversion", "gc", "gsl",
        "lcms2",      "poppler",    "potrace",   "libpng",    "libjpeg-turbo", "libxml2", "libxslt",
        "zlib",       "readline",   "libepoxy",  "libx11",    "libcanberra", "python",   "lxml",
        "pygobject",
        "libice",
        "libsm",
    },
    // perl provides pod2man for the manual pages.
    .build_depends = .{ "cmake", "ninja", "pkgconf", "gettext", "perl" },
}
