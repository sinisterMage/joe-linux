.{
    .name = "libwacom",
    .version = "2.20.0",
    .release = 1,
    .description = "Tablet description library and database for Wacom and similar devices",
    .license = "HPND-sell-variant",
    .sources = .{
        .{ .url = "https://github.com/linuxwacom/libwacom/releases/download/libwacom-2.20.0/libwacom-2.20.0.tar.xz", .sha256 = "370b45b5e05a91960df0aeb9c9481ae05846aab92ab2d4ec66945a0da4216888" },
    },
    // python: libwacom-update-db, which regenerates the hwdb file, is a Python script.
    .depends = .{ "glibc", "glib", "libevdev", "libgudev", "python" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "python" },
}
