.{
    .name = "watchexec",
    .version = "2.8.0",
    .release = 1,
    .description = "Executes commands in response to file modifications",
    .license = "Apache-2.0",
    .sources = .{
        .{ .url = "https://github.com/watchexec/watchexec/archive/v2.8.0/watchexec-2.8.0.tar.gz", .sha256 = "861496cd1e7d8546f770551893077e9b898fef1a6623d5e2207cf28c932e7738" },
    },
    // cargo downloads the crates watchexec depends on from crates.io; they
    // are not vendored yet.
    .network = true,
    // libgcc_s (gcc) for unwinding. Desktop notifications go over D-Bus
    // through zbus, which is written in Rust; commands run with sh.
    .depends = .{ "glibc", "gcc" },
    .build_depends = .{"rust"},
}
