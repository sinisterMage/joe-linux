.{
    .name = "taglib",
    .version = "2.3.2",
    .release = 1,
    .description = "Library for reading and editing the metadata of audio files",
    .license = "LGPL-2.1-only OR MPL-1.1",
    .sources = .{
        .{ .url = "https://taglib.org/releases/taglib-2.3.2.tar.gz", .sha256 = "3ca2d8afaa7f1cf7f6ed10e511ebc368bfacd6dcaa3dbfa690b89e502e8963dc" },
    },
    // zlib: compressed ID3v2 frames.
    .depends = .{ "glibc", "gcc", "zlib" },
    // utfcpp is header-only; the copy in 3rdparty/ is used only when it is
    // missing.
    .build_depends = .{ "cmake", "utf8cpp" },
}
