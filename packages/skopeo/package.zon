.{
    .name = "skopeo",
    .version = "1.25.1",
    .release = 1,
    .description = "Inspect, copy, sign and delete container images in registries and local stores",
    .license = "Apache-2.0",
    .sources = .{
        // Upstream publishes no checksum for the source archive. The Go
        // modules are vendored in it.
        .{ .url = "https://github.com/podman-container-tools/skopeo/archive/v1.25.1/skopeo-1.25.1.tar.gz", .sha256 = "8e889df322ec3d9457a2e3b61ba9fa77759dd81dac857514333fb3b837e98b65" },
    },
    // Linked: gpgme (signatures), libsubid (shadow), sqlite (the blob
    // info cache). containers-common holds the configuration.
    .depends = .{ "glibc", "gpgme", "shadow", "sqlite", "containers-common" },
    // btrfs-progs only for the headers of the btrfs storage driver.
    .build_depends = .{ "go", "pkgconf", "btrfs-progs", "go-md2man" },
}
