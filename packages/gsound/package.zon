.{
    .name = "gsound",
    .version = "1.0.3",
    .release = 1,
    .description = "GObject wrapper around libcanberra",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/gsound/1.0/gsound-1.0.3.tar.xz", .sha256 = "ca2d039e1ebd148647017a7f548862350bc9af01986d39f10cfdc8e95f07881a" },
    },
    .depends = .{ "glibc", "glib", "libcanberra" },
    // glib provides g-ir-scanner.
    .build_depends = .{ "meson", "ninja", "pkgconf", "python", "vala" },
}
