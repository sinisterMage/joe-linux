.{
    .name = "libavif",
    .version = "1.4.2",
    .release = 1,
    .description = "Library for encoding and decoding AVIF images, with the avifenc and avifdec tools",
    .license = "BSD-2-Clause AND IJG AND MIT",
    .sources = .{
        .{ .url = "https://github.com/AOMediaCodec/libavif/archive/v1.4.2/libavif-1.4.2.tar.gz", .sha256 = "2b645287340ba5a631d268b551dc2d72bd73ac33335962dd36dcdb6d8366921d" },
        // libargparse, built into avifgainmaputil: the commit that
        // cmake/Modules/LocalLibargparse.cmake would otherwise clone at
        // configure time. Upstream publishes no checksum for it.
        .{ .url = "https://github.com/kmurray/libargparse/archive/ee74d1b53bd680748af14e737378de57e2a0a954.tar.gz", .sha256 = "7727b0498851e5b6a6fcd734eb667a8a231897e2c86a357aec51cc0664813060", .file = "libargparse-ee74d1b53bd680748af14e737378de57e2a0a954.tar.gz" },
    },
    // libaom encodes (and decodes), dav1d decodes; libsharpyuv (from
    // libwebp) does the RGB to YUV conversion. libpng, zlib,
    // libjpeg-turbo and libxml2 are used by the tools; avifgainmaputil is
    // C++ (gcc).
    .depends = .{ "glibc", "gcc", "libaom", "dav1d", "libwebp", "libpng", "zlib", "libjpeg-turbo", "libxml2" },
    .build_depends = .{ "cmake", "ninja", "pkgconf" },
}
