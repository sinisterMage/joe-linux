.{
    .name = "curtail",
    .version = "1.17.0",
    .release = 1,
    .description = "Image compressor for PNG, JPEG, WebP and SVG files",
    .license = "GPL-3.0-or-later",
    .sources = .{
        .{ .url = "https://github.com/Huluti/Curtail/archive/1.17.0/curtail-1.17.0.tar.gz", .sha256 = "1ce89b982022300cbfe073342f9c96a8bf2a8f3c371fa6a2805ff437fa478e31" },
    },
    // A Python program using GTK 4 and libadwaita through PyGObject. The
    // compression is done by the programs it runs: oxipng and pngquant
    // (PNG), jpegoptim (JPEG), cwebp (libwebp) and scour (SVG); xdg-open
    // (xdg-utils) shows the results.
    .depends = .{ "python", "pygobject", "glib", "gtk4", "libadwaita", "gdk-pixbuf", "oxipng", "pngquant", "jpegoptim", "libwebp", "scour", "xdg-utils" },
    // appstream provides the gettext rules for the metainfo file.
    .build_depends = .{ "meson", "ninja", "gettext", "blueprint-compiler", "appstream" },
}
