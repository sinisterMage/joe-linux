.{
    .name = "soundtouch",
    .version = "2.4.1",
    .release = 1,
    .description = "Library for changing the tempo, pitch and playback rate of audio",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://www.surina.net/soundtouch/soundtouch-2.4.1.tar.gz", .sha256 = "e07abf20ce8f95850c280132e1f61ad400fc1f4011b7fac698a503de6aab6733" },
    },
    .depends = .{ "glibc", "gcc" },
    // ./bootstrap regenerates the build system with autoreconf, as the book does.
    .build_depends = .{ "autoconf", "automake", "libtool", "pkgconf" },
}
