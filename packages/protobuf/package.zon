.{
    .name = "protobuf",
    .version = "36.2",
    .release = 1,
    .description = "Protocol Buffers, Google's data interchange format: protoc and the C++ libraries",
    .license = "BSD-3-Clause",
    .sources = .{
        .{ .url = "https://github.com/protocolbuffers/protobuf/releases/download/v36.2/protobuf-36.2.tar.gz", .sha256 = "3d9642a662d10e68ebae5e53f14dcce5105684212d5078f8e0d47d1ab3ae6b64" },
    },
    // zlib is used by the gzip streams in libprotobuf.
    .depends = .{ "glibc", "gcc", "abseil-cpp", "zlib" },
    .build_depends = .{ "cmake", "ninja" },
}
