.{
    .name = "prometheus-node-exporter",
    .version = "1.12.1",
    .release = 1,
    .description = "Prometheus exporter for hardware and kernel metrics (node_exporter)",
    .license = "Apache-2.0",
    .sources = .{
        // GitHub's archive of the v1.12.1 tag. The release's sha256sums.txt
        // covers only the binaries; there is no checksum for the source
        // archive.
        .{ .url = "https://github.com/prometheus/node_exporter/archive/v1.12.1/node_exporter-1.12.1.tar.gz", .sha256 = "a90f1df0fde58d216d4a7d342e64831d2e3257db8084deadbe69754d34b15142" },
    },
    // go downloads the modules node_exporter depends on; they are not
    // vendored yet.
    .network = true,
    // Built without cgo, as upstream does on Linux (.promu.yml; cgo is
    // only for the macOS and NetBSD builds), so no library is linked; as a
    // position-independent executable it is still relocated by glibc's
    // dynamic loader.
    .depends = .{"glibc"},
    .build_depends = .{"go"},
}
