.{
    .name = "perl-http-message",
    .version = "7.04",
    .release = 1,
    .description = "HTTP style message (base class)",
    .license = "Artistic-1.0-Perl OR GPL-1.0-or-later",
    .sources = .{
        // SHA-256 verified against MetaCPAN release metadata and this author's
        // https://cpan.metacpan.org/authors/id/O/OA/OALDERS/CHECKSUMS (parsed as data, never executed).
