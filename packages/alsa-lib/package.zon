.{
    .name = "alsa-lib",
    .version = "1.2.16.1",
    .release = 1,
    .description = "ALSA sound library, with the use case manager configuration files",
    .license = "LGPL-2.1-or-later AND BSD-3-Clause",
    .sources = .{
        .{ .url = "https://www.alsa-project.org/files/pub/lib/alsa-lib-1.2.16.1.tar.bz2", .sha256 = "f740db7f488255944ffd4428416ee3390a96742856916433df468c281436480e" },
        .{ .url = "https://www.alsa-project.org/files/pub/lib/alsa-ucm-conf-1.2.16.1.tar.bz2", .sha256 = "cf3d1c07e089a83c4ece2c20f05dd6a8aab7fcd108768c38811386880575492b" },
    },
    // systemd (udev and logind) gives the user at the seat access to the
    // sound devices at run time.
    .depends = .{ "glibc", "systemd" },
}
