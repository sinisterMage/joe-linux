.{
    .name = "slirp4netns",
    .version = "1.3.7",
    .release = 1,
    .description = "User-mode networking for unprivileged network namespaces, using libslirp",
    .license = "GPL-2.0-or-later",
    .sources = .{
        // Upstream's SHA256SUMS covers only its static binary, not the
        // source archive.
        .{ .url = "https://github.com/rootless-containers/slirp4netns/archive/v1.3.7/slirp4netns-1.3.7.tar.gz", .sha256 = "79079c69149c9d7ec81f5f5a7e705951dc788bc5e300849e3adfef69f8232836" },
    },
    .depends = .{ "glibc", "glib", "libslirp", "libseccomp" },
    // sandbox.c includes libcap's <sys/capability.h> for its constants but
    // calls capset(2) itself, so libcap is not linked.
    .build_depends = .{ "autoconf", "automake", "pkgconf", "libcap" },
}
