.{
    .name = "libadwaita",
    .version = "1.10.0",
    .release = 1,
    .description = "Building blocks for modern GNOME applications",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/libadwaita/1.10/libadwaita-1.10.0.tar.xz", .sha256 = "b1bf56239269d101a6391ad4553c910eff9cc6170b803916405477ef60a66c84" },
    },
    // The book lists AppStream and sassc as required. This release parses
    // AppStream metadata with ministream, which is bundled and linked
    // statically, and ships the compiled stylesheet (src/stylesheet/gtk.css),
    // so neither is used.
    .depends = .{ "glibc", "glib", "gtk4", "pango", "cairo", "gdk-pixbuf", "graphene", "fribidi" },
    // glib provides g-ir-scanner and glib-compile-resources; libxml2 the
    // xmllint that glib-compile-resources runs.
    .build_depends = .{ "meson", "ninja", "pkgconf", "python", "vala", "gettext", "libxml2" },
}
