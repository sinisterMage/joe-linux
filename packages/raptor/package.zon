.{
    .name = "raptor",
    .version = "2.0.16",
    .release = 1,
    .description = "Raptor 2, the RDF syntax library: parsers and serializers for RDF/XML, Turtle, N-Triples and more, with the rapper tool",
    .license = "LGPL-2.1-or-later OR GPL-2.0-or-later OR Apache-2.0",
    .sources = .{
        // Checked against the book's MD5 (0a71f13b6eaa0a04bf411083d89d7bc2).
        .{ .url = "https://download.librdf.org/source/raptor2-2.0.16.tar.gz", .sha256 = "089db78d7ac982354bdbf39d973baf09581e6904ac4c92a98c5caadb3de44680" },
    },
    // libxml2 for the XML parsers, libxslt for GRDDL, curl for fetching
    // URIs, ICU for the Unicode NFC check of RDF/XML literals.
    .depends = .{ "glibc", "libxml2", "libxslt", "curl", "icu" },
    .build_depends = .{"pkgconf"},
}
