.{
    .name = "nodeenv",
    .version = "1.12.0",
    .release = 1,
    .description = "Tool to create isolated Node.js environments",
    .license = "BSD-3-Clause",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/n/nodeenv/nodeenv-1.12.0.tar.gz", .sha256 = "4ea7f88339310afebc3253f2c7a91b94bacf97d73a36a5c108962abdfaca501e" },
    },
    // It downloads Node.js releases, or with --node=system uses the
    // installed nodejs; neither is needed to install it.
    .depends = .{"python"},
    .build_depends = .{ "python", "setuptools", "setuptools-scm" },
}
