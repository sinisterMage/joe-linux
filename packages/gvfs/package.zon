.{
    .name = "gvfs",
    .version = "1.62.0",
    .release = 2,
    .description = "GIO virtual file systems: trash, recent files, network places and removable media",
    .license = "LGPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/gvfs/1.62/gvfs-1.62.0.tar.xz", .sha256 = "dd8e6c255fd3bed5eeb190b59027c88b38e63c1be0932ddce9cfeb48f3c43d0f" },
    },
    // lsof is run to name the programs that keep a volume from unmounting.
    // The sftp backend runs `ssh` (openssh) when it is installed; it is not
    // listed because nothing else in gvfs needs it.
    .depends = .{ "glibc", "glib", "dbus", "gsettings-desktop-schemas", "systemd", "gcr4", "libsecret", "libsoup", "libxml2", "libgudev", "libusb", "udisks", "fuse3", "polkit", "libcap", "libarchive", "gnome-online-accounts", "lsof", "libimobiledevice", "usbmuxd", "libgphoto2", "libmtp", "avahi", "samba" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext" },
}
