.{
    .name = "dejagnu",
    .version = "1.6.3",
    .release = 1,
    .description = "Framework for testing other programs, used by the GNU toolchain's test suites",
    .license = "GPL-3.0-or-later",
    .sources = .{
        .{ .url = "https://ftpmirror.gnu.org/dejagnu/dejagnu-1.6.3.tar.gz", .sha256 = "87daefacd7958b4a69f88c6856dbd1634261963c414079d0c371f589cd66a2e3" },
    },
    // runtest is a shell script that runs its Tcl framework with expect.
    .depends = .{ "bash", "expect" },
    .build_depends = .{},
}
