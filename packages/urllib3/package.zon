.{
    .name = "urllib3",
    .version = "2.7.0",
    .release = 1,
    .description = "HTTP client library for Python with connection pooling and TLS verification",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/u/urllib3/urllib3-2.7.0.tar.gz", .sha256 = "231e0ec3b63ceb14667c67be60f2f2c40a518cb38b03af60abc813da26505f4c" },
    },
    // Brotli, zstd and SOCKS support are optional extras, used when the
    // modules are importable; none is required.
    .depends = .{"python"},
    .build_depends = .{ "python", "hatchling", "hatch-vcs", "setuptools-scm" },
}
