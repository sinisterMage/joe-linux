+        if( psDefn->Projection == 1024 ) /* Popular Visualisation Pseudo Mercator */
+            sprintf( szProjection+strlen(szProjection),
+                    "+proj=webmerc +lon_0=%.9f +x_0=%.3f +y_0=%.3f ",
+                    psDefn->ProjParm[1],
+                    dfFalseEasting,
