.{
    .name = "libgeotiff",
    .version = "1.7.4",
    .release = 2,
    .description = "Library and tools (listgeo, geotifcp) for georeferencing information in GeoTIFF files",
    .license = "MIT AND LicenseRef-Public-Domain",
    .sources = .{
        // Upstream publishes no checksum for this release (its GitHub asset
        // is the same file as the download.osgeo.org one).
        .{ .url = "https://download.osgeo.org/geotiff/libgeotiff/libgeotiff-1.7.4.tar.gz", .sha256 = "c598d04fdf2ba25c4352844dafa81dde3f7fd968daa7ad131228cd91e9d3dc47" },
    },
    .depends = .{ "glibc", "proj", "tiff", "libjpeg-turbo", "zlib" },
    .build_depends = .{"pkgconf"},
}
