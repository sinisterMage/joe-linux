.{
    .name = "shaderc",
    .version = "2026.4",
    .release = 1,
    .description = "Google's shader compiler tools and library: glslc and libshaderc, GLSL and HLSL to SPIR-V",
    .license = "Apache-2.0",
    .sources = .{
        // Checked against the book's MD5.
        .{ .url = "https://github.com/google/shaderc/archive/v2026.4/shaderc-2026.4.tar.gz", .sha256 = "f06ce5bcca94e5df7f34e115743597d0ad2e13c5fe9213c67dc8c76031241947" },
    },
    // glslang: libglslang and libSPIRV; spirv-tools: libSPIRV-Tools and
    // libSPIRV-Tools-opt.
    .depends = .{ "glibc", "gcc", "glslang", "spirv-tools" },
    .build_depends = .{ "cmake", "ninja", "python", "spirv-headers" },
}
