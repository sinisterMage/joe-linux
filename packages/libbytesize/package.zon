.{
    .name = "libbytesize",
    .version = "2.12",
    .release = 1,
    .description = "Library for operations with sizes in bytes, with Python bindings and the bscalc tool",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://github.com/storaged-project/libbytesize/releases/download/2.12/libbytesize-2.12.tar.gz", .sha256 = "8356bac2cafd2f31f39bf1ad373cef8448cab08b817aeaee5c526d54e81c3c5a" },
    },
    .depends = .{ "glibc", "gmp", "mpfr", "pcre2", "python" },
    .build_depends = .{ "pkgconf", "gettext", "pygments" },
}
