.{
    .name = "gmp",
    .version = "6.3.0",
    .release = 3,
    .description = "Library for arbitrary precision arithmetic",
    .license = "LGPL-3.0-or-later OR GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://ftpmirror.gnu.org/gmp/gmp-6.3.0.tar.xz", .sha256 = "a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898" },
    },
    // libgmpxx also needs libstdc++ (gcc) at run time. Not listed: gcc depends on
    // gmp, and gmp is built first.
    .depends = .{"glibc"},
    .build_depends = .{"m4"},
}
