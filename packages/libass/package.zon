.{
    .name = "libass",
    .version = "0.17.5",
    .release = 1,
    .description = "Renderer for subtitles in the ASS/SSA (Advanced Substation Alpha/Substation Alpha) format",
    .license = "ISC",
    .sources = .{
        .{ .url = "https://github.com/libass/libass/releases/download/0.17.5/libass-0.17.5.tar.xz", .sha256 = "2dca25c0e0c837ddf00b52011b3f82cac1e4ddd3ad018227806b0c2288864acc" },
    },
    .depends = .{ "glibc", "freetype", "fribidi", "harfbuzz", "fontconfig" },
    // nasm assembles the x86 rasterizer and blur code.
    .build_depends = .{ "pkgconf", "nasm" },
}
