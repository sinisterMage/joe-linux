.{
    .name = "bluez",
    .version = "5.88",
    .release = 2,
    .description = "Bluetooth protocol stack: bluetoothd, obexd, bluetoothctl and libbluetooth",
    .license = "GPL-2.0-or-later AND LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://www.kernel.org/pub/linux/bluetooth/bluez-5.88.tar.xz", .sha256 = "6952c39eb5f8b0ee712cc50ab3bcff03be17c410dd97ca640f4849d9a1653ba3" },
    },
    // systemd: libudev, and libsystemd for obexd. readline: bluetoothctl.
    .depends = .{ "glibc", "glib", "dbus", "libical", "readline", "systemd" },
    .build_depends = .{ "pkgconf", "docutils" },
    .operations = .{
        // Bluetooth: its socket family and adapters, and the pairings it keeps.
        .{ .programs = .{"usr/libexec/bluetooth/bluetoothd"}, .allow = .{ "net", "cap:net_admin", "cap:net_bind_service", "cap:net_raw", "write:/var/lib/bluetooth" } },
    },
}
