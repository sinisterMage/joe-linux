.{
    .name = "docker",
    .version = "29.10.0",
    .release = 1,
    .description = "Docker Engine (dockerd, docker-proxy, docker-init) and the docker command line client",
    .license = "Apache-2.0 AND MIT",
    .sources = .{
        // The Moby engine and the docker CLI, released together under the
        // same version, and tini, which the engine ships as docker-init
        // (hack/dockerfile/install/tini.installer names v0.19.0). Upstream
        // publishes no checksums for the source archives. The Go modules
        // are vendored in both Go archives.
        .{ .url = "https://github.com/moby/moby/archive/docker-v29.10.0/moby-29.10.0.tar.gz", .sha256 = "52ee9d504b0ff278fb591956d761f6f5a8f0008b6bc6d19bc2916856b3f725b9" },
        .{ .url = "https://github.com/docker/cli/archive/v29.10.0/docker-cli-29.10.0.tar.gz", .sha256 = "7b955259e070e839586faff4957ce71484380f3aff5caf519470c1448f9e9192" },
        .{ .url = "https://github.com/krallin/tini/archive/v0.19.0/tini-0.19.0.tar.gz", .sha256 = "0fd35a7030052acd9f58948d1d900fe1e432ee37103c5561554408bdac6bbf0d" },
    },
    // dockerd links libsystemd (systemd) for reading journald logs. It runs
    // containers through containerd and runc, programs the firewall with
    // the iptables commands (the default back end) or nft, decompresses
    // xz layers with xz and fetches git build contexts with git.
    .depends = .{
        "glibc",    "systemd", "containerd", "runc",
        "iptables", "nftables", "xz",        "git",
    },
    // cmake builds tini; glibc's static libc.a makes docker-init static,
    // as it must be, because it runs inside containers.
    .build_depends = .{ "go", "pkgconf", "cmake", "go-md2man" },
}
