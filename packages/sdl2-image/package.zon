.{
    .name = "sdl2-image",
    .version = "2.8.12",
    .release = 1,
    .description = "Image file loading library for SDL 2 (SDL2_image)",
    .license = "Zlib",
    .sources = .{
        // The SDL 2 release series. Checked against the SHA-256 digest
        // GitHub gives for the release asset.
        .{ .url = "https://github.com/libsdl-org/SDL_image/releases/download/release-2.8.12/SDL2_image-2.8.12.tar.gz", .sha256 = "393f5efb50536ec13ca4f4affb69cc9966d3c3f969e6c5e701faddf9f9785381" },
    },
    // The format libraries are linked directly rather than loaded at run
    // time: libavif, libjpeg, libjxl, libpng, libtiff, libwebp and
    // libwebpdemux.
    .depends = .{ "glibc", "sdl2", "libavif", "libjpeg-turbo", "libjxl", "libpng", "tiff", "libwebp" },
    .build_depends = .{ "cmake", "ninja", "pkgconf" },
}
