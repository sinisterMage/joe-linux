.{
    .name = "physfs",
    .version = "3.2.0",
    .release = 1,
    .description = "PhysicsFS, a portable library for reading game data from archives (ZIP, 7z, ISO, WAD, ...)",
    .license = "Zlib",
    .sources = .{
        // GitHub's archive of the release-3.2.0 tag, the newest release
        // (icculus.org's download directory stops at 3.0.2); upstream
        // publishes no checksum.
        .{ .url = "https://github.com/icculus/physfs/archive/release-3.2.0/physfs-3.2.0.tar.gz", .sha256 = "1991500eaeb8d5325e3a8361847ff3bf8e03ec89252b7915e1f25b3f8ab5d560" },
    },
    .depends = .{"glibc"},
    .build_depends = .{ "cmake", "ninja" },
}
