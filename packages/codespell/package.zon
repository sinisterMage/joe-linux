.{
    .name = "codespell",
    .version = "2.4.3",
    .release = 1,
    .description = "Checker for common misspellings in source code and text files",
    // The dictionaries are derived from English Wikipedia (CC-BY-SA-3.0).
    .license = "GPL-2.0-only AND CC-BY-SA-3.0",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/c/codespell/codespell-2.4.3.tar.gz", .sha256 = "cbe085e331227b37bb86ef8bddd08dc768c704ee9a07ca869852c093fa2793e2" },
    },
    // --hard-encoding-detection needs chardet, which is not packaged.
    .depends = .{"python"},
    .build_depends = .{ "python", "setuptools", "setuptools-scm" },
}
