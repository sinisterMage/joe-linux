.{
    .name = "perl-cairo",
    .version = "1.109",
    .release = 1,
    .description = "Perl interface to the cairo 2d vector graphics library",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        // SHA-256 verified against MetaCPAN release metadata and this author's
        // https://cpan.metacpan.org/authors/id/X/XA/XAOC/CHECKSUMS (parsed as data, never executed).
        .{ .url = "https://cpan.metacpan.org/authors/id/X/XA/XAOC/Cairo-1.109.tar.gz", .sha256 = "8219736e401c2311da5f515775de43fd87e6384b504da36a192f2b217643077f" },
    },
    .depends = .{ "cairo", "freetype", "glibc", "perl", "perl-extutils-depends", "perl-extutils-pkgconfig" },
    .build_depends = .{ "gcc", "make", "pkgconf" },
}
