.{
    .name = "gsmartcontrol",
    .version = "2.0.2",
    .release = 1,
    .description = "Graphical drive health inspection tool for smartctl",
    .license = "GPL-3.0-or-later",
    .sources = .{
        // Checked against the MD5 SourceForge lists for the file.
        .{ .url = "https://downloads.sourceforge.net/gsmartcontrol/gsmartcontrol-2.0.2.tar.gz", .sha256 = "7cebd83fd34883d51e143389aa88f8173ea7b67c760b12b7de847f3c3c8cee34" },
    },
    // It reads everything through smartctl (smartmontools). The
    // gsmartcontrol-root launcher is a bash script that finds pkexec with
    // which and runs /usr/sbin/gsmartcontrol as root under the polkit
    // action it installs.
    .depends = .{
        "glibc",     "gcc",        "glib",       "gtk3",     "gtkmm3",
        "glibmm2.4", "cairomm1.0", "pangomm1.4", "atkmm1.6", "libsigcxx2",
        "cairo",     "pango",      "gdk-pixbuf", "smartmontools", "polkit",
        "bash",      "which",
    },
    .build_depends = .{ "cmake", "pkgconf" },
}
