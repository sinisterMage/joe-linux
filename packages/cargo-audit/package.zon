.{
    .name = "cargo-audit",
    .version = "0.23.0",
    .release = 1,
    .description = "Audit Cargo.lock files for crates with security vulnerabilities",
    .license = "Apache-2.0 OR MIT",
    .sources = .{
        // The rustsec monorepo at the cargo-audit/v0.23.0 tag.
        .{ .url = "https://github.com/rustsec/rustsec/archive/refs/tags/cargo-audit/v0.23.0.tar.gz", .sha256 = "9d3950c98058e14c3ee82d73632581dc12d2e0f655c270169ce95ab3bc9d0cc7", .file = "cargo-audit-0.23.0.tar.gz" },
    },
    // cargo downloads the crates cargo-audit depends on from crates.io; they
    // are not vendored yet.
    .network = true,
    // libgcc_s (gcc) for unwinding. AWS-LC (for rustls) is linked in
    // statically. It runs cargo to generate a missing Cargo.lock.
    .depends = .{ "glibc", "gcc", "rust" },
    .build_depends = .{"rust"},
}
