        .{ .url = "https://registry.npmjs.org/vscode-languageserver-protocol/-/vscode-languageserver-protocol-3.18.3.tgz", .sha256 = "7ea23f403fcd2678d8c220b749d225e59c03a14cd9269ce947304b5179e1769f" },
        .{ .url = "https://registry.npmjs.org/vscode-languageserver-textdocument/-/vscode-languageserver-textdocument-1.0.14.tgz", .sha256 = "7d060cfb6ecada7632b8f408bc2ed3dcae16713a0c99ca396cbe4fedbd91092b" },
