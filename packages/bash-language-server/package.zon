.{
    .name = "bash-language-server",
    .version = "5.8.1",
    .release = 1,
    .description = "Language server for Bash, with diagnostics from ShellCheck",
    .license = "MIT",
    .sources = .{
        // The npm package: the server compiled from TypeScript (out/) and
        // the Bash grammar compiled to WebAssembly (tree-sitter-bash.wasm).
        .{ .url = "https://registry.npmjs.org/bash-language-server/-/bash-language-server-5.8.1.tgz", .sha256 = "2ae910de8c50f4ec148222bdc580c121f2c621bdacc1225716218ca700f8ec79" },
        // Its npm dependencies, all of them, at exactly the versions of
        // upstream's lockfile (pnpm-lock.yaml at tag server-5.8.1, importer
        // "server", production dependencies only), each checked against
        // the SHA-512 integrity recorded there. No two need different
        // versions of the same package, so they sit side by side in one
        // node_modules. All are plain JavaScript (web-tree-sitter and
        // @one-ini/wasm carry WebAssembly) with no install scripts.
        .{ .url = "https://registry.npmjs.org/@mixmark-io/domino/-/domino-2.2.0.tgz", .file = "mixmark-io-domino-2.2.0.tgz", .sha256 = "b829bcca09544649f6432020dd6915b6fb054154d7a77eb6f8b3fb1f4165afec" },
