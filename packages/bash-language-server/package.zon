        .{ .url = "https://registry.npmjs.org/vscode-languageserver/-/vscode-languageserver-10.1.1.tgz", .sha256 = "df9ae342fa8ce417ad9484af94242a1bf33943ee8c668f9feaa4ad4460cf30be" },
        .{ .url = "https://registry.npmjs.org/web-tree-sitter/-/web-tree-sitter-0.27.0.tgz", .sha256 = "266e839d9d7f89c84ba6ce089ffdec9599b0a668c010308f857baad0570a0d50" },
        .{ .url = "https://registry.npmjs.org/zod/-/zod-3.25.76.tgz", .sha256 = "9e1f1a05f0dd0c1dab64ee91ceb9bf55cd44d35368c70edda80a2fdc70a88377" },
    },
    // ShellCheck is what the server runs for diagnostics and quick fixes.
    // shfmt (formatting) is used when it is installed. get-options.sh is a
    // bash script it runs for option completion.
    .depends = .{ "nodejs", "shellcheck", "bash" },
    // node reads each dependency's name from its package.json.
    .build_depends = .{"nodejs"},
}
