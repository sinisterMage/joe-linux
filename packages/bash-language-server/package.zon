        .{ .url = "https://registry.npmjs.org/@one-ini/wasm/-/wasm-0.2.1.tgz", .file = "one-ini-wasm-0.2.1.tgz", .sha256 = "123125e661c374b8f9051a486eca726c88fe318478815168593f9c31bed8a85a" },
