        .{ .url = "https://registry.npmjs.org/picomatch/-/picomatch-2.3.2.tgz", .sha256 = "4c843ba015bec815ac52116162559ab7b4b4efbd3b86f7fcf38f3d770decace6" },
        .{ .url = "https://registry.npmjs.org/queue-microtask/-/queue-microtask-1.2.3.tgz", .sha256 = "ffaf0a20a201865e143aa27e57a83bf69a75547729a65cd3180bcba4f0f29ecd" },
        .{ .url = "https://registry.npmjs.org/reusify/-/reusify-1.0.4.tgz", .sha256 = "aa500cd517fa2fa7aeabb96a02baf85d9f0d02a29e2a99c77516053304a133c4" },
        .{ .url = "https://registry.npmjs.org/run-parallel/-/run-parallel-1.2.0.tgz", .sha256 = "6ba231f5377e0b18ef7ab0c65ca895708e21f1abff5999b24629436b0ff77ac8" },
        .{ .url = "https://registry.npmjs.org/semver/-/semver-7.8.5.tgz", .sha256 = "d85045d4300d7d57c891336b95df532e73f34c22ffcd222452b6d08b9d127d5d" },
