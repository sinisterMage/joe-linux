.{
    .name = "libraqm",
    .version = "0.11.0",
    .release = 1,
    .description = "Complex text layout with HarfBuzz, FreeType and FriBidi",
    .license = "MIT",
    .sources = .{
        // Verified against GitHub's SHA-256 digest for the upstream release asset.
        .{ .url = "https://github.com/HOST-Oman/libraqm/releases/download/v0.11.0/raqm-0.11.0.tar.xz", .sha256 = "3d0add115f7d4a9410d3377462ed3c05e86342193ef984183e4380e3787b2d4c" },
    },
    .depends = .{ "glibc", "freetype", "harfbuzz", "fribidi" },
    .build_depends = .{ "meson", "ninja", "pkgconf" },
}
