.{
    .name = "python-tox",
    .version = "4.67.13",
    .release = 1,
    .description = "Generic virtualenv management and test command-line tool for Python",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/t/tox/tox-4.67.13.tar.gz", .sha256 = "9f70b44ca2e31d91d8fe2e2917f505554950adc3961c0ee70bb42db16d903f62" },
    },
    .depends = .{
        "python",
        "cachetools",
        "colorama",
        "filelock",
        "packaging",
        "platformdirs",
        "pluggy",
        "pyproject-api",
        "python-discovery",
        "tomli-w",
        "python-virtualenv",
    },
    // Upstream's build hook (hatch_build.py) renders the manual page
    // (tox.1) with docutils.
    .build_depends = .{ "python", "hatchling", "hatch-vcs", "hatch-fancy-pypi-readme", "docutils" },
}
