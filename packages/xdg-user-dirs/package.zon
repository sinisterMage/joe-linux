.{
    .name = "xdg-user-dirs",
    .version = "0.20",
    .release = 1,
    .description = "Tool that creates and tracks the well-known user directories (Desktop, Documents, Music ...)",
    .license = "GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://gitlab.freedesktop.org/xdg/xdg-user-dirs/-/archive/v0.20/xdg-user-dirs-v0.20.tar.gz", .sha256 = "988d3f3274cb2b69796ace22ddbb0abfc2c0157fff65258045f055cfba024d6e" },
    },
    .depends = .{"glibc"},
    // systemd: its pkg-config file tells where the user unit goes.
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "systemd" },
}
