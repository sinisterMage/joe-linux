.{
    .name = "gtkmm4",
    .version = "4.24.0",
    .release = 1,
    .description = "C++ bindings for GTK 4",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/gtkmm/4.24/gtkmm-4.24.0.tar.xz", .sha256 = "7fd9cea356e7d3b74bf7d2a51d7e0e6763f3f9f1cddc5e77c8b0b5b7fa9d5e5a" },
    },
    .depends = .{ "glibc", "gcc", "glib", "gtk4", "gdk-pixbuf", "cairo", "pango", "graphene", "glibmm", "cairomm", "pangomm", "libsigcxx" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "python" },
}
