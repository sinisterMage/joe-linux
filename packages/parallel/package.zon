.{
    .name = "parallel",
    .version = "20261022",
    .release = 1,
    .description = "GNU parallel, which runs shell commands in parallel on one or more computers",
    .license = "GPL-3.0-or-later AND GFDL-1.3-or-later AND CC-BY-SA-4.0",
    .sources = .{
        // Checked against its GNU signature (gnu-keyring.gpg).
