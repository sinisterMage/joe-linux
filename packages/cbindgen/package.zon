.{
    .name = "cbindgen",
    .version = "0.29.4",
    .release = 1,
    .description = "Generates C and C++ headers for Rust libraries that expose a public C API",
    .license = "MPL-2.0",
    .sources = .{
        .{ .url = "https://github.com/mozilla/cbindgen/archive/v0.29.4/cbindgen-0.29.4.tar.gz", .sha256 = "9b5757e915cf8be523d3aca282b9b5651bafa112e14bf1ba488562ba282807d6" },
    },
    // cargo downloads the crates cbindgen depends on from crates.io; they
    // are not vendored yet.
    .network = true,
    // The binary links libgcc_s (gcc) for unwinding.
    .depends = .{ "glibc", "gcc" },
    .build_depends = .{"rust"},
}
