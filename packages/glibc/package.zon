.{
    .name = "glibc",
    .version = "2.44",
    .release = 3,
    .description = "The GNU C library",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://ftpmirror.gnu.org/glibc/glibc-2.44.tar.xz", .sha256 = "37f600f2bef3c5e8300147059568b2a2e40a7ad6ccc65ce942556d49429cc667" },
        .{ .url = "https://www.linuxfromscratch.org/patches/lfs/development/glibc-fhs-1.patch", .sha256 = "643552db030e2f2d7ffde4f558e0f5f83d3fabf34a2e0e56ebdb49750ac27b0d" },
        .{ .url = "https://www.linuxfromscratch.org/patches/lfs/development/glibc-2.44-upstream_fixes-4.patch", .sha256 = "630866d6d1282f94c41a59deb2af37b1a2ad1c321f8de7b1aa80f1f4f0431717" },
    },
    .build_depends = .{"linux-api-headers"},
    // As glibc 2.44-r2, the build in the repository before the time zone
    // data moved to tzdata, was sealed: its programs claim no privileged
    // operations.
    .operations = .{
        .{ .allow = .{"none"} },
    },
}
