.{
    .name = "yt-dlp-ejs",
    .version = "0.8.0",
    .release = 1,
    .description = "JavaScript that yt-dlp runs to solve YouTube's challenges",
    .license = "Unlicense AND MIT AND ISC",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/y/yt-dlp-ejs/yt_dlp_ejs-0.8.0.tar.gz", .sha256 = "d5fa1639f63b5c4af8d932495f60689d5370f1a095782c944f7f62a303eb104e" },
    },
    // Python that hands out two JavaScript files; yt-dlp runs them with a
    // JavaScript runtime (Node.js on joe, declared by yt-dlp).
    .depends = .{"python"},
    // npm installs the bundler (rollup) and the two bundled libraries
    // (astring, meriyah) from upstream's package-lock.json.
    .build_depends = .{ "python", "hatchling", "hatch-vcs", "nodejs" },
    // npm ci fetches the locked JavaScript dependencies; they are not
    // vendored yet.
    .network = true,
}
