.{
    .name = "talloc",
    .version = "2.5.0",
    .release = 1,
    .description = "Hierarchical, reference-counted memory pool allocator used by Samba",
    .license = "LGPL-3.0-or-later",
    .sources = .{
        .{ .url = "https://www.samba.org/ftp/talloc/talloc-2.5.0.tar.gz", .sha256 = "912afa237510ae542a7733998eb18a12bcda35ab6729c8e2ddb43e8d0ebab007" },
    },
    // python: the pytalloc-util library and the talloc module, which Samba
    // builds against.
    .depends = .{ "glibc", "python" },
    // The manual page is made with xsltproc and the DocBook stylesheets.
    .build_depends = .{ "python", "libxslt", "docbook-xml", "docbook-xsl-nons" },
}
