.{
    .name = "libebml",
    .version = "1.4.7",
    .release = 1,
    .description = "Library for EBML, the binary container format underneath Matroska and WebM",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        // Checked against the .sha512.txt file published with the release.
        .{ .url = "https://dl.matroska.org/downloads/libebml/libebml-1.4.7.tar.xz", .sha256 = "5b08214f929ee54c6187c370f84235fc9d0f2a2258c4d320d68eae6e2bdfd3f7" },
    },
    // gcc: libstdc++.
    .depends = .{ "glibc", "gcc" },
    .build_depends = .{ "cmake", "ninja" },
}
