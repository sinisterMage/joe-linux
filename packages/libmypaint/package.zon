.{
    .name = "libmypaint",
    .version = "1.6.1",
    .release = 1,
    .description = "MyPaint brush engine library, used by GIMP",
    .license = "ISC",
    .sources = .{
        .{ .url = "https://github.com/mypaint/libmypaint/releases/download/v1.6.1/libmypaint-1.6.1.tar.xz", .sha256 = "741754f293f6b7668f941506da07cd7725629a793108bb31633fb6c3eae5315f" },
    },
    .depends = .{ "glibc", "glib", "json-c" },
    // glib provides g-ir-scanner for the introspection data.
    .build_depends = .{ "pkgconf", "intltool", "gettext" },
}
