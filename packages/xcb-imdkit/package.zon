.{
    .name = "xcb-imdkit",
    .version = "1.0.9",
    .release = 1,
    .description = "XIM (X Input Method) protocol library for XCB, used by Fcitx 5",
    .license = "LGPL-2.1-only",
    .sources = .{
        // Checked against upstream's OpenPGP signature (Weng Xuetian,
        // 2CC8A0609AD2A479C65B6D5C8E8B898CBF2412F9).
        .{ .url = "https://download.fcitx-im.org/fcitx5/xcb-imdkit/xcb-imdkit-1.0.9.tar.zst", .sha256 = "74283bacef4d53655d3ddd6e3b969a787f77ee9d66b6ef256a2012a6ba2d1104" },
    },
    .depends = .{ "glibc", "libxcb", "xcb-util", "xcb-util-keysyms" },
    .build_depends = .{ "cmake", "ninja", "extra-cmake-modules", "pkgconf" },
}
