.{
    .name = "evince",
    .version = "48.4",
    .release = 1,
    .description = "GNOME Document Viewer (PDF, TIFF and comic book archives)",
    .license = "GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/evince/48/evince-48.4.tar.xz", .sha256 = "f296c5c662886635d4cd597e8ac0afcde7982be4486533c2b7f095b268be8668" },
    },
    // gnome-desktop: libgnome-desktop-3, the thumbnail cache. gstreamer and
    // gst-plugins-base: video embedded in PDFs. libarchive: comic books.
    // zlib: the bundled SyncTeX parser.
    .depends = .{ "glibc", "glib", "gtk3", "libhandy", "cairo", "pango", "gdk-pixbuf", "libxml2", "poppler", "tiff", "libarchive", "libsecret", "gnome-desktop", "gstreamer", "gst-plugins-base", "gsettings-desktop-schemas", "adwaita-icon-theme", "zlib" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "itstool", "dbus", "desktop-file-utils", "appstream" },
}
