.{
    .name = "netavark",
    .version = "2.1.0",
    .release = 1,
    .description = "Container network stack used by Podman: bridges, macvlan, port forwarding and firewall rules",
    .license = "Apache-2.0",
    .sources = .{
        // The release's source archive and the crates it depends on, vendored
        // by upstream as DISTRO_PACKAGE.md describes. Upstream's sha256sum
        // covers the vendor tarball only.
        .{ .url = "https://github.com/containers/netavark/archive/v2.1.0/netavark-2.1.0.tar.gz", .sha256 = "96677048168ddd1abe313e4c2e17f1cace72b60ee1bac8ca12a4bd7dfcadfbbb" },
        .{ .url = "https://github.com/containers/netavark/releases/download/v2.1.0/netavark-v2.1.0-vendor.tar.gz", .sha256 = "532779573b7f4c2606e43f8471132bb9072417feed9ee06a4e309cf3fa066ab8" },
    },
    // libgcc_s (gcc) for unwinding. Firewall rules are written by running
    // nft (the nftables driver, the default and, since 2.0, the only one
    // besides firewalld); aardvark-dns, if installed, serves container
    // names.
    .depends = .{ "glibc", "gcc", "nftables" },
    // protoc compiles the DHCP proxy's gRPC protocol (build.rs).
    .build_depends = .{ "rust", "protobuf", "go-md2man" },
}
