.{
    .name = "libmediainfo",
    .version = "26.10",
    .release = 1,
    .description = "MediaInfoLib, a library for reading technical and tag information from video and audio files",
    // MediaInfoLib is BSD-2-Clause; the copies of tinyxml2 (Zlib), fmt
    // (MIT) and the hash and AES code it compiles in are under permissive
    // licences of their own (Source/ThirdParty).
    .license = "BSD-2-Clause",
    .sources = .{
        // MediaArea publishes no checksums for its source archives.
        .{ .url = "https://mediaarea.net/download/source/libmediainfo/26.10/libmediainfo_26.10.tar.xz", .sha256 = "a806fd36592549a03e810486f415a6858d4d8f14066bfbe97b32a447cd5eb590" },
    },
    // gcc: libstdc++. curl: reading media from URLs (mediainfo URL).
    .depends = .{ "glibc", "gcc", "libzen", "zlib", "curl" },
    .build_depends = .{ "autoconf", "automake", "libtool", "pkgconf" },
}
