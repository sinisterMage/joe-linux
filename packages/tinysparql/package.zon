.{
    .name = "tinysparql",
    .version = "3.12.0",
    .release = 1,
    .description = "Low-footprint RDF triple store with a SPARQL 1.1 interface (formerly Tracker)",
    .license = "LGPL-2.1-or-later AND GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/tinysparql/3.12/tinysparql-3.12.0.tar.xz", .sha256 = "40e3e3ae9811ae07a94ac7dfe8259f218679ebb1c9bc98d7ab345b2405926b57" },
    },
    .depends = .{ "glibc", "glib", "sqlite", "icu", "libsoup", "json-glib", "libxml2", "dbus", "systemd" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "vala", "python" },
}
