.{
    .name = "localsearch",
    .version = "3.12.0",
    .release = 1,
    .description = "File indexer and metadata extractor for the GNOME desktop",
    .license = "GPL-2.0-or-later AND LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/localsearch/3.12/localsearch-3.12.0.tar.xz", .sha256 = "4bf45440ce7a899f2eca4d20343d31fc620fa2a3fe53bb929de244305330e930" },
    },
    .depends = .{ "glibc", "glib", "tinysparql", "gexiv2", "gstreamer", "gst-plugins-base", "icu", "libseccomp", "upower", "networkmanager", "libjpeg-turbo", "libpng", "tiff", "giflib", "libxml2", "dbus" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "vala" },
}
