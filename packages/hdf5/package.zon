.{
    .name = "hdf5",
    .version = "2.2.0",
    .release = 2,
    .description = "HDF5 data model, library and file format, with its C++, Fortran and high-level libraries and tools",
    .license = "BSD-3-Clause",
    .sources = .{
        // Checked against the release's hdf5-2.2.0.sha256sums.txt.
        .{ .url = "https://github.com/HDFGroup/hdf5/releases/download/2.2.0/hdf5-2.2.0.tar.gz", .sha256 = "1a1ab8209b35586fbc1aa279ba76d102130b95badcb20ca329587219112d8c16" },
    },
    // libstdc++ for the C++ library, libgfortran for the Fortran one, zlib
    // for the deflate filter.
    .depends = .{ "glibc", "gcc", "gcc-fortran", "zlib" },
    .build_depends = .{ "cmake", "ninja" },
}
