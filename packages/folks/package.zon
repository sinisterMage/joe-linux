.{
    .name = "folks",
    .version = "0.15.12",
    .release = 1,
    .description = "Library that aggregates people from multiple sources into metacontacts",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/folks/0.15/folks-0.15.12.tar.xz", .sha256 = "21f44e2bdabb1ee7f8e41bb996d10ac7daf35c78c498177db0c00f580a20a914" },
    },
    // evolution-data-server: the address-book backend (the one GNOME
    // Contacts uses). libxml2: the meta-contact import tool; readline: the
    // folks-inspect tool.
    .depends = .{ "glibc", "glib", "libgee", "evolution-data-server", "libxml2", "readline" },
    // glib provides g-ir-scanner and g-ir-compiler.
    .build_depends = .{ "meson", "ninja", "pkgconf", "vala", "gettext" },
}
