.{
    .name = "eyedropper",
    .version = "2.2.1",
    .release = 1,
    .description = "Pick colors from the screen and show them in many formats",
    .license = "GPL-3.0-only",
    .sources = .{
        .{ .url = "https://github.com/FineFindus/eyedropper/releases/download/v2.2.1/eyedropper-2.2.1.tar.xz", .sha256 = "d81cbebf74d676c1a9fb08b5d62bdd8bceedb774bd0d3f4dce614372eec9fa4d" },
    },
    // The release tarball vendors its crates, so the build is offline.
    //
    // Colors are picked through the screenshot portal's PickColor
    // (xdg-desktop-portal-gnome on the desktop).
    .depends = .{ "glibc", "gcc", "glib", "gtk4", "libadwaita", "cairo", "pango", "gdk-pixbuf", "graphene" },
    // The interface is written in Blueprint; appstream provides the gettext
    // rules for the metainfo file.
    .build_depends = .{ "rust", "meson", "ninja", "pkgconf", "gettext", "appstream", "blueprint-compiler" },
}
