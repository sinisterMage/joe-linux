.{
    .name = "virglrenderer",
    .version = "1.3.0",
    .release = 1,
    .description = "Virtual OpenGL renderer that gives QEMU guests an accelerated virtio-gpu",
    .license = "MIT",
    .sources = .{
        // Upstream publishes no checksum for its release archives.
        .{ .url = "https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/1.3.0/virglrenderer-1.3.0.tar.bz2", .sha256 = "088040d130eaa0458a978fe7867fbfb1fcf1fdff52bf3b27a00658828bc4189f" },
    },
    // OpenGL through libepoxy on EGL, buffers from Mesa's libgbm; video
    // decoding through libva.
    .depends = .{ "glibc", "libepoxy", "libdrm", "mesa", "libva" },
    // The format tables are generated by a Python script that reads YAML.
    .build_depends = .{ "meson", "ninja", "pkgconf", "python", "pyyaml" },
}
