.{
    .name = "ruamel-yaml",
    .version = "0.19.1",
    .release = 1,
    .description = "YAML 1.2 parser and emitter for Python that keeps comments and order on round trips",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/r/ruamel.yaml/ruamel_yaml-0.19.1.tar.gz", .sha256 = "53eb66cd27849eff968ebf8f0bf61f46cdac2da1d1f3576dd4ccee9b25c31993" },
    },
    // Pure Python: the optional LibYAML-based loaders (the ruamel.yaml.clib
    // and ruamel.yaml.clibz extras) are not packaged.
    .depends = .{"python"},
    .build_depends = .{ "python", "setuptools" },
}
