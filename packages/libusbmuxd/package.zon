.{
    .name = "libusbmuxd",
    .version = "2.1.1",
    .release = 1,
    .description = "Client library for usbmuxd, the multiplexer for connections to Apple devices",
    .license = "LGPL-2.1-or-later AND GPL-2.0-or-later",
    .sources = .{
        // Checked against the digest GitHub publishes for the release asset.
        .{ .url = "https://github.com/libimobiledevice/libusbmuxd/releases/download/2.1.1/libusbmuxd-2.1.1.tar.bz2", .sha256 = "5546f1aba1c3d1812c2b47d976312d00547d1044b84b6a461323c621f396efce" },
    },
    // The library is LGPL; its tools, iproxy and inetcat, are GPL.
    .depends = .{ "glibc", "libplist", "libimobiledevice-glue" },
    .build_depends = .{"pkgconf"},
}
