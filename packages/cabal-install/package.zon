    },
    // Haskell libraries are linked in statically. The zlib package links
    // the system's libz (its pkg-config flag), resolv links glibc's
    // libresolv, and every GHC program needs libgmp and libffi. cabal runs
    // ghc and ghc-pkg to do anything at all.
    .depends = .{ "glibc", "gmp", "libffi", "zlib", "ghc" },
    // bootstrap.py is Python; the zlib package finds libz with pkg-config.
    .build_depends = .{ "ghc", "python", "pkgconf" },
}
