.{
    .name = "capnproto",
    .version = "1.5.0",
    .release = 1,
    .description = "Cap'n Proto serialisation and RPC system, with the KJ C++ library and the capnp compiler",
    .license = "MIT",
    .sources = .{
        // Upstream publishes no checksum or signature for the tarball.
        .{ .url = "https://capnproto.org/capnproto-c++-1.5.0.tar.gz", .sha256 = "77dbc13ca82d9c87ddb4581dd49559d45b63096433d3dadea08b7f31b360a5ba" },
    },
    // zlib for libkj-gzip, OpenSSL for libkj-tls.
    .depends = .{ "glibc", "gcc", "zlib", "openssl" },
    .build_depends = .{},
}
