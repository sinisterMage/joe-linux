.{
    .name = "crystal",
    .version = "1.22.3",
    .release = 2,
    .description = "Statically typed compiled language with Ruby-like syntax",
    .license = "Apache-2.0",
    .sources = .{
        // Upstream publishes no separate checksum for its GitHub source archive.
        // The archive includes the locked markd, reply and sanitize sources.
        .{ .url = "https://github.com/crystal-lang/crystal/archive/1.22.3/crystal-1.22.3.tar.gz", .sha256 = "90f2613cc004d5734fe0a0364c3fcac3918e3a50e357ae33bdcb506ac44fcbb1" },
        // Previous release, ONLY a stage0 compiler; none of its files are shipped.
        // Verified against the sha256 digest in upstream's 1.22.2 release API.
        .{ .url = "https://github.com/crystal-lang/crystal/releases/download/1.22.2/crystal-1.22.2-1-linux-x86_64-bundled.tar.gz", .sha256 = "0dc5c3ff1b5710c3981e207a6241fc06cc28fadb6622d5fdb21999adf1ca2309" },
    },
    // LLVM, libffi (interpreter) and libxml2 (documentation sanitizer) are
    // linked by the compiler. The other libraries support the shipped stdlib;
    // gcc/binutils and pkgconf are used when compiling Crystal programs.
    .depends = .{ "glibc", "gcc", "binutils", "llvm >=23.1", "gc", "pcre2", "libffi", "libxml2", "libyaml", "gmp", "openssl", "zlib", "pkgconf" },
    .build_depends = .{ "asciidoctor" },
}
