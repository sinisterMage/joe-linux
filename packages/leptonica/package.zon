.{
    .name = "leptonica",
    .version = "1.87.0",
    .release = 1,
    .description = "Image processing and analysis library, used by Tesseract",
    .license = "BSD-2-Clause",
    .sources = .{
        .{ .url = "https://github.com/DanBloomberg/leptonica/releases/download/1.87.0/leptonica-1.87.0.tar.gz", .sha256 = "c73363397f96eb1295602bf44d708a994ad42046c791bf03ea0505d829bdb6a7" },
    },
    // The image formats it reads and writes.
    .depends = .{ "glibc", "zlib", "libpng", "libjpeg-turbo", "giflib", "tiff", "libwebp", "openjpeg" },
    // autogen.sh regenerates the build system, as the book does.
    .build_depends = .{ "autoconf", "automake", "libtool", "pkgconf" },
}
