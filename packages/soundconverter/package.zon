.{
    .name = "soundconverter",
    .version = "4.1.3",
    .release = 1,
    .description = "Converts audio files between formats, for GNOME",
    .license = "GPL-3.0-only",
    .sources = .{
        // Upstream publishes no checksum for the archive.
        .{ .url = "https://github.com/kassoulet/soundconverter/archive/4.1.3/soundconverter-4.1.3.tar.gz", .sha256 = "2ab5c870909cf1306ebe0a35786c1261680a27dc997862399f759bca9bd32743" },
    },
    // A Python program using GTK 3, GStreamer and libnotify through
    // PyGObject. It reads whatever GStreamer can decode and encodes with
    // GStreamer's plugins: Vorbis and Opus (base), FLAC, WAV and MP3 (good),
    // AAC/M4A (libav).
    .depends = .{
        "python",           "pygobject", "glib",
        "gtk3",             "pango",     "gdk-pixbuf",
        "libnotify",        "gstreamer", "gst-plugins-base",
        "gst-plugins-good", "gst-libav",
    },
    // python-distutils-extra builds the translations and the desktop file
    // (with intltool and gettext).
    .build_depends = .{ "python", "setuptools", "wheel", "python-distutils-extra", "intltool", "gettext" },
}
