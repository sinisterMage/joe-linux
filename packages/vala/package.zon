.{
    .name = "vala",
    .version = "0.56.19",
    .release = 1,
    .description = "Compiler for the Vala programming language, with vapigen",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/vala/0.56/vala-0.56.19.tar.xz", .sha256 = "5ad7cbbfcc0de61b403d6797c9ef60455bfbebd8e162aec33b5b0b097adfb9d5" },
    },
    // valac runs the C compiler and pkg-config.
    .depends = .{ "glibc", "glib", "gcc", "pkgconf" },
    .build_depends = .{ "pkgconf", "flex", "bison" },
}
