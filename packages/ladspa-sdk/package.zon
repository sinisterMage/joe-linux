.{
    .name = "ladspa-sdk",
    .version = "1.17",
    .release = 1,
    .description = "LADSPA, the Linux Audio Developer's Simple Plugin API: header, example plugins and listplugins, analyseplugin and applyplugin",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        // Upstream publishes no checksum; the SHA-512 matches Arch's.
        .{ .url = "https://www.ladspa.org/download/ladspa_sdk_1.17.tgz", .sha256 = "27d24f279e4b81bd17ecbdcc38e4c42991bb388826c0b200067ce0eb59d3da5b" },
    },
    // libsndfile is for applyplugin; the sine example plugin is C++.
    .depends = .{ "glibc", "gcc", "libsndfile" },
    .build_depends = .{},
}
