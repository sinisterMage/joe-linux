.{
    .name = "btrfs-progs",
    .version = "7.3",
    .release = 2,
    .description = "Administration and debugging tools for the btrfs file system",
    .license = "GPL-2.0-only AND LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://www.kernel.org/pub/linux/kernel/people/kdave/btrfs-progs/btrfs-progs-v7.3.tar.xz", .sha256 = "d37b63403d25fe025704c758e6a3da0979ae50c30c5f02aa78e4410e7b346e3a" },
    },
    .depends = .{ "glibc", "util-linux", "zlib", "zstd", "systemd" },
    .build_depends = .{"pkgconf"},
    .operations = .{
        // Making and managing btrfs file systems, on any device or image file.
        .{ .programs = .{ "usr/bin/mkfs.btrfs", "usr/bin/btrfs", "usr/bin/btrfstune" }, .allow = .{ "cap:sys_admin", "cap:sys_rawio", "cap:dac_override", "write:*" } },
    },
}
