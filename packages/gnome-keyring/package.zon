.{
    .name = "gnome-keyring",
    .version = "51.1",
    .release = 1,
    .description = "Daemon that keeps passwords and keys for the user (Secret Service), with its PAM module",
    .license = "GPL-2.0-or-later AND LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/gnome-keyring/51/gnome-keyring-51.1.tar.xz", .sha256 = "dfe7adc5876ef0670e7eba2907799bdbb8875ce58bb4208e1a52169bd16a47ca" },
    },
    // gcr provides gck-1 and gcr-base-3. dbus: the daemon is activated on the
    // session bus.
    .depends = .{ "glibc", "glib", "gcr", "libgcrypt", "p11-kit", "linux-pam", "systemd", "dbus" },
    // libxslt and the DocBook stylesheets are for the manual pages.
    .build_depends = .{ "meson", "ninja", "pkgconf", "python", "gettext", "libxslt", "docbook-xsl-nons", "docbook-xml" },
}
