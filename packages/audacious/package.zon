.{
    .name = "audacious",
    .version = "4.6.2",
    .release = 1,
    .description = "Lightweight audio player: the player and its libraries (interfaces, decoders and outputs are in audacious-plugins)",
    .license = "BSD-2-Clause",
    .sources = .{
        .{ .url = "https://distfiles.audacious-media-player.org/audacious-4.6.2.tar.bz2", .sha256 = "af4c68b7dd09304d382df18616aecd843c8efa4e4eef31bfc76abce465271c83" },
    },
    // gcc: libstdc++. libarchive: playing files from inside archives.
    // audacious is not usable without audacious-plugins, but that package
    // builds against this one and depends on it, so the dependency cannot
    // also go this way: install audacious-plugins.
    .depends = .{ "glibc", "gcc", "glib", "gtk3", "cairo", "pango", "gdk-pixbuf", "libarchive" },
    // python runs glib's gdbus-codegen (the D-Bus interface).
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "python" },
}
