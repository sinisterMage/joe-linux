.{
    .name = "noise-suppression-for-voice",
    .version = "1.10",
    .release = 1,
    .description = "Real-time noise suppression plugin for voice, based on RNNoise (LADSPA)",
    // The plugin is GPL-3.0; the RNNoise it compiles in is BSD-3-Clause.
    .license = "GPL-3.0-only AND BSD-3-Clause",
    .sources = .{
        // GitHub publishes no checksum for archives. 1.10 is the newest
        // release; 1.21 and 1.22 are marked as pre-releases.
        .{ .url = "https://github.com/werman/noise-suppression-for-voice/archive/v1.10/noise-suppression-for-voice-1.10.tar.gz", .sha256 = "6e0c11aeb8392891750b0243c2ba695dab07654bf3f4e01adbed927b36cc690a" },
    },
    // gcc: libstdc++ and libatomic.
    .depends = .{ "glibc", "gcc" },
    .build_depends = .{ "cmake", "ninja" },
}
