.{
    .name = "sane-airscan",
    .version = "0.99.38",
    .release = 1,
    .description = "SANE backend for driverless network scanners (eSCL and WSD)",
    .license = "GPL-2.0-or-later WITH SANE-exception",
    .sources = .{
        .{ .url = "https://github.com/alexpevzner/sane-airscan/archive/0.99.38/sane-airscan-0.99.38.tar.gz", .sha256 = "1e5b3b8373141caa37bf42fe74ae1950de3ff15c84966d8a415485d334ba5507" },
    },
    // A backend that libsane loads (dll.d/airscan); it finds scanners
    // through Avahi and WS-Discovery.
    .depends = .{ "glibc", "sane", "avahi", "gnutls", "libjpeg-turbo", "libpng", "tiff", "libxml2" },
    .build_depends = .{ "meson", "ninja", "pkgconf" },
}
