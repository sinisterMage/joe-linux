.{
    .name = "runc",
    .version = "1.5.3",
    .release = 1,
    .description = "CLI tool for spawning and running containers according to the OCI specification",
    .license = "Apache-2.0",
    .sources = .{
        // Upstream's release tarball; its SHA-256 is in the release's signed
        // runc.sha256sum. The Go modules are vendored in it.
        .{ .url = "https://github.com/opencontainers/runc/releases/download/v1.5.3/runc-1.5.3.tar.xz", .sha256 = "b46692550bfd6a6d69e15068d153446dfd401810809eecb767481fba90561b59" },
    },
    // Upstream's build tags: seccomp (libseccomp) and libpathrs (safe path
    // resolution through libpathrs). Checkpoint and restore need CRIU,
    // which is not packaged; runc runs it only when asked to.
    .depends = .{ "glibc", "libseccomp", "libpathrs" },
    .build_depends = .{ "go", "pkgconf", "go-md2man" },
}
