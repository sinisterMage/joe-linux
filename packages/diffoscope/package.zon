.{
    .name = "diffoscope",
    .version = "339",
    .release = 2,
    .description = "In-depth comparison of files, archives and directories",
    .license = "GPL-3.0-or-later",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/d/diffoscope/diffoscope-339.tar.gz", .sha256 = "fb033492c16017963bfa04290c3ffd8e3b7884e1226dfaa6da2b1a07368d8e82" },
    },
    // diffoscope compares text with diff. Everything else it can look inside
    // (ELF, PDF, images, file systems and so on) needs an external tool, found at
    // run time when it is installed; those are left out on purpose.
    .depends = .{ "python", "python-magic", "libarchive-c", "diffutils" },
    .build_depends = .{ "python", "setuptools" },
}
