.{
    .name = "polkit",
    .version = "128",
    .release = 3,
    .description = "Authorization manager that lets unprivileged programs talk to privileged ones",
    .license = "LGPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://github.com/polkit-org/polkit/archive/128/polkit-128.tar.gz", .sha256 = "6edb06bf1448e49e428f9597a97af6a05d62146dd0b58f86eeaebcee3f5ecfaa" },
    },
    .depends = .{ "glibc", "glib", "expat", "duktape", "linux-pam", "systemd", "dbus" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext" },
    .operations = .{
        // pkexec runs any program as root, as doas does.
        .{ .programs = .{"usr/bin/pkexec"}, .allow = .{"all"} },
        // The agent's helper checks a password through PAM.
        .{ .programs = .{"usr/lib/polkit-1/polkit-agent-helper-1"}, .allow = .{ "cap:dac_override", "cap:dac_read_search", "cap:audit_write", "exec:/usr/sbin/unix_chkpwd" } },
    },
}
