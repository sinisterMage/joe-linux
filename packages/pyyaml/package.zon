.{
    .name = "pyyaml",
    .version = "6.0.3",
    .release = 1,
    .description = "YAML parser and emitter for Python",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/P/PyYAML/pyyaml-6.0.3.tar.gz", .sha256 = "d76623373421df22fb4cf8817020cbb7ef15c725b9d5e45f17e189bfc384190f" },
    },
    // Pure Python: the optional LibYAML binding is not built (see build.sh),
    // so libyaml is not a dependency.
    .depends = .{"python"},
    .build_depends = .{ "python", "setuptools", "wheel" },
}
