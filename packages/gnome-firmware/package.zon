.{
    .name = "gnome-firmware",
    .version = "49.0",
    .release = 1,
    .description = "Install firmware on devices with fwupd",
    .license = "GPL-2.0-or-later",
    .sources = .{
        // Upstream releases only as tags; GitLab publishes no checksum for
        // its archives.
        .{ .url = "https://gitlab.gnome.org/World/gnome-firmware/-/archive/49.0/gnome-firmware-49.0.tar.gz", .sha256 = "3d52626d2a4fb19a11e8d07cb0cc07352751a9d6d4aacc2697be44cf4334ff35" },
    },
    // The fwupd daemon does the work, over D-Bus through libfwupd.
    .depends = .{ "glibc", "glib", "gtk4", "libadwaita", "fwupd", "libxmlb" },
    // libxml2's xmllint strips the icons for the resource bundle; help2man
    // writes the manual page from the --help output of the program just
    // built.
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "libxml2", "help2man" },
}
