.{
    .name = "direnv",
    .version = "2.38.2",
    .release = 1,
    .description = "Loads and unloads environment variables depending on the current directory",
    .license = "MIT",
    .sources = .{
        // Upstream publishes no checksum for the source archive.
        .{ .url = "https://github.com/direnv/direnv/archive/v2.38.2/direnv-2.38.2.tar.gz", .sha256 = "02c5e873e9ebcf2798513f7dd3775e5b8aace99bfa1e0c1b93091b6d4cbcaffb" },
    },
    // go downloads the modules direnv depends on; they are not vendored
    // yet.
    .network = true,
    // Built without cgo, as upstream's release builds are, so no library is
    // linked; as a position-independent executable it is still relocated by
    // glibc's dynamic loader. .envrc files are evaluated by bash.
    .depends = .{ "glibc", "bash" },
    .build_depends = .{"go"},
}
