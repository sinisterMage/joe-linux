.{
    .name = "just",
    .version = "1.59.0",
    .release = 1,
    .description = "Handy command runner for project-specific recipes",
    .license = "CC0-1.0",
    .sources = .{
        .{ .url = "https://github.com/casey/just/archive/1.59.0/just-1.59.0.tar.gz", .sha256 = "20f876880851f1cc67fc7eb7589c7f7ccaa7612d827feac75797cf4a6ed729aa" },
    },
    // cargo downloads the crates just depends on from crates.io; they are
    // not vendored yet.
    .network = true,
    // libgcc_s (gcc) for unwinding. Recipes run with sh unless a justfile
    // says otherwise.
    .depends = .{ "glibc", "gcc" },
    .build_depends = .{"rust"},
}
