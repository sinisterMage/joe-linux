.{
    .name = "apr",
    .version = "1.7.6",
    .release = 1,
    .description = "Apache Portable Runtime library",
    .license = "Apache-2.0",
    .sources = .{
        .{ .url = "https://archive.apache.org/dist/apr/apr-1.7.6.tar.bz2", .sha256 = "49030d92d2575da735791b496dc322f3ce5cff9494779ba8cc28c7f46c5deb32" },
    },
    // libcrypt (libxcrypt) and libuuid (util-linux) are found by configure
    // and linked.
    .depends = .{ "glibc", "libxcrypt", "util-linux" },
}
