.{
    .name = "libqalculate",
    .version = "5.13.2",
    .release = 1,
    .description = "Library and definitions of the Qalculate! calculator, with the qalc command-line calculator",
    .license = "GPL-2.0-or-later",
    .sources = .{
        // Checked against GitHub's SHA-256 of the release asset; upstream
        // publishes no checksum of its own.
        .{ .url = "https://github.com/Qalculate/libqalculate/releases/download/v5.13.2/libqalculate-5.13.2.tar.gz", .sha256 = "81af6c54018d5cbc9ce4df5a82c3ffb7b195193d72dcabb904f522b69936f3e6" },
    },
    // ICU for case-insensitive Unicode names, libcurl to fetch exchange
    // rates, readline (with ncurses) in qalc. The unit, function and
    // currency definitions are installed under /usr/share/qalculate.
    // plot() runs gnuplot when it is installed; it is not a dependency, so
    // that a calculator does not pull in Qt (Arch also leaves it optional).
    .depends = .{ "glibc", "gcc", "gmp", "mpfr", "libxml2", "icu", "curl", "readline", "ncurses" },
    // msgfmt translates the definition files (and the messages).
    .build_depends = .{ "pkgconf", "gettext" },
}
