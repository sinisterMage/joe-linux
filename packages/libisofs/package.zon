.{
    .name = "libisofs",
    .version = "1.5.8.pl02",
    .release = 1,
    .description = "Library for creating ISO 9660 file system images with Rock Ridge and Joliet extensions",
    .license = "GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://files.libburnia-project.org/releases/libisofs-1.5.8.pl02.tar.gz", .sha256 = "10bd584d8f00d8091e814902b9f0a3e209f16e938f510fc23ba05f3fa469db5a" },
    },
    // acl for ACLs, zlib for zisofs compression. Extended attributes come
    // from glibc's sys/xattr.h.
    .depends = .{ "glibc", "acl", "zlib" },
    .build_depends = .{},
}
