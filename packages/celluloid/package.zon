.{
    .name = "celluloid",
    .version = "0.30",
    .release = 1,
    .description = "Simple GTK front end for mpv",
    .license = "GPL-3.0-or-later",
    .sources = .{
        .{ .url = "https://github.com/celluloid-player/celluloid/releases/download/v0.30/celluloid-0.30.tar.xz", .sha256 = "7fef96431842c24e5ae78a9c42bc6523818a6c45213f23ceb146d037d6ec8559" },
    },
    // mpv: libmpv, which plays the video. libepoxy: the OpenGL calls for
    // mpv's render API.
    .depends = .{ "glibc", "glib", "gtk4", "libadwaita", "mpv", "libepoxy" },
    // python runs generate-authors.py; glib's gdbus-codegen the MPRIS
    // interface.
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "python" },
}
