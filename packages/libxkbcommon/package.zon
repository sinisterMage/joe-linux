.{
    .name = "libxkbcommon",
    .version = "1.13.2",
    .release = 1,
    .description = "Keymap compiler and keyboard state library for Wayland and X11",
    .license = "MIT AND X11 AND HPND AND HPND-sell-variant",
    .sources = .{
        .{ .url = "https://github.com/lfs-book/libxkbcommon/archive/v1.13.2/libxkbcommon-1.13.2.tar.gz", .sha256 = "e5d5eff0ea09d82c44a96aec75c719b6969fdc602da82e6b1c9aa74cac5fd488" },
        .{ .url = "https://www.linuxfromscratch.org/patches/blfs/svn/libxkbcommon-1.13.2-upstream_fix-1.patch", .sha256 = "d978cac5875fed73b7223866a1138718afeba58c1390a412affdcf2cd7744a34" },
    },
    // xkeyboard-config: the keyboard database, read at run time.
    .depends = .{ "glibc", "libxcb", "libxml2", "wayland", "xkeyboard-config" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "bison", "wayland-protocols" },
}
