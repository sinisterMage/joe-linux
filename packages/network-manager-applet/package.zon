.{
    .name = "network-manager-applet",
    .version = "1.34.0",
    .release = 2,
    .description = "NetworkManager connection editor and tray applet",
    .license = "GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/network-manager-applet/1.34/network-manager-applet-1.34.0.tar.xz", .sha256 = "ab368e470f6b161fc8b834bc97912b7e79af92b8cd7ea399c2d400ce89aba5a8" },
    },
    // modemmanager: libmm-glib for mobile broadband (the book's
    // recommendation). The polkit agent the book says must be running is
    // GNOME Shell's.
    .depends = .{ "glibc", "glib", "gtk3", "libnma >=1.10.6-r3", "libsecret", "networkmanager", "modemmanager", "cairo", "pango", "gdk-pixbuf" },
    // glib provides glib-compile-resources; libxml2 the xmllint it runs.
    .build_depends = .{ "meson", "ninja", "pkgconf", "python", "gettext", "libxml2" },
}
