.{
    .name = "rapidjson",
    .version = "1.1.0",
    .release = 1,
    .description = "Header-only C++ JSON parser and generator with SAX and DOM interfaces",
    .license = "MIT AND BSD-3-Clause",
    .sources = .{
        // 1.1.0 (2016) is still upstream's latest release. Upstream
        // publishes no checksum for the archive; its SHA-512 matches Arch
        // Linux's.
        .{ .url = "https://github.com/Tencent/rapidjson/archive/v1.1.0/rapidjson-1.1.0.tar.gz", .sha256 = "bf7ced29704a1e696fbccf2a2b4ea068e7774fa37f6d7dd4039d0787f8bed98e" },
    },
    // Headers, CMake and pkg-config files only: nothing is linked.
    .build_depends = .{ "cmake", "ninja" },
}
