.{
    .name = "flac",
    .version = "1.5.0",
    .release = 1,
    .description = "Free Lossless Audio Codec library and tools",
    .license = "BSD-3-Clause AND GPL-2.0-or-later AND LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://github.com/xiph/flac/releases/download/1.5.0/flac-1.5.0.tar.xz", .sha256 = "f2c1c76592a82ffff8413ba3c4a1299b6c7ab06c734dee03fd88630485c2b920" },
    },
    // libFLAC++ needs libstdc++ (gcc); Ogg FLAC support needs libogg.
    .depends = .{ "glibc", "gcc", "libogg" },
    .build_depends = .{"pkgconf"},
}
