.{
    .name = "cli-helpers",
    .version = "2.15.3",
    .release = 1,
    .description = "Helpers for command-line database clients: tabular output, configuration, styles",
    .license = "BSD-3-Clause",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/c/cli_helpers/cli_helpers-2.15.3.tar.gz", .sha256 = "fde47d1495e49897acd3e084d93600dba5885a79073b89ead14c40d28c610c19" },
    },
    // tabulate with its widechars extra (wcwidth, which cli_helpers also
    // imports itself); configobj for the configuration and its validate
    // module; pygments for the styles extra, which pgcli asks for.
    .depends = .{ "python", "configobj", "tabulate", "wcwidth", "pygments" },
    .build_depends = .{ "python", "setuptools", "wheel" },
}
