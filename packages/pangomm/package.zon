.{
    .name = "pangomm",
    .version = "2.58.0",
    .release = 1,
    .description = "C++ bindings for Pango (pangomm-2.48 API)",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/pangomm/2.58/pangomm-2.58.0.tar.xz", .sha256 = "217514c1a65035c2fce6e69e33b0d92bafa2594cc474e995a4473441b10f3a33" },
    },
    .depends = .{ "glibc", "gcc", "glib", "pango", "cairo", "glibmm", "cairomm", "libsigcxx" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "python" },
}
