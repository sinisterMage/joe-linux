.{
    .name = "gst-plugins-bad",
    .version = "1.28.9",
    .release = 2,
    .description = "GStreamer libraries and plugins not yet up to the standard of the other sets (GstPlay, parsers, MPEG-TS)",
    .license = "LGPL-2.1-or-later AND GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://gstreamer.freedesktop.org/src/gst-plugins-bad/gst-plugins-bad-1.28.9.tar.xz", .sha256 = "4a4e0b7bf84f868378c48f143a7ac3a98923b488a5b74f1a35ba46bc3c43f6b1" },
    },
    .depends = .{ "glibc", "gcc", "glib", "gstreamer", "gst-plugins-base",
        "libass", "svt-av1", "webrtc-audio-processing-1", "openh264",
        "fluidsynth", "chromaprint", "libdvdnav", "libdvdread", "srt",
        "libaom", "x265", "libgudev" },
    // glib provides g-ir-scanner and glib-mkenums.
    .build_depends = .{ "meson", "ninja", "pkgconf", "python", "gettext" },
}
