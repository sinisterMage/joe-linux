.{
    .name = "librt",
    .version = "0.16.0",
    .release = 1,
    .description = "Mypyc runtime library: C implementations of standard library functions",
    // pythonsupport.h, getargs.c and getargsfast.c are under the PSF license.
    .license = "MIT AND PSF-2.0",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/l/librt/librt-0.16.0.tar.gz", .sha256 = "ac38d6d8d66bf3d744148dbbc0b8e193e195a51e364ed55e224631f5721891fc" },
    },
    // C extension modules (librt.internal, librt.base64, ...).
    .depends = .{ "glibc", "python" },
    .build_depends = .{ "python", "setuptools" },
}
