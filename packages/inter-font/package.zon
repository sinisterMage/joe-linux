        .{ .url = "https://github.com/rsms/inter/releases/download/v4.1/Inter-4.1.zip", .sha256 = "9883fdd4a49d4fb66bd8177ba6625ef9a64aa45899767dde3d36aa425756b11e" },
    },
    // bsdtar unpacks the zip file.
    .build_depends = .{"libarchive"},
}
