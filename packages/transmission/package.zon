.{
    .name = "transmission",
    .version = "4.1.4",
    .release = 2,
    .description = "BitTorrent client: GTK 4 application, daemon with web interface, and command-line tools",
    .license = "GPL-2.0-only OR GPL-3.0-only",
    .sources = .{
        .{ .url = "https://github.com/transmission/transmission/releases/download/4.1.4/transmission-4.1.4.tar.xz", .sha256 = "86e7aa020cdf64826447034bc85f4d3b7c848d8c0891d9dc9b9fddfb2c805d22" },
    },
    // libsystemd: sd_notify for transmission-daemon.service.
    .depends = .{
        "glibc",   "gcc",       "curl",   "openssl",  "libevent", "libdeflate",
        "libpsl",  "systemd",   "glib",     "gtk4",     "gtkmm4",
        "glibmm",  "libsigcxx", "cairo",  "cairomm",  "pango",    "pangomm",
        "gdk-pixbuf",
    },
    // librsvg's rsvg-convert makes the PNG icon the book installs.
    .build_depends = .{ "cmake", "pkgconf", "gettext", "librsvg", "rapidjson" },
}
