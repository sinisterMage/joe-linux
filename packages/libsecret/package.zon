.{
    .name = "libsecret",
    .version = "0.21.8.2",
    .release = 1,
    .description = "GObject library for the freedesktop.org Secret Service API",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/libsecret/0.21/libsecret-0.21.8.2.tar.xz", .sha256 = "142948339c5b971d8f6a8c7099521f6fd319b6fe73d2694b4e6d3310ed28b6e6" },
    },
    // A Secret Service provider (gnome-keyring) is expected at run time. It
    // is not listed: it needs gcr, which is built later, and nothing here
    // links it.
    .depends = .{ "glibc", "glib", "libgcrypt" },
    // glib provides g-ir-scanner, vala provides vapigen; xsltproc (libxslt)
    // and the DocBook stylesheets build secret-tool(1).
    .build_depends = .{ "meson", "ninja", "pkgconf", "python", "gettext", "vala", "libxslt", "docbook-xml", "docbook-xsl-nons" },
}
