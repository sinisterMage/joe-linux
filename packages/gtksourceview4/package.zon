.{
    .name = "gtksourceview4",
    .version = "4.8.4",
    .release = 1,
    .description = "Source code editing widget for GTK 3 (GtkSourceView 4)",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/gtksourceview/4.8/gtksourceview-4.8.4.tar.xz", .sha256 = "7ec9d18fb283d1f84a3a3eff3b7a72b09a10c9c006597b3fbabbb5958420a87d" },
    },
    .depends = .{ "glibc", "glib", "gtk3", "pango", "cairo", "gdk-pixbuf", "fribidi", "libxml2" },
    // glib provides g-ir-scanner and glib-compile-resources.
    .build_depends = .{ "meson", "ninja", "pkgconf", "vala", "gettext" },
}
