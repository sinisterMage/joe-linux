.{
    .name = "libepoxy",
    .version = "1.5.10",
    .release = 1,
    .description = "Library for handling OpenGL function pointer management",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/libepoxy/1.5/libepoxy-1.5.10.tar.xz", .sha256 = "072cda4b59dd098bba8c2363a6247299db1fa89411dc221c8b81b8ee8192e623" },
    },
    // libepoxy opens Mesa's libGL, libEGL and libGLES at run time; its
    // epoxy/glx.h includes the Xlib headers.
    .depends = .{ "glibc", "mesa", "libx11" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "python" },
}
