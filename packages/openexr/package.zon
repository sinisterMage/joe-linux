.{
    .name = "openexr",
    .version = "3.5.4",
    .release = 1,
    .description = "High dynamic range image file format library from the Academy Software Foundation, with its tools",
    .license = "BSD-3-Clause AND BSD-2-Clause",
    .sources = .{
        .{ .url = "https://github.com/AcademySoftwareFoundation/openexr/releases/download/v3.5.4/openexr-3.5.4.tar.gz", .sha256 = "a09706c88ab83a90c26e7ee06cb7e6fa03a57726931eaec557c2e7eaf35c1b13" },
    },
    // libdeflate for zip compression, zstd for the zstd compressor.
    .depends = .{ "glibc", "gcc", "imath", "libdeflate", "zstd" },
    .build_depends = .{ "cmake", "ninja", "pkgconf" },
}
