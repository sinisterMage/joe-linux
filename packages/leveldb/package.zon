.{
    .name = "leveldb",
    .version = "1.23",
    .release = 1,
    .description = "Fast embedded key-value store with ordered keys, from Google",
    .license = "BSD-3-Clause",
    .sources = .{
        // 1.23 is still upstream's latest release. Upstream publishes no
        // checksum for the archive.
        .{ .url = "https://github.com/google/leveldb/archive/1.23/leveldb-1.23.tar.gz", .sha256 = "9a37f8a6174f09bd622bc723b55881dc541cd50747cbd08831c2a82d620f6d76" },
    },
    // snappy compresses blocks.
    .depends = .{ "glibc", "gcc", "snappy" },
    .build_depends = .{ "cmake", "ninja" },
}
