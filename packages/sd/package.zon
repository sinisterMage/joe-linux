.{
    .name = "sd",
    .version = "1.1.0",
    .release = 1,
    .description = "Intuitive find and replace command-line tool",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://github.com/chmln/sd/archive/v1.1.0/sd-1.1.0.tar.gz", .sha256 = "defdce484f8c92f265e1282490572575028967c2c55d356111d1e49a3ea9a88e" },
    },
    // cargo downloads the crates sd depends on from crates.io; they are not
    // vendored yet.
    .network = true,
    // libgcc_s (gcc) for unwinding.
    .depends = .{ "glibc", "gcc" },
    .build_depends = .{"rust"},
}
