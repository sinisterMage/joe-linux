.{
    .name = "gnome-maps",
    .version = "51.2",
    .release = 1,
    .description = "GNOME Maps",
    .license = "GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/gnome-maps/51/gnome-maps-51.2.tar.xz", .sha256 = "81038882a057702bad0991ab9faa2e2f0d621fbefb22f49013710425ff38fd5a" },
    },
    // libgnome-maps links libshumate, libxml2, librest, librsvg, json-glib
    // and sqlite. The rest is used by the gjs program through introspection
    // at run time: Geoclue, GeocodeGlib, GWeather, Xdp (libportal), Soup and
    // Secret (the OpenStreetMap account token).
    .depends = .{ "glibc", "glib", "gjs", "gtk4", "libadwaita", "libshumate", "libxml2", "librest", "librsvg", "json-glib", "sqlite", "geoclue", "geocode-glib", "libgweather", "libportal", "libsoup", "libsecret", "cairo", "pango", "graphene" },
    // appstream provides the gettext rules for the metainfo file.
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "blueprint-compiler", "desktop-file-utils", "appstream" },
}
