.{
    .name = "collision",
    .version = "3.14.0",
    .release = 2,
    .description = "GNOME application for calculating and comparing file checksums",
    .license = "BSD-2-Clause AND BSD-3-Clause AND MIT AND (Apache-2.0 OR CC0-1.0)",
    .sources = .{
        // Upstream publishes no separate checksums for these GitHub archives.
        // The seven shard versions below are exactly upstream's shard.lock
        // and data/dev.geopjr.Collision.json, including Blake3's C sources.
        .{ .url = "https://github.com/GeopJr/Collision/archive/v3.14.0/collision-3.14.0.tar.gz", .sha256 = "b71d983633712b2ca46ddf886e06d7f6439bb635935cca354cf9adc3b53a65f4" },
        .{ .url = "https://github.com/geopjr/blake3.cr/archive/v1.4.0/blake3-cr-1.4.0.tar.gz", .sha256 = "daf4312c4172a9dcdf997a69f6fdda73b2bca6cf2285c09bf76801663c724a77" },
        .{ .url = "https://github.com/geopjr/gettext.cr/archive/v1.0.0/gettext-cr-1.0.0.tar.gz", .sha256 = "7f31582765afa914e9d4d5abd9113af4715027979c6e332e8a2627940a8fdc53" },
        .{ .url = "https://github.com/hugopl/gi-crystal/archive/v0.25.1/gi-crystal-0.25.1.tar.gz", .sha256 = "b6e044b6ac454c7fdf30f2eb544f91cbd28f644832feca6994cec92003e28148" },
        .{ .url = "https://github.com/hugopl/gtk4.cr/archive/v0.18.0/gtk4-cr-0.18.0.tar.gz", .sha256 = "79fa8b43f93fc5c473e4c6b7abb709e517f94faabadc389f53081254afccae63" },
        .{ .url = "https://github.com/hugopl/harfbuzz.cr/archive/v0.2.1/harfbuzz-cr-0.2.1.tar.gz", .sha256 = "2912977198837da17738aa68fcdda7bfb0b33b7fc80fdd478fcfdcc910d80921" },
        .{ .url = "https://github.com/hugopl/libadwaita.cr/archive/v0.1.0/libadwaita-cr-0.1.0.tar.gz", .sha256 = "5c190418d73e488534949faad0e818fc7d7a9cf99a610f7fc302355d0ffbcda1" },
        .{ .url = "https://github.com/hugopl/pango.cr/archive/v0.3.1/pango-cr-0.3.1.tar.gz", .sha256 = "27696b1daf36033f347e6c49fad25a2720c7d16dc8e4f6ce2cafa472b94e4a1a" },
    },
    // Bindings are generated against system libraries. Blake3 is compiled
    // from the shard's vendored C/assembly source into a private static lib.
    // nautilus-python loads the supplied native-install Files menu extension.
    .depends = .{ "glibc", "gcc", "gc", "pcre2", "glib", "gtk4", "libadwaita", "pango", "harfbuzz", "cairo", "graphene", "gdk-pixbuf", "openssl", "zlib", "adwaita-icon-theme", "nautilus-python" },
    .build_depends = .{ "crystal", "shards", "cmake", "pkgconf", "gettext", "libxml2" },
}
