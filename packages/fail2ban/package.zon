.{
    .name = "fail2ban",
    .version = "1.1.1",
    .release = 1,
    .description = "Bans addresses that show malicious signs, such as repeated failed logins, with firewall rules",
    .license = "GPL-2.0-or-later",
    .sources = .{
        // Checked against Serg G. Brester's signature (1.1.1.tar.gz.asc on
        // the release, key 8738559E26F671DF9E2C6D9E683BF1BEBD0A882C), which
        // signs this archive.
        .{ .url = "https://github.com/fail2ban/fail2ban/archive/1.1.1/fail2ban-1.1.1.tar.gz", .sha256 = "4be0ea0488e32de260058462a44a040f0542cd26a9fb6fa6d2514f9dd8ec1609" },
    },
    // A Python daemon. systemd-python is the journal back end the jails
    // read with; the default ban actions run nft. Its database is SQLite,
    // through Python's own sqlite3 module.
    .depends = .{ "python", "systemd-python", "nftables" },
    .build_depends = .{ "python", "setuptools", "wheel" },
}
