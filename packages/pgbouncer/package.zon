.{
    .name = "pgbouncer",
    .version = "1.26.1",
    .release = 1,
    .description = "Lightweight connection pooler for PostgreSQL",
    .license = "ISC",
    .sources = .{
        // The SHA-256 is the one published beside the tarball
        // (pgbouncer-1.26.1.tar.gz.sha256) and on the GitHub release.
        .{ .url = "https://www.pgbouncer.org/downloads/files/1.26.1/pgbouncer-1.26.1.tar.gz", .sha256 = "00886a2994b4844cd37110970df777772cfc42a74c400522c82fba509a3f42d9" },
    },
    .depends = .{ "glibc", "libevent", "openssl", "c-ares", "linux-pam", "openldap", "systemd" },
    .build_depends = .{"pkgconf"},
}
