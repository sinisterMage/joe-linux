.{
    .name = "twolame",
    .version = "0.4.0",
    .release = 1,
    .description = "Optimised MPEG Audio Layer 2 (MP2) encoder library and program",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://github.com/njh/twolame/releases/download/0.4.0/twolame-0.4.0.tar.gz", .sha256 = "cc35424f6019a88c6f52570b63e1baf50f62963a3eac52a03a800bb070d7c87d" },
    },
    // libsndfile is read by the twolame program.
    .depends = .{ "glibc", "libsndfile" },
    .build_depends = .{"pkgconf"},
}
