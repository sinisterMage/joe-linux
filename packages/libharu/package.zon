.{
    .name = "libharu",
    .version = "2.4.6",
    .release = 1,
    .description = "Haru Free PDF Library, for generating PDF documents from C programs",
    .license = "Zlib",
    .sources = .{
        // GitHub's archive of the v2.4.6 tag; upstream publishes no
        // checksum.
        .{ .url = "https://github.com/libharu/libharu/archive/v2.4.6/libharu-2.4.6.tar.gz", .sha256 = "ec8f327520d1d354ce58b5d2af75b64f380cddc522437c169463b39760921348" },
    },
    // zlib: compressed streams; libpng: PNG images.
    .depends = .{ "glibc", "zlib", "libpng" },
    .build_depends = .{ "cmake", "ninja" },
}
