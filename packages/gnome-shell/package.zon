.{
    .name = "gnome-shell",
    .version = "51.1",
    .release = 1,
    .description = "The GNOME desktop shell: top bar, overview, notifications and the login and lock screens",
    .license = "GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/gnome-shell/51/gnome-shell-51.1.tar.xz", .sha256 = "c1eb08d9651a567ed5d9b2791371f1898e657cf45e75e1d88adefbab807977d6" },
    },
    // Linked: glib .. libxfixes. The rest is needed at run time: the shell
    // is JavaScript and imports these through introspection when it starts
    // (js/misc/dependencies.js lists the typelibs it refuses to start
    // without, IBus among them), runs inside the session that gnome-session
    // and gnome-settings-daemon provide, and its helper tools are Python.
    // gdm is not listed although the shell also imports Gdm-1.0 at start:
    // gdm depends on the shell, and the two are always installed together.
    .depends = .{
        "glibc",
        "glib",
        "gjs",
        "mutter",
        "gtk4",
        "gcr4",
        "polkit",
        "evolution-data-server",
        "gnome-desktop",
        "gsettings-desktop-schemas",
        "at-spi2-core",
        "cairo",
        "pango",
        "gdk-pixbuf",
        "librsvg",
        "glycin",
        "json-glib",
        "libxml2",
        "networkmanager",
        "libsecret",
        "pipewire",
        "pulseaudio",
        "systemd",
        "gnome-autoar",
        "libsoup",
        "libx11",
        "libxext",
        "libxfixes",
        "graphene",
        "libadwaita",
        "libnma",
        "accountsservice",
        "upower",
        "geoclue",
        "libgweather",
        "libgudev",
        "ibus",
        "gstreamer",
        "gst-plugins-base",
        "gnome-session",
        "gnome-settings-daemon",
        "adwaita-icon-theme",
        "dconf",
        "python",
        "pygobject",
    },
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext" },
}
