.{
    .name = "amberol",
    .version = "2026.1",
    .release = 1,
    .description = "Small music player that plays local files and nothing else",
    .license = "GPL-3.0-or-later",
    .sources = .{
        .{ .url = "https://gitlab.gnome.org/-/project/20183/uploads/2082c1a17bf5a35a7eae0b328f322eec/amberol-2026.1.tar.xz", .sha256 = "ce67fa91ad174556f6f63d4716ee437e8080d23ff5bc720b9ebfa32adab1598a" },
    },
    // The release tarball vendors its crates, so the build is offline.
    //
    // gst-plugins-base: libgstaudio, libgstvideo; gst-plugins-bad:
    // libgstplay. Playing needs the demuxers and decoders of
    // gst-plugins-good (with its ReplayGain elements, which Amberol uses)
    // and gst-libav (AAC and the like).
    .depends = .{ "glibc", "gcc", "glib", "gtk4", "libadwaita", "cairo", "pango", "gdk-pixbuf", "graphene", "gstreamer", "gst-plugins-base", "gst-plugins-bad", "gst-plugins-good", "gst-libav" },
    // The interface is written in Blueprint; appstream provides the gettext
    // rules for the metainfo file.
    .build_depends = .{ "rust", "meson", "ninja", "pkgconf", "gettext", "appstream", "blueprint-compiler" },
}
