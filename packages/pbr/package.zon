.{
    .name = "pbr",
    .version = "7.1.3",
    .release = 1,
    .description = "Python Build Reasonableness: setuptools extensions used by OpenStack projects",
    .license = "Apache-2.0",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/p/pbr/pbr-7.1.3.tar.gz", .sha256 = "9a4a85b84e906337708009af0b5f5cdabeeb72d4dc213c9e97974da54fd9acc5" },
    },
    // It extends setuptools and runs git (when a project is a git checkout)
    // for versions, authors and change logs.
    .depends = .{ "python", "setuptools" },
    // Builds itself (backend-path).
    .build_depends = .{ "python", "setuptools" },
}
