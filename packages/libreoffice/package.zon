.{
    .name = "libreoffice",
    .version = "26.8.2.2",
    .release = 1,
    .description = "Office suite: word processor, spreadsheet, presentations, drawing, formulas and databases",
    // LibreOffice itself is MPL-2.0 (parts dual LGPL-3.0-or-later); the
    // bundled libraries below add MIT, BSD, Apache, LGPL and EPL code.
    .license = "MPL-2.0 AND LGPL-3.0-or-later AND MIT AND BSD-3-Clause AND Apache-2.0 AND LGPL-2.1-or-later AND EPL-1.0",
    .sources = .{
        .{ .url = "https://download.documentfoundation.org/libreoffice/src/26.8.2/libreoffice-26.8.2.2.tar.xz", .sha256 = "f0012302d9cc70955bd55890d3aaccf6c55677c4a6a46e1003f996b1b0dae8e7" },
        // Everything below is bundled: LibreOffice builds these itself because
        // joe has no recipe for them. Each name and SHA-256 is the one in the
        // tree's download.lst; configure finds them through --with-external-tar.
        //
        // HarfBuzz with Graphite (joe's harfbuzz is built without graphite2,
        // which system HarfBuzz must have here).
        .{ .url = "https://dev-www.libreoffice.org/src/graphite2-minimal-1.3.15.tgz", .sha256 = "10cfc69a6f859ce875b9708d170b8222eba76cdb89b6dbb4ee1e375bc7242409" },
