        .{ .url = "https://dev-www.libreoffice.org/src/cppunit-1.15.1.tar.gz", .sha256 = "89c5c6665337f56fd2db36bc3805a5619709d51fb136e51937072f63fcc717a7" },
        // Header-only C++ libraries.
