        .{ .url = "https://dev-www.libreoffice.org/src/frozen-1.2.0.tar.gz", .sha256 = "ed8339c017d7c5fe019ac2c642477f435278f0dc643c1d69d3f3b1e95915e823" },
        .{ .url = "https://dev-www.libreoffice.org/src/glm-1.0.3.zip", .sha256 = "3aa4347b8f13cba882df1c7b61a6ca910c75a875c56ec3d75d7dc9ae8eac34df" },
        .{ .url = "https://dev-www.libreoffice.org/src/mdds-3.2.1.tar.xz", .sha256 = "673f5bb94612dbba581fc92b99b5e5dd1a53e29496a5dbc936432f6b0687c112" },
        // Calc: spreadsheet import/export and the two linear-programming solvers.
