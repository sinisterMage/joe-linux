        .{ .url = "https://dev-www.libreoffice.org/src/CoinMP-1.8.4.tgz", .sha256 = "3459fb0ccbdd39342744684338984ac4cc153fb0434f4cae8cf74bd67490a38d" },
        .{ .url = "https://dev-www.libreoffice.org/src/26b3e95ddf3d9c077c480ea45874b3b8-lp_solve_5.5.tar.gz", .sha256 = "171816288f14215c69e730f7a4f1c325739873e21f946ff83884b350574e6695" },
        // Documents on CMIS content servers (SharePoint, Alfresco, Google Drive).
        .{ .url = "https://dev-www.libreoffice.org/src/libcmis-0.6.3.tar.xz", .sha256 = "5adb3781f374adf491103b2cb2dc290085150c9b7d097baf56d8ac35df84e792" },
        // Signing: XML signatures (with system NSS), OpenPGP (GpgME; LibreOffice
        // builds it with its own libgpg-error and libassuan), PDF signatures and
        // PDF rendering (PDFium, whose import code needs AFDKO and ANTLR).
        .{ .url = "https://dev-www.libreoffice.org/src/xmlsec1-1.3.12.tar.gz", .sha256 = "24045199af12d93fe5fdbbbf7e386e823e4842071e9432e2b90ac108b889a923" },
        .{ .url = "https://www.gnupg.org/ftp/gcrypt/libgpg-error/libgpg-error-1.61.tar.bz2", .sha256 = "7a85413f2bc354f4f8aa832b718af122e48965e9e0eb9012ee659c13c6385c93" },
        .{ .url = "https://www.gnupg.org/ftp/gcrypt/libassuan/libassuan-3.0.2.tar.bz2", .sha256 = "d2931cdad266e633510f9970e1a2f346055e351bb19f9b78912475b8074c36f6" },
        .{ .url = "https://dev-www.libreoffice.org/src/gpgme-1.24.3.tar.bz2", .sha256 = "bfc17f5bd1b178c8649fdd918956d277080f33df006a2dc40acdecdce68c50dd" },
        .{ .url = "https://dev-www.libreoffice.org/src/pdfium-8073.tar.bz2", .sha256 = "a3624f6f0ac46a7e190969d405aa7a07dbc342baf69f81192487575bf64055a5" },
        .{ .url = "https://dev-www.libreoffice.org/src/afdko-4.0.3.tar.gz", .sha256 = "5feed7c2468e25b25fce0479c04af07f4ed2680bc9251bb4c4aef9ec2fba5720" },
        .{ .url = "https://dev-www.libreoffice.org/src/antlr4-cpp-runtime-4.13.2-source.zip", .sha256 = "0ed13668906e86dbc0dcddf30fdee68c10203dea4e83852b4edb810821bee3c4" },
        // Fonts: Embedded OpenType, and the OpenSymbol font every install needs.
        .{ .url = "https://dev-www.libreoffice.org/src/libeot-0.01.tar.bz2", .sha256 = "cf5091fa8e7dcdbe667335eb90a2cfdd0a3fe8f8c7c8d1ece44d9d055736a06a" },
        .{ .url = "https://dev-www.libreoffice.org/extern/f543e6e2d7275557a839a164941c0a86e5f2c3f2a0042bfc434c88c6dde9e140-opens___.ttf", .sha256 = "f543e6e2d7275557a839a164941c0a86e5f2c3f2a0042bfc434c88c6dde9e140" },
        // Import filters (WordPerfect, Visio, CorelDRAW, Publisher, Mac and
        // Apple formats, e-books, ...) and the ODF/EPUB generators they feed.
        .{ .url = "https://dev-www.libreoffice.org/src/librevenge-0.0.6.tar.bz2", .sha256 = "52a65e904d255dbdd97a8b7bb28d6574e14f999eb01416aff004502406d0904d" },
        .{ .url = "https://dev-www.libreoffice.org/src/libodfgen-0.1.8.tar.xz", .sha256 = "55200027fd46623b9bdddd38d275e7452d1b0ff8aeddcad6f9ae6dc25f610625" },
        .{ .url = "https://dev-www.libreoffice.org/src/libepubgen-0.1.1.tar.xz", .sha256 = "03e084b994cbeffc8c3dd13303b2cb805f44d8f2c3b79f7690d7e3fc7f6215ad" },
        .{ .url = "https://dev-www.libreoffice.org/src/libwpd-0.10.3.tar.xz", .sha256 = "2465b0b662fdc5d4e3bebcdc9a79027713fb629ca2bff04a3c9251fdec42dd09" },
        .{ .url = "https://dev-www.libreoffice.org/src/libwpg-0.3.4.tar.xz", .sha256 = "b55fda9440d1e070630eb2487d8b8697cf412c214a27caee9df69cec7c004de3" },
        .{ .url = "https://dev-www.libreoffice.org/src/libwps-0.4.14.tar.xz", .sha256 = "365b968e270e85a8469c6b160aa6af5619a4e6c995dbb04c1ecc1b4dd13e80de" },
        .{ .url = "https://dev-www.libreoffice.org/src/libvisio-0.1.11.tar.xz", .sha256 = "2a6efd40b6d9dbcb70fba3be53112366882ba97b57151df3698dfa478c8d8dd3" },
        .{ .url = "https://dev-www.libreoffice.org/src/libcdr-0.1.9.tar.xz", .sha256 = "f7bb6abdd7f226820f288a93dd8d07759833c0250d9e202af90f9b312c4665a3" },
        .{ .url = "https://dev-www.libreoffice.org/src/libmspub-0.1.5.tar.xz", .sha256 = "3671095f5a10bee8a755052a30576952c5b16d8b0f2ba9f2fb998338c18cb119" },
        .{ .url = "https://dev-www.libreoffice.org/src/libmwaw-0.3.23.tar.xz", .sha256 = "ac3590f691a2904eb8c7dc8b757b8a29f125f592449e421459ae8fa928b399eb" },
        .{ .url = "https://dev-www.libreoffice.org/src/libetonyek-0.1.13.tar.xz", .sha256 = "032b71cb597edd92a0b270b916188281bc35be55296b263f6817b29adbcb1709" },
        .{ .url = "https://dev-www.libreoffice.org/src/libfreehand-0.1.4.tar.xz", .sha256 = "350b10d24a76d7e8c8ae98b74c2d432a2c8ddec08935d09856d20b695a35e600" },
        .{ .url = "https://dev-www.libreoffice.org/src/libe-book-0.1.4.tar.xz", .sha256 = "104b7e791b6632745898e9b6a0037b7540235771a4d8c3bde2c764466ad912f1" },
        .{ .url = "https://dev-www.libreoffice.org/src/libabw-0.1.4.tar.xz", .sha256 = "fa2685a3440da6e03a66a778480d93cb95f6064e4541e58e37397680760fd6a0" },
        .{ .url = "https://dev-www.libreoffice.org/src/libpagemaker-0.0.4.tar.xz", .sha256 = "66adacd705a7d19895e08eac46d1e851332adf2e736c566bef1164e7a442519d" },
        .{ .url = "https://dev-www.libreoffice.org/src/libqxp-0.0.3.tar.xz", .sha256 = "4687a9cc96c32d7406e5072c4da150fca696c563e5cde62b024f82fa53d32332" },
        .{ .url = "https://dev-www.libreoffice.org/src/libzmf-0.0.2.tar.xz", .sha256 = "27051a30cb057fdb5d5de65a1f165c7153dc76e27fe62251cbb86639eb2caf22" },
        .{ .url = "https://dev-www.libreoffice.org/src/libstaroffice-0.0.8.tar.xz", .sha256 = "bbca92882e96c55bd1527670866d6bc7529ccb12786da55a2398b60a063378da" },
        // RDF metadata in ODF documents.
        .{ .url = "https://dev-www.libreoffice.org/src/raptor2-2.0.16.tar.gz", .sha256 = "089db78d7ac982354bdbf39d973baf09581e6904ac4c92a98c5caadb3de44680" },
        .{ .url = "https://dev-www.libreoffice.org/src/1f5def51ca0026cd192958ef07228b52-rasqal-0.9.33.tar.gz", .sha256 = "6924c9ac6570bd241a9669f83b467c728a322470bf34f4b2da4f69492ccfd97c" },
        .{ .url = "https://dev-www.libreoffice.org/src/e5be03eda13ef68aabab6e42aa67715e-redland-1.0.17.tar.gz", .sha256 = "de1847f7b59021c16bdc72abb4d8e2d9187cd6124d69156f3326dd34ee043681" },
        // Markdown import, password strength, QR codes and barcodes, physics
        // in Impress animations.
        .{ .url = "https://dev-www.libreoffice.org/src/md4c-0.6.0.tar.gz", .sha256 = "4d151298125a81da3b2efa2e0eed8bdb7a9318569804e4fa4d7a2375ab83ef70" },
        .{ .url = "https://dev-www.libreoffice.org/src/zxcvbn-c-2.6.tar.gz", .sha256 = "11e39f6776f9c82c68b2acb94336e32697d4ab6cdb4ac16f9583ccbdd735113a" },
        .{ .url = "https://dev-www.libreoffice.org/src/zxing-cpp-3.1.1.tar.gz", .sha256 = "c3c02c29c0b519de7bd4e25b376e606e87f0761befd1282815642a2246613d14" },
        .{ .url = "https://dev-www.libreoffice.org/src/box2d-3.1.1.tar.gz", .sha256 = "fb6ef914b50f4312d7d921a600eabc12318bb3c55a0b8c0b90608fa4488ef2e4" },
        // Hyphenation, thesaurus, language guessing, number spelling, BCP 47
        // language tags.
        .{ .url = "https://dev-www.libreoffice.org/src/442b985e604f8143a5a0e7bacd6b2e40-hyphen-2.8.9.tar.gz", .sha256 = "783743daf477de8c4d16e3c74b4d2827377017718d8e17e2d9440210246f6abe" },
        .{ .url = "https://dev-www.libreoffice.org/src/mythes-1.2.6.tar.xz", .sha256 = "97bd2ba5738aebdba1bc31f30f1be42f1404386c94105ad5990d839a1311c8a5" },
        .{ .url = "https://dev-www.libreoffice.org/src/libexttextcat-3.4.8.tar.xz", .sha256 = "93eb89fd4fc8f565806354e100e778b3ac9a24e5fc04c24e6a83fb1e9b6c9d59" },
        .{ .url = "https://dev-www.libreoffice.org/src/libnumbertext-1.0.11.tar.xz", .sha256 = "5dcb4db3b2340f81f601ce86d8d76b69e34d70f84f804192c901e4b7f84d5fb0" },
        .{ .url = "https://dev-www.libreoffice.org/src/liblangtag-0.6.8.tar.bz2", .sha256 = "a96975b79ddd8fef6d9295c083fe3f1afa1a8898a57235d4069255ade44e5cf2" },
        .{ .url = "https://dev-www.libreoffice.org/src/language-subtag-registry-2026-9-17.tar.bz2", .sha256 = "10223cc8c219427c86a4c66ce98282a00c7f4d9b0609355146282344783007f2" },
        // The Skia renderer, used by the X11 (gen) backend.
        .{ .url = "https://dev-www.libreoffice.org/src/skia-m147-ad8ecedbfdef9f4ae4b1e73347b6dd56e6637d38.tar.xz", .sha256 = "92f613b60126f9068af02c5eb29abef6931e343888f027d87da100ddf2a003a1" },
    },
    // gtk3 is the VCL backend the GNOME desktop uses; the X11 libraries and
    // mesa (libGL) are the generic X11 backend and OpenGL slide transitions.
    // python is the scripting provider (pyuno). postgresql is libpq, for the
    // PostgreSQL driver in Base. gstreamer plays media in presentations.
    // hunspell-en is the spelling dictionary configure points at
    // (/usr/share/hunspell). gnupg: gpg verifies OpenPGP signatures.
    .depends = .{
        "glibc",        "gcc",              "glib",          "gtk3",          "at-spi2-core",
        "pango",        "gdk-pixbuf",       "cairo",         "fontconfig",    "freetype",
        "icu",          "boost",            "curl",          "expat",         "libjpeg-turbo",
        "lcms2",        "tiff",             "libpng",        "libxml2",       "libxslt",
        "libwebp",      "nss",              "nspr",          "openssl",       "poppler",
        "postgresql",   "zlib",             "zstd",          "libepoxy",      "hunspell",
        "hunspell-en",  "argon2",           "abseil-cpp",    "openjpeg",      "python",
        "dbus",         "cups",             "avahi",         "dconf",         "gstreamer",
        "gst-plugins-base", "libx11",       "libxext",       "libsm",         "libice",
        "libxrender",   "libxrandr",        "libxinerama",   "mesa",          "gnupg",
    },
    // autoconf, automake and libtool: autogen.sh, and the bundled xmlsec,
    // libassuan and gpgme, which are autoreconf'd. meson and ninja build the
    // bundled HarfBuzz. lxml is used by the build's UI checks. libarchive
    // provides unzip for the zip sources. llvm's clang compiles Skia and
    // PDFium, as configure prefers. fast_float is header-only; sane and bluez
    // supply headers only (libsane is opened at run time when present, and
    // the Impress remote talks to BlueZ over D-Bus).
    .build_depends = .{
        "autoconf", "automake", "libtool", "pkgconf",    "perl",  "lxml",
        "meson",    "ninja",    "gperf",   "flex",       "bison", "zip",
        "libarchive", "which",  "llvm",    "fast_float", "sane",  "bluez",
    },
}
