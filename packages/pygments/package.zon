.{
    .name = "pygments",
    .version = "2.21.0",
    .release = 1,
    .description = "Syntax highlighting library and command-line tool written in Python",
    .license = "BSD-2-Clause",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/P/Pygments/pygments-2.21.0.tar.gz", .sha256 = "610ca751c9bc2492b38eb9a38a7fbc93edbbb2d7182edaf34e66ae493dee5c8c" },
    },
    .depends = .{"python"},
    // The book builds with hatchling, which joe Linux does not have; see
    // build.sh.
    .build_depends = .{ "python", "setuptools", "wheel" },
}
