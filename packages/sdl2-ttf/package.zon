.{
    .name = "sdl2-ttf",
    .version = "2.24.0",
    .release = 1,
    .description = "TrueType font rendering library for SDL 2 (SDL2_ttf)",
    .license = "Zlib",
    .sources = .{
        // The SDL 2 release series. GitHub gives no digest for this
        // release's assets; checked against the detached signature
        // published with it (SDL2_ttf-2.24.0.tar.gz.sig, Sam Lantinga's key
        // 1528635D8053A57F77D1E08630A59377A7763BE6).
        .{ .url = "https://github.com/libsdl-org/SDL_ttf/releases/download/release-2.24.0/SDL2_ttf-2.24.0.tar.gz", .sha256 = "0b2bf1e7b6568adbdbc9bb924643f79d9dedafe061fa1ed687d1d9ac4e453bfd" },
    },
    .depends = .{ "glibc", "sdl2", "freetype", "harfbuzz" },
    .build_depends = .{ "cmake", "ninja", "pkgconf" },
}
