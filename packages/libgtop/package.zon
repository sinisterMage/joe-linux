.{
    .name = "libgtop",
    .version = "2.41.3",
    .release = 3,
    .description = "Library for reading system and per-process usage statistics",
    .license = "GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/libgtop/2.41/libgtop-2.41.3.tar.xz", .sha256 = "775676df958e2ea2452f7568f28b2ea581063d312773dd5c0b7624c1b9b2da8c" },
    },
    .depends = .{ "glibc", "glib", "libx11", "libxau" },
    .build_depends = .{ "pkgconf", "gettext" },
    .operations = .{
        // Reads other users' process statistics for system monitors.
        .{ .programs = .{"usr/libexec/libgtop_server2"}, .allow = .{ "cap:sys_ptrace", "cap:dac_read_search" } },
    },
}
