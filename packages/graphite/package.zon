.{
    .name = "graphite",
    .version = "1.3.14",
    .release = 1,
    .description = "Graphite2, the SIL rendering engine for Graphite smart fonts of complex scripts",
    .license = "LGPL-2.1-or-later OR MPL-2.0 OR GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://github.com/silnrsi/graphite/releases/download/1.3.14/graphite2-1.3.14.tgz", .sha256 = "f99d1c13aa5fa296898a181dff9b82fb25f6cc0933dbaa7a475d8109bd54209d" },
    },
    // libgraphite2 is C++ linked without libstdc++ (upstream uses
    // -nodefaultlibs and the static libgcc); the gr2fonttest tool does use
    // libstdc++.
    .depends = .{ "glibc", "gcc" },
    .build_depends = .{ "cmake" },
}
