.{
    .name = "difftastic",
    .version = "0.72.0",
    .release = 1,
    .description = "Structural diff tool that understands syntax (difft)",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://github.com/Wilfred/difftastic/archive/0.72.0/difftastic-0.72.0.tar.gz", .sha256 = "ed8e2d59d44d62289b17c9d241e469bd72565fadf13c260676fc7a23bc28a844" },
    },
    // cargo downloads the crates difftastic depends on from crates.io; they
    // are not vendored yet.
    .network = true,
    // libgcc_s (gcc) for unwinding. jemalloc and the tree-sitter grammars
    // are linked in statically. tree_magic_mini reads the shared MIME
    // database to tell binary files from text, which upstream's packaging
    // notes ask packages to depend on.
    .depends = .{ "glibc", "gcc", "shared-mime-info" },
    // make for the copy of jemalloc that tikv-jemalloc-sys builds.
    .build_depends = .{ "rust", "make" },
}
