.{
    .name = "ibus-libpinyin",
    .version = "1.16.6",
    .release = 1,
    .description = "Chinese pinyin and bopomofo input for IBus, using libpinyin",
    .license = "GPL-3.0-or-later",
    .sources = .{
        // Upstream publishes no checksum for its release tarballs.
        .{ .url = "https://github.com/libpinyin/ibus-libpinyin/releases/download/v1.16.6/ibus-libpinyin-1.16.6.tar.gz", .sha256 = "99f7b44bcff606bc4dfa3535bccf42384616a8ee834ac65459e7ac9e3c79be37" },
    },
    // The engine is C++ on IBus, libpinyin and SQLite (the English and
    // stroke tables), with the Lua extension, cloud candidates (libsoup,
    // json-glib) and notifications. Its preferences are Python on
    // PyGObject and GTK 3.
    .depends = .{
        "glibc",   "gcc",       "glib",      "ibus",      "libpinyin",
        "sqlite",  "lua",       "libsoup",   "json-glib", "libnotify",
        "python",  "pygobject", "gtk3",      "pango",
    },
    // configure imports IBus through PyGObject to check its features; the
    // sqlite3 program builds the tables.
    .build_depends = .{ "pkgconf", "gettext", "python", "pygobject", "ibus" },
}
