.{
    .name = "tzlocal",
    .version = "5.4.5",
    .release = 1,
    .description = "Python module that returns the local time zone as a zoneinfo object",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/t/tzlocal/tzlocal-5.4.5.tar.gz", .sha256 = "ba976898bad27945178c9ca25c222c19e322b30c10342b9f40b46714f70d2d5f" },
    },
    // zoneinfo reads the rules from /usr/share/zoneinfo.
    .depends = .{ "python", "tzdata" },
    .build_depends = .{ "python", "setuptools", "wheel" },
}
