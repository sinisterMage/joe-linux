.{
    .name = "authenticator",
    .version = "4.6.2",
    .release = 1,
    .description = "Generate two-factor authentication codes",
    .license = "GPL-3.0-or-later",
    .sources = .{
        .{ .url = "https://gitlab.gnome.org/-/project/4706/uploads/679ac005033cdd240acc1ebc08a5d5ed/authenticator-4.6.2.tar.xz", .sha256 = "f33122b2f48db9b3f2a23fc873100cb2d0876028b86ac633e8f783b405c54306" },
        // The releases of the openssl crates that know OpenSSL 4 (build.sh).
        .{ .url = "https://static.crates.io/crates/openssl/openssl-0.10.82.crate", .sha256 = "4de8111e94a56adca7ebfe6c365b6d42f99deb69b74b6becacd4204e2f193aa2" },
        .{ .url = "https://static.crates.io/crates/openssl-sys/openssl-sys-0.9.118.crate", .sha256 = "19c413d6ec9ebaf5e1c829d355cb3e9f783778d700f135be0921d52fce3c60ae" },
    },
    // The release tarball vendors its crates, so the build is offline.
    //
    // gst-plugins-base: libgstvideo, libgstpbutils, libgstaudio for the QR
    // code scanner (the aperture crate); it also runs camerabin
    // (gst-plugins-bad) and gtk4paintablesink (gst-plugin-gtk4) and finds
    // the camera through PipeWire's GStreamer plugin. sqlite holds the
    // accounts (diesel); openssl is reqwest's TLS for fetching favicons;
    // xz (liblzma) is found by the zip crate's lzma-sys, while its bzip2
    // and zstd are compiled in. QR codes are decoded by the rqrr crate, not
    // zbar, and secrets are kept through the Secret Service D-Bus API by
    // the oo7 crate, not libsecret.
    .depends = .{ "glibc", "gcc", "glib", "gtk4", "libadwaita", "cairo", "pango", "gdk-pixbuf", "graphene", "gstreamer", "gst-plugins-base", "gst-plugins-bad", "gst-plugin-gtk4", "pipewire", "sqlite", "openssl", "xz" },
    // appstream provides the gettext rules for the metainfo file.
    .build_depends = .{ "rust", "meson", "ninja", "pkgconf", "gettext", "appstream" },
}
