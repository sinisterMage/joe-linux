.{
    .name = "unpaper",
    .version = "7.0.0",
    .release = 1,
    .description = "Deskew, clean and post-process scanned document pages",
    .license = "GPL-2.0-only",
    .sources = .{
        // Upstream publishes no sums/signatures. SHA-256 cross-checked with
        // FreeBSD graphics/unpaper/distinfo and Arch's unpaper PKGBUILD.
        .{ .url = "https://github.com/unpaper/unpaper/releases/download/unpaper-7.0.0/unpaper-7.0.0.tar.xz", .sha256 = "2575fbbf26c22719d1cb882b59602c9900c7f747118ac130883f63419be46a80" },
    },
    .depends = .{ "glibc", "ffmpeg" },
    .build_depends = .{ "gcc", "meson", "ninja", "pkgconf", "sphinx", "patch" },
}
