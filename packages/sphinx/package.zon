.{
    .name = "sphinx",
    .version = "9.2.0",
    .release = 1,
    .description = "Python documentation generator",
    .license = "BSD-2-Clause",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/s/sphinx/sphinx-9.2.0.tar.gz", .sha256 = "90470459f3cab15d9dfed146c71cf77694b0445df17b2e0e69059cb9f7fc9ee4" },
    },
    .depends = .{
        "python",
        "alabaster",
        "babel",
        "docutils",
        "imagesize",
        "jinja2",
        "packaging",
        "pygments",
        "requests",
        "roman-numerals",
        "snowballstemmer",
        "sphinxcontrib-applehelp",
        "sphinxcontrib-devhelp",
        "sphinxcontrib-htmlhelp",
        "sphinxcontrib-jsmath",
        "sphinxcontrib-qthelp",
        "sphinxcontrib-serializinghtml",
    },
    .build_depends = .{ "python", "flit-core" },
}
