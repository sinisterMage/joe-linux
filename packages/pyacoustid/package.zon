.{
    .name = "pyacoustid",
    .version = "1.3.1",
    .release = 1,
    .description = "Python bindings for Chromaprint fingerprints and the AcoustID web service",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/p/pyacoustid/pyacoustid-1.3.1.tar.gz", .sha256 = "bb0ecae40109c0aa80f709e33c66c83ec36b2fd84658f9fad056a34538f79e8a" },
    },
    // Fingerprints are computed by chromaprint's fpcalc program (or with
    // libchromaprint when audioread is installed, which it is not: its
    // aifc and sunau modules left the standard library in Python 3.13).
    .depends = .{ "python", "requests", "chromaprint" },
    .build_depends = .{ "python", "poetry-core" },
}
