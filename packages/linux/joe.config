# joe Linux kernel configuration, applied on top of the kernel's own
# x86_64_defconfig. Everything needed to mount the root file system is built
# in, because joe boots without an initramfs.

CONFIG_LOCALVERSION="-joe"
# CONFIG_LOCALVERSION_AUTO is not set

# Boot path: EFI stub loaded by systemd-boot, root on btrfs.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_FS_VERITY=y

# Storage controllers that may hold the root file system.
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_MMIO=y

# The live medium (image/live.zon): an ISO 9660 file system on a CD or USB
# stick holding a compressed root image, mounted by its initramfs with a
# writable layer in memory over it. USB sticks that speak UAS appear only
# with its driver.
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_SR=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# The EFI system partition.
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Virtual machines: network, console, memory, entropy, display, watchdog.
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
# A directory of the host shared with the guest (image/run.sh --share).
CONFIG_VIRTIO_FS=y
CONFIG_FB_EFI=y
CONFIG_WATCHDOG=y
CONFIG_I6300ESB_WDT=y

# What the desktop needs: FUSE (portals, GVfs), input devices, sound, and the
# event interfaces PipeWire and libinput use.
CONFIG_FUSE_FS=y
CONFIG_CUSE=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_VIRTIO_INPUT=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
# The codec QEMU's hda-duplex presents has no driver of its own; without the
# generic parser the controller is found and no sound card appears.
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_VIRTIO=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_UHID=y

# What systemd requires or strongly recommends.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CPUSETS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_DMIID=y
CONFIG_BLK_DEV_BSG=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_PSI=y
# A kernel debugging aid that prints to the console during normal operation.
# CONFIG_DEBUG_STACK_USAGE is not set
# CONFIG_SYSFS_DEPRECATED is not set
# CONFIG_FW_LOADER_USER_HELPER is not set

# A console on the firmware's or the virtual machine's display.
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

CONFIG_SECURITY=y
CONFIG_SECURITYFS=y

# The joe security module (packages/linux/joe-lsm). It logs violations unless
# booted with joe=enforce.
CONFIG_SECURITY_JOE=y
CONFIG_LSM="landlock,lockdown,yama,joe,bpf"

# Module signing is off: the security module checks that a module is sealed
# before it is loaded. The kernel's key ring exists only for the wireless
# regulatory database, which is signature-checked against the keys of its
# maintainers that the kernel ships (CFG80211_USE_KERNEL_REGDB_KEYS).
# CONFIG_MODULE_SIG is not set
# CONFIG_INTEGRITY is not set
# CONFIG_DEBUG_INFO_BTF is not set

# ---------------------------------------------------------------------------
# Real computers. Installed systems have no initramfs, so whatever holds the
# root is built in; whatever needs firmware is a module, loaded by udev once
# the root (and /usr/lib/firmware, from linux-firmware) is there. Firmware is
# installed zstd-compressed.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Disks: Intel RST (VMD) hides NVMe disks behind itself; eMMC laptops;
# Hyper-V and VMware virtual disks.
CONFIG_VMD=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y
CONFIG_VMWARE_PVSCSI=y
CONFIG_SCSI_LOWLEVEL=y

# Graphics. The firmware's framebuffer (simpledrm) shows the console and the
# installer until the real driver takes over; the drivers need firmware, so
# they are modules. defconfig builds i915 in, which cannot load its firmware.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_HYPERV=m
CONFIG_DRM_VBOXVIDEO=m
CONFIG_ACPI_VIDEO=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Sound. The HDA controller is built in (for virtual machines), so its codec
# drivers must be too: a codec the controller finds before the root is
# mounted would otherwise be left to the generic parser for good. Intel's
# audio DSPs (most laptops since 2019) need firmware (sof-firmware).
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ALC269=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_HDMI_INTEL=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_TIGERLAKE=m
CONFIG_SND_SOC_SOF_ALDERLAKE=m
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_LUNARLAKE=m
CONFIG_SND_USB_AUDIO=m

# Laptops: touchpads and touchscreens on I2C, platform features.
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_THINKPAD_ACPI=m
CONFIG_INTEL_PMC_CORE=y
CONFIG_AMD_PMC=m
CONFIG_X86_AMD_PSTATE=y

# Wired networks, on the board and over USB.
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_R8169=m
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_AX88179_178A=m

# Wireless: the common chips of the last ten years. mac80211_hwsim lets the
# tests exercise Wi-Fi in a virtual machine.
CONFIG_WIRELESS=y
CONFIG_SYSTEM_DATA_VERIFICATION=y
CONFIG_CFG80211=m
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_WLAN=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_ATH9K=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_RTW88=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW89=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_BRCMFMAC=m
CONFIG_MAC80211_HWSIM=m
