# joe Linux kernel configuration, applied on top of the kernel's own
# x86_64_defconfig. Everything needed to mount the root file system is built
# in, because joe boots without an initramfs.

CONFIG_LOCALVERSION="-joe"
# CONFIG_LOCALVERSION_AUTO is not set

# Boot path: EFI stub loaded by systemd-boot, root on btrfs.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_FS_VERITY=y

# Storage controllers that may hold the root file system.
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_MMIO=y

# The live medium (image/live.zon): an ISO 9660 file system on a CD or USB
# stick holding a SquashFS root image (xz, with the x86 filter), mounted by
# its initramfs, which loads no modules, with a writable layer in memory over
# it. USB sticks that speak UAS appear only with its driver.
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_SR=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_XZ_DEC=y
CONFIG_XZ_DEC_X86=y
# erofs images (erofs-utils makes them) mount with the module.
CONFIG_EROFS_FS=m
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# The EFI system partition.
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Virtual machines: network, console, memory, entropy, display, watchdog.
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
# A directory of the host shared with the guest (image/run.sh --share).
CONFIG_VIRTIO_FS=y
CONFIG_WATCHDOG=y
CONFIG_I6300ESB_WDT=y

# What the desktop needs: FUSE (portals, GVfs), input devices, sound, and the
# event interfaces PipeWire and libinput use.
CONFIG_FUSE_FS=y
CONFIG_CUSE=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_VIRTIO_INPUT=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
# The codec QEMU's hda-duplex presents has no driver of its own; without the
# generic parser the controller is found and no sound card appears.
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_VIRTIO=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_UHID=y

# What systemd requires or strongly recommends.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CPUSETS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_DMIID=y
CONFIG_BLK_DEV_BSG=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_PSI=y
# A kernel debugging aid that prints to the console during normal operation.
# CONFIG_DEBUG_STACK_USAGE is not set
# CONFIG_SYSFS_DEPRECATED is not set
# CONFIG_FW_LOADER_USER_HELPER is not set

# A console on the firmware's or the virtual machine's display.
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

CONFIG_SECURITY=y
CONFIG_SECURITYFS=y

# The joe security module (packages/linux/joe-lsm). It logs violations unless
# booted with joe=enforce.
CONFIG_SECURITY_JOE=y
CONFIG_LSM="landlock,lockdown,yama,joe,bpf"

# Module signing is off: the security module checks that a module is sealed
# before it is loaded. The kernel's key ring exists only for the wireless
# regulatory database, which is signature-checked against the keys of its
# maintainers that the kernel ships (CFG80211_USE_KERNEL_REGDB_KEYS).
# CONFIG_MODULE_SIG is not set
# CONFIG_INTEGRITY is not set
# CONFIG_DEBUG_INFO_BTF is not set

# ---------------------------------------------------------------------------
# Real computers. Installed systems have no initramfs, so whatever holds the
# root is built in; whatever needs firmware is a module, loaded by udev once
# the root (and /usr/lib/firmware, from linux-firmware) is there. Firmware is
# installed zstd-compressed.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Disks: Intel RST (VMD) hides NVMe disks behind itself; eMMC laptops;
# Hyper-V and VMware virtual disks.
CONFIG_VMD=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y
CONFIG_VMWARE_PVSCSI=y
CONFIG_SCSI_LOWLEVEL=y

# Graphics. The firmware's framebuffer (simpledrm) shows the console and the
# installer until the real driver takes over; the drivers need firmware, so
# they are modules. defconfig builds i915 in, which cannot load its firmware.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_HYPERV=m
CONFIG_DRM_VBOXVIDEO=m
CONFIG_ACPI_VIDEO=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Sound. The HDA controller is built in (for virtual machines), so its codec
# drivers must be too: a codec the controller finds before the root is
# mounted would otherwise be left to the generic parser for good. Intel's
# audio DSPs (most laptops since 2019) need firmware (sof-firmware).
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ALC269=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_HDMI_INTEL=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_TIGERLAKE=m
CONFIG_SND_SOC_SOF_ALDERLAKE=m
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_LUNARLAKE=m
CONFIG_SND_USB_AUDIO=m

# Laptops: touchpads and touchscreens on I2C, platform features. The I2C
# controllers are Synopsys DesignWare blocks, on Intel behind LPSS; a
# touchpad's interrupt is a GPIO line of the chipset's pin controller. None
# of this exists without GPIOLIB and the common clock framework, which
# x86_64_defconfig leaves out (and which the Bluetooth UART protocols below
# need too).
CONFIG_GPIOLIB=y
CONFIG_COMMON_CLK=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_ELKHARTLAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
# Intel's PMC driver (low-power idle states) reads its registers through the
# platform telemetry interface.
CONFIG_INTEL_VSEC=y
CONFIG_INTEL_PMT_TELEMETRY=y
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_THINKPAD_ACPI=m
CONFIG_INTEL_PMC_CORE=y
CONFIG_AMD_PMC=m
CONFIG_X86_AMD_PSTATE=y

# Wired networks, on the board and over USB.
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_R8169=m
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_AX88179_178A=m

# Wireless: the common chips of the last ten years. mac80211_hwsim lets the
# tests exercise Wi-Fi in a virtual machine.
CONFIG_WIRELESS=y
CONFIG_SYSTEM_DATA_VERIFICATION=y
CONFIG_CFG80211=m
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_WLAN=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_ATH9K=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_RTW88=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW89=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_BRCMFMAC=m
CONFIG_MAC80211_HWSIM=m

# Bluetooth (bluez, gnome-bluetooth): the protocols headsets, keyboards, mice
# and file transfer use, and the USB, PCIe and UART controllers laptops have.
# Their firmware is in linux-firmware.
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_INTEL_PCIE=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_INTEL=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_CRYPTO_ECDH=y

# Mobile broadband (ModemManager): MBIM and QMI modems on USB, modems on PCIe
# (MHI, Intel IOSM, MediaTek T7xx), and the serial drivers older modems use.
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_WDM=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_QUALCOMM=m
CONFIG_WWAN=m
CONFIG_MHI_BUS_PCI_GENERIC=m
CONFIG_MHI_WWAN_CTRL=m
CONFIG_MHI_WWAN_MBIM=m
CONFIG_IOSM=m
CONFIG_MTK_T7XX=m

# VPNs: WireGuard (wireguard-tools), and the TUN/TAP devices OpenVPN uses.
CONFIG_WIREGUARD=m
CONFIG_TUN=m

# Firewalls (nftables): the tables, and the expressions rulesets commonly use.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_COMPAT=m

# Network file systems: SMB shares (cifs-utils) and the NFS server
# (nfs-utils); the NFS client is part of x86_64_defconfig.
CONFIG_CIFS=m
CONFIG_NFSD=m
CONFIG_NFSD_V4=y

# iwd does its Wi-Fi cryptography with the kernel's, through AF_ALG and keyctl.
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_DES=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# ---------------------------------------------------------------------------
# Containers, virtual machines, VPNs and firewalls: what docker, podman,
# Kubernetes, libvirt and QEMU, strongswan, ppp, firewalld, fail2ban and the
# xtables rules that iptables-nft translates need. Modules, unless an option
# is only a switch.

# Netfilter beyond the basics: the xtables matches and targets iptables-nft
# uses, the connection-tracking helpers firewalld's services name, the
# conntrack netlink interfaces, IP sets and IPVS (kube-proxy).
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_NETLINK_GLUE_CT=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMESTAMP=y
CONFIG_NF_CONNTRACK_LABELS=y
CONFIG_NF_CONNTRACK_AMANDA=m
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_H323=m
CONFIG_NF_CONNTRACK_NETBIOS_NS=m
CONFIG_NF_CONNTRACK_SNMP=m
CONFIG_NF_CONNTRACK_PPTP=m
CONFIG_NF_CONNTRACK_SANE=m
CONFIG_NF_CONNTRACK_SIP=m
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_CT_NETLINK=m
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CT_NETLINK_TIMEOUT=m
CONFIG_NF_CT_NETLINK_HELPER=m
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_NFT_FLOW_OFFLOAD=m
CONFIG_NFT_NUMGEN=m
CONFIG_NFT_FWD_NETDEV=m
CONFIG_NFT_XFRM=m
CONFIG_NFT_OSF=m
CONFIG_NFT_TPROXY=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_SET=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNLABEL=m
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=m
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_OSF=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_IP6_NF_MATCH_RT=m
CONFIG_IP_SET=m
CONFIG_IP_SET_BITMAP_PORT=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_IPPORT=m
CONFIG_IP_SET_HASH_IPPORTIP=m
CONFIG_IP_SET_HASH_IPPORTNET=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_NETPORT=m
CONFIG_IP_SET_LIST_SET=m
CONFIG_IP_VS=m
CONFIG_IP_VS_IPV6=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_PROTO_SCTP=y
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_WRR=m
CONFIG_IP_VS_LC=m
CONFIG_IP_VS_SH=m
CONFIG_IP_VS_NFCT=y

# The virtual network devices containers and virtual machines are wired
# with, and policy routing (tailscale, strongswan, VRFs).
CONFIG_BRIDGE=m
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_BRIDGE_NF_EBTABLES=m
CONFIG_VLAN_8021Q=m
CONFIG_VETH=m
CONFIG_DUMMY=m
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_IPVLAN=m
CONFIG_IPVTAP=m
CONFIG_VXLAN=m
CONFIG_GENEVE=m
CONFIG_IFB=m
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_NET_VRF=m
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP_SCTP=m

# Traffic control: libvirt's and CNI's bandwidth limits, eBPF-based CNIs.
CONFIG_NET_SCH_HTB=m
CONFIG_NET_SCH_TBF=m
CONFIG_NET_SCH_SFQ=m
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_U32=m
CONFIG_NET_CLS_FW=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_POLICE=m
CONFIG_NET_ACT_MIRRED=m
CONFIG_NET_ACT_BPF=m

# IPsec (strongswan, docker's encrypted overlay networks).
CONFIG_INET_AH=m
CONFIG_INET_ESP=m
CONFIG_INET_ESPINTCP=y
CONFIG_INET_IPCOMP=m
CONFIG_INET6_AH=m
CONFIG_INET6_ESPINTCP=y
CONFIG_INET6_IPCOMP=m
CONFIG_XFRM_INTERFACE=m
CONFIG_XFRM_MIGRATE=y
CONFIG_NET_IPVTI=m
CONFIG_IPV6_VTI=m
CONFIG_CRYPTO_CHACHA20POLY1305=m
CONFIG_CRYPTO_XCBC=m
CONFIG_CRYPTO_DEFLATE=m
CONFIG_CRYPTO_AES_NI_INTEL=m

# PPP (ppp, openfortivpn, PPPoE) and L2TP.
CONFIG_PPP=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_SYNC_TTY=m
CONFIG_PPP_DEFLATE=m
CONFIG_PPP_BSDCOMP=m
CONFIG_PPP_MPPE=m
CONFIG_PPP_FILTER=y
CONFIG_PPP_MULTILINK=y
CONFIG_PPPOE=m
CONFIG_N_HDLC=m
CONFIG_L2TP=m
CONFIG_L2TP_V3=y
CONFIG_L2TP_IP=m
CONFIG_L2TP_ETH=m
CONFIG_PPPOL2TP=m

# More USB modems once usb-modeswitch has switched them.
CONFIG_USB_NET_HUAWEI_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_CDC_EEM=m
CONFIG_USB_SERIAL_SIERRAWIRELESS=m

# A virtual machine host (libvirt, QEMU): KVM, vhost, vsock, device
# passthrough, NBD exports; I/O limits and checkpointing for containers;
# compiled BPF for seccomp filters and tc.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m
CONFIG_VSOCKETS=m
CONFIG_VSOCKETS_DIAG=m
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_BLK_DEV_NBD=m
CONFIG_KSM=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_BPF_JIT=y

# A guest of QEMU (vsock, the QXL display, firmware configuration) and of
# VMware (open-vm-tools), and Azure's provisioning media (cloud-init).
CONFIG_VIRTIO_VSOCKETS=m
CONFIG_DRM_QXL=m
CONFIG_FW_CFG_SYSFS=m
CONFIG_VMWARE_BALLOON=m
CONFIG_VMWARE_VMCI=m
CONFIG_VMWARE_VMCI_VSOCKETS=m
CONFIG_VMXNET3=m
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_PTP_1588_CLOCK_VMW=m
CONFIG_UDF_FS=m
