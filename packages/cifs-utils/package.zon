.{
    .name = "cifs-utils",
    .version = "7.9",
    .release = 1,
    .description = "Programs for mounting SMB/CIFS shares with the Linux kernel client",
    .license = "GPL-3.0-or-later",
    .sources = .{
        .{ .url = "https://www.samba.org/ftp/linux-cifs/cifs-utils/cifs-utils-7.9.tar.bz2", .sha256 = "9f3750f402520b15c2c8eb52fd485df6ea77e5e66fe5e39ce8ac4386c32c0296" },
    },
    // krb5 and keyutils: cifs.upcall (Kerberos mounts) and cifscreds.
    // smbinfo and smb2-quota are Python scripts.
    .depends = .{ "glibc", "talloc", "krb5", "keyutils", "libcap-ng", "python" },
    .build_depends = .{ "pkgconf", "docutils" },
}
