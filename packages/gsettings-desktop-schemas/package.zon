.{
    .name = "gsettings-desktop-schemas",
    .version = "51.0",
    .release = 1,
    .description = "GSettings schemas shared by the components of a desktop",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/gsettings-desktop-schemas/51/gsettings-desktop-schemas-51.0.tar.xz", .sha256 = "1e2419a5f21d26c324b28ae1c00e29e9175e8b596fff385a04c2172b36652226" },
    },
    .depends = .{"glib"},
    // glib provides glib-mkenums and g-ir-scanner.
    .build_depends = .{ "meson", "ninja", "pkgconf", "python", "gettext" },
}
