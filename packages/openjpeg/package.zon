.{
    .name = "openjpeg",
    .version = "2.5.4",
    .release = 1,
    .description = "JPEG 2000 codec library and tools",
    .license = "BSD-2-Clause",
    .sources = .{
        .{ .url = "https://github.com/uclouvain/openjpeg/archive/v2.5.4/openjpeg-2.5.4.tar.gz", .sha256 = "a695fbe19c0165f295a8531b1e4e855cd94d0875d2f88ec4b61080677e27188a" },
    },
    // lcms2, libpng, tiff and zlib are used by the opj_compress,
    // opj_decompress and opj_dump tools.
    .depends = .{ "glibc", "lcms2", "libpng", "tiff", "zlib" },
    .build_depends = .{ "cmake", "pkgconf" },
}
