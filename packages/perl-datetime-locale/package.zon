.{
    .name = "perl-datetime-locale",
    .version = "1.45",
    .release = 1,
    .description = "Localisation support for Perl's DateTime",
    .license = "Artistic-1.0-Perl OR GPL-1.0-or-later",
    .sources = .{
        .{ .url = "https://cpan.metacpan.org/authors/id/D/DR/DROLSKY/DateTime-Locale-1.45.tar.gz", .sha256 = "1bc56dc2ff4b3152612e1d474ca65071ae2c00912e3fa4bc6f5a99e5e7a1da68" },
    },
    // The locale data is installed as a File::ShareDir share.
    .depends = .{ "perl", "perl-dist-checkconflicts", "perl-file-sharedir", "perl-params-validationcompiler", "perl-specio", "perl-namespace-autoclean" },
    .build_depends = .{ "perl", "perl-dist-checkconflicts", "perl-file-sharedir-install" },
}
