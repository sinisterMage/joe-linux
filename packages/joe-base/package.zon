.{
    .name = "joe-base",
    .version = "0.1",
    .release = 7,
    .description = "Everything a minimal joe Linux system consists of",
    .license = "MIT",
    .depends = .{
        "joe-filesystem",
        "joe-release",
        "linux",
        // Real computers: firmware for the drivers that load it, the
        // wireless regulatory database, and processor microcode.
        "linux-firmware",
        "wireless-regdb",
        "cpu-microcode",
        "glibc",
        "tzdata",
        "systemd",
        "dbus",
        "dave",
        "bash",
        "coreutils",
        "util-linux",
        "shadow",
        "kmod",
        "iproute2",
        "kbd",
        "procps-ng",
        "iana-etc",
        "findutils",
        "grep",
        "sed",
        "gawk",
        "less",
        "gzip",
        "xz",
        "zstd",
        "bzip2",
        "tar",
        "file",
        "diffutils",
        "btrfs-progs",
        // What a person at a console expects to find: becoming root, an
        // editor, the manual, a way in from another machine, and the tools
        // for the other file systems a disk may carry.
        "sudo",
        "vim",
        "nano",
        "man-db",
        "man-pages",
        "bash-completion",
        "openssh",
        "psmisc",
        "inetutils",
        "dosfstools",
        "e2fsprogs",
        "make-ca",
    },
}
