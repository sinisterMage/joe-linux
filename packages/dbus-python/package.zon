.{
    .name = "dbus-python",
    .version = "1.5.1",
    .release = 1,
    .description = "Python bindings for libdbus, with GLib main loop integration",
    .license = "MIT AND (GPL-2.0-or-later OR AFL-2.1)",
    .sources = .{
        .{ .url = "https://dbus.freedesktop.org/releases/dbus-python/dbus_python-1.5.1.tar.gz", .sha256 = "57423cf87d09b7d084f420b55b737fe654c33339b06df77945620d97795c6ac4" },
    },
    // _dbus_bindings links libdbus; _dbus_glib_bindings, the GLib main
    // loop (dbus.mainloop.glib), links GLib as well.
    .depends = .{ "glibc", "python", "dbus", "glib" },
    .build_depends = .{ "python", "meson-python", "meson", "ninja", "patchelf", "pkgconf" },
}
