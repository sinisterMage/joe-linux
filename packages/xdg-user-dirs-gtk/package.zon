.{
    .name = "xdg-user-dirs-gtk",
    .version = "0.16",
    .release = 1,
    .description = "Offers to rename the well-known user directories when the session language changes",
    .license = "GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/xdg-user-dirs-gtk/0.16/xdg-user-dirs-gtk-0.16.tar.xz", .sha256 = "be825de7f89175db5ead0cd3744d2761109c70943251a87092259163025520a9" },
    },
    // It runs xdg-user-dirs-update to do the renaming.
    .depends = .{ "glibc", "glib", "gtk3", "xdg-user-dirs" },
    // systemd: its pkg-config file tells where the user unit goes.
    // xdg-user-dirs: meson requires xdg-user-dirs-update to be present.
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "systemd", "xdg-user-dirs" },
}
