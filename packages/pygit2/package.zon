.{
    .name = "pygit2",
    .version = "1.21.0",
    .release = 1,
    .description = "Python bindings for libgit2",
    // The same linking exception as libgit2's (see that recipe).
    .license = "GPL-2.0-only WITH GCC-exception-2.0",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/p/pygit2/pygit2-1.21.0.tar.gz", .sha256 = "1e987fbef899d1bf12aecc10b33acc917d60266ca114428dfc260df4451a555f" },
    },
    // Two extension modules link libgit2 (1.9.x, which this release
    // requires): pygit2._pygit2, and pygit2._libgit2, compiled by cffi, which
    // needs cffi's backend at run time.
    .depends = .{ "glibc", "python", "libgit2", "cffi" },
    .build_depends = .{ "python", "setuptools", "wheel", "cffi" },
}
