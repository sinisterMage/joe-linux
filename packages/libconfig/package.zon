.{
    .name = "libconfig",
    .version = "1.8.3",
    .release = 1,
    .description = "C and C++ library for reading and writing structured configuration files",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        // Upstream publishes no checksum for the archive.
        .{ .url = "https://github.com/hyperrealm/libconfig/archive/v1.8.3/libconfig-1.8.3.tar.gz", .sha256 = "683f723d647befcdb36e1a4a61a83ae8c89dc7959ca872a7407b6c8152104162" },
    },
    // libconfig++ is C++ (libstdc++ from gcc).
    .depends = .{ "glibc", "gcc" },
    .build_depends = .{ "cmake", "ninja" },
}
