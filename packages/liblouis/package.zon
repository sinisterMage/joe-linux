.{
    .name = "liblouis",
    .version = "3.39.0",
    .release = 1,
    .description = "Braille translator and back-translator, with its translation tables and Python bindings",
    .license = "LGPL-2.1-or-later AND GPL-3.0-or-later",
    .sources = .{
        // Upstream publishes no checksum for its release tarballs.
        .{ .url = "https://github.com/liblouis/liblouis/releases/download/v3.39.0/liblouis-3.39.0.tar.gz", .sha256 = "629fa8cb0dfd9ad457c5bf47a42f0953b673e62c8ad6b1d03ddc4e2bd20008f1" },
    },
    // libyaml: lou_checkyaml, the tool that checks a table against tests
    // written in YAML. python: the louis module (used by Orca for
    // contracted braille), which loads liblouis with ctypes, and, with
    // perl, the scripts of lou_maketable.
    .depends = .{ "glibc", "libyaml", "python", "perl" },
    // help2man makes the manual pages from the tools' --help output.
    .build_depends = .{ "pkgconf", "help2man", "python", "setuptools", "wheel" },
}
