.{
    .name = "check",
    .version = "0.15.2",
    .release = 1,
    .description = "Unit testing framework for C, which runs each test in its own process",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        // Upstream publishes no checksum for the archive.
        .{ .url = "https://github.com/libcheck/check/releases/download/0.15.2/check-0.15.2.tar.gz", .sha256 = "a8de4e0bacfb4d76dd1c618ded263523b53b85d92a146d8835eb1a52932fa20a" },
    },
    // checkmk, which makes test suites from a short description, is an awk
    // script.
    .depends = .{ "glibc", "gawk" },
}
