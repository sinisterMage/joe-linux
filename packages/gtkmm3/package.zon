    },
    .depends = .{ "glibc", "gcc", "glib", "gtk3", "gdk-pixbuf", "cairo", "pango", "glibmm2.4", "cairomm1.0", "pangomm1.4", "atkmm1.6", "libsigcxx2" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "python" },
}
