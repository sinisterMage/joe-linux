.{
    .name = "gnome-control-center",
    .version = "51.1",
    .release = 2,
    .description = "GNOME Settings",
    .license = "GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/gnome-control-center/51/gnome-control-center-51.1.tar.xz", .sha256 = "1054976c2f1977f770ba134b872f547c89db7005e4422f09a96d521379c083cb" },
    },
    // cups, gnome-bluetooth and modemmanager (libmm-glib) are the Printers,
    // Bluetooth and Mobile Network panels, and mobile broadband in the
    // Network panel.
    // pulseaudio is the client library (libpulse) for the Sound panel.
    // wayland and libx11 are linked by the bundled libgxdp. tecla is the
    // keyboard layout viewer the Keyboard panel starts; shared-mime-info is
    // read by the default applications page.
    .depends = .{
        "glibc",
        "glib",
        "gtk4",
        "libadwaita",
        "gsettings-desktop-schemas",
        "gnome-desktop",
        "gnome-settings-daemon",
        "gnome-online-accounts",
        "accountsservice",
        "polkit",
        "colord",
        "colord-gtk",
        "gdk-pixbuf",
        "cairo",
        "fontconfig",
        "libepoxy",
        "libxml2",
        "json-glib",
        "pulseaudio",
        "gsound",
        "upower",
        "libgudev",
        "libwacom",
        "gcr4",
        "libsecret",
        "gnutls",
        "libpwquality",
        "krb5",
        "libgtop",
        "udisks",
        "networkmanager",
        "modemmanager",
        "cups",
        "gnome-bluetooth",
        "libnma",
        "ibus",
        "tecla",
        "shared-mime-info",
        "wayland",
        "libx11",
    },
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "python", "blueprint-compiler" },
}
