.{
    .name = "libshumate",
    .version = "1.7.0",
    .release = 1,
    .description = "GTK 4 widget for displaying maps",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/libshumate/1.7/libshumate-1.7.0.tar.xz", .sha256 = "3896cc4b6a7bf83141c27df23ce48cdd68467603bc6b764960307cdcbbef80e5" },
    },
    // protobuf-c decodes vector tiles; sqlite holds the tile cache.
    .depends = .{ "glibc", "glib", "gtk4", "cairo", "libsoup", "json-glib", "sqlite", "protobuf-c" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "gperf", "vala" },
}
