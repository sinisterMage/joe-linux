.{
    .name = "qt6-multimedia",
    .version = "6.12.0",
    .release = 1,
    .description = "Qt Multimedia: audio and video playback, recording and capture for Qt programs",
    .license = "LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only",
    .sources = .{
        // Checked against the SHA-256 download.qt.io publishes beside it.
        .{ .url = "https://download.qt.io/archive/qt/6.12/6.12.0/submodules/qtmultimedia-everywhere-src-6.12.0.tar.xz", .sha256 = "3143f53b64257ba2a0685c940f5dce476c75871ff86b516de45cfd54ea93a62d" },
    },
    // ffmpeg: the media backend; pulseaudio (libpulse): audio output and
    // input; libva: hardware video decoding; libx11, libxrandr, libxext:
    // capturing X11 screens and windows; mesa: EGL for DMA buffers. The
    // PipeWire screen capture loads libpipewire when it is used, so
    // pipewire is needed at run time rather than linked.
    .depends = .{
        "glibc",  "gcc",      "qt6",       "ffmpeg",  "pulseaudio",
        "libva",  "libx11",   "libxrandr", "libxext", "mesa",
        "pipewire",
    },
    .build_depends = .{ "cmake", "ninja", "pkgconf", "linux-api-headers" },
}
