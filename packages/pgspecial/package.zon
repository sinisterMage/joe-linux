.{
    .name = "pgspecial",
    .version = "2.2.1",
    .release = 1,
    .description = "psql's meta-commands (the backslash commands) for Python PostgreSQL clients",
    .license = "BSD-3-Clause",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/p/pgspecial/pgspecial-2.2.1.tar.gz", .sha256 = "da6c7fcc7bef7bb0132dc2046f74ec6513b1fe6f0c80e5528d630d14b7c4849d" },
    },
    .depends = .{ "python", "click", "sqlparse", "psycopg" },
    // setuptools-scm reads the version from the sdist's PKG-INFO.
    .build_depends = .{ "python", "setuptools", "setuptools-scm", "wheel" },
}
