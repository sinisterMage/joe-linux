.{
    .name = "audacious-plugins",
    .version = "4.6.2",
    .release = 1,
    .description = "Interfaces, decoders, outputs and effects for the Audacious audio player",
    // The plugin framework is BSD-2-Clause; the plugins carry their own
    // terms, mostly GPL-2.0-or-later, some GPL-3.0-or-later (skins,
    // notify, playback history) and LGPL-2.1-or-later (the game music
    // emulator and AdPlug code).
    .license = "BSD-2-Clause AND GPL-2.0-or-later AND GPL-3.0-or-later AND LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://distfiles.audacious-media-player.org/audacious-plugins-4.6.2.tar.bz2", .sha256 = "c295c65bdaae71775b4fa9eb206799c627b383c4f45444d637c714196daf8077" },
    },
    // Interfaces and GTK plugins: gtk3, cairo, pango, gdk-pixbuf. X11 only
    // plugins: libx11 (global hotkeys), libxrender and libxcomposite (the
    // on-screen display), mesa's libGL (the OpenGL spectrum analyser).
    // Decoders: ffmpeg, flac, mpg123, opusfile, libsndfile, libvorbis with
    // libogg, wavpack, fluidsynth (MIDI); zlib for the bundled console and
    // PSF/DS emulators. Outputs: alsa-lib, pulseaudio, pipewire, and the
    // file writer's flac, libvorbis and lame. Effects: libsamplerate
    // (resample, speed and pitch), soxr. Playlists: libxml2 (XSPF, ASX 3).
    // Others: curl and libxml2 (Last.fm scrobbler), json-glib (lyrics),
    // libnotify (notifications).
    .depends = .{
        "glibc",      "gcc",           "glib",       "zlib",       "audacious",
        "gtk3",       "cairo",         "pango",      "gdk-pixbuf", "libx11",
        "libxrender", "libxcomposite", "mesa",       "ffmpeg",     "flac",
        "mpg123",     "opusfile",      "libsndfile", "libvorbis",  "libogg",
        "wavpack",    "fluidsynth",    "alsa-lib",   "pulseaudio", "pipewire",
        "lame",       "libsamplerate", "soxr",       "libxml2",    "curl",
        "json-glib",  "libnotify",
    },
    // python runs glib's gdbus-codegen (the MPRIS 2 plugin).
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "python" },
}
