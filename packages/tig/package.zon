.{
    .name = "tig",
    .version = "2.6.1",
    .release = 1,
    .description = "Text-mode interface for Git: history, blame, staging and diffs",
    .license = "GPL-2.0-or-later",
    .sources = .{
        // Checked against upstream's tig-2.6.1.tar.gz.sha256.
        .{ .url = "https://github.com/jonas/tig/releases/download/tig-2.6.1/tig-2.6.1.tar.gz", .sha256 = "5adeabdcd93aa0423d618da8b878b53482bef6e0e9e1fe224acc0f18031fe91e" },
    },
    // tig runs git for everything it shows.
    .depends = .{ "glibc", "ncurses", "readline", "pcre2", "git" },
}
