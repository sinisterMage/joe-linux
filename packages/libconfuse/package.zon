.{
    .name = "libconfuse",
    .version = "3.4",
    .release = 1,
    .description = "Small C library for parsing configuration files",
    .license = "ISC",
    .sources = .{
        // Upstream publishes no checksum for 3.4 (earlier releases carried
        // .md5 assets).
        .{ .url = "https://github.com/libconfuse/libconfuse/releases/download/v3.4/confuse-3.4.tar.xz", .sha256 = "36bfa3928f9c323914c7c8317e8722cb22f41db69d7c9d4c24b4689fa955445d" },
    },
    // Messages are translated with glibc's gettext.
    .depends = .{"glibc"},
    .build_depends = .{},
}
