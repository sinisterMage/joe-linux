.{
    .name = "prompt-toolkit",
    .version = "3.0.53",
    .release = 1,
    .description = "Library for building interactive command lines and terminal applications in Python",
    .license = "BSD-3-Clause",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/p/prompt_toolkit/prompt_toolkit-3.0.53.tar.gz", .sha256 = "9ec8a0ad96d5c56148b3f914aa79c1564c3fde5d2e6b876e7bc327e353cf8fa6" },
    },
    // pygments is optional (lexers for syntax highlighting); every program
    // here that uses prompt_toolkit for SQL also depends on it.
    .depends = .{ "python", "wcwidth" },
    .build_depends = .{ "python", "setuptools", "wheel" },
}
