.{
    .name = "fish",
    .version = "4.9.3",
    .release = 1,
    .description = "Smart and user-friendly command line shell",
    .license = "GPL-2.0-only AND LGPL-2.0-or-later AND MIT AND PSF-2.0",
    .sources = .{
        // Upstream's release tarball. Its signature (fish-4.9.3.tar.xz.asc)
        // verifies with the signing subkey 7580377F08ADABFB3A9B1D6B7A6ED2326511A2ED
        // of Johannes Altmanninger, a fish maintainer.
        .{ .url = "https://github.com/fish-shell/fish-shell/releases/download/4.9.3/fish-4.9.3.tar.xz", .sha256 = "20998a25f73217ddcc19f499055fd587e9912d1ad6e7109120fbcf2871f0b98c" },
    },
    // cargo downloads the crates fish depends on, from crates.io and from
    // fish's own git forks (rust-pcre2, fluent-rs); they are not vendored
    // yet.
    .network = true,
    // libgcc_s (gcc) for unwinding; PCRE2 (8- and 32-bit) for "string
    // match -r" and friends. fish 4 no longer uses ncurses or terminfo.
    // Optional helpers it runs when present are not depended on: python3
    // (fish_config's web interface, fish_update_completions) and man.
    .depends = .{ "glibc", "gcc", "pcre2" },
    // Sphinx for the manual pages and the HTML manual; gettext's msgfmt for
    // the message catalogues.
    .build_depends = .{ "rust", "cmake", "ninja", "pkgconf", "sphinx", "gettext" },
}
