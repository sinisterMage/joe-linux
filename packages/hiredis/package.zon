.{
    .name = "hiredis",
    .version = "1.5.0",
    .release = 1,
    .description = "Minimalistic C client library for Redis and Valkey, with TLS support (hiredis_ssl)",
    .license = "BSD-3-Clause",
    .sources = .{
        // Upstream publishes no checksum for its release archives.
        .{ .url = "https://github.com/redis/hiredis/archive/v1.5.0/hiredis-1.5.0.tar.gz", .sha256 = "eec7ef8641d221e144a58d5ef8d733c8c75c7fd487097a233aacb4fa33981cfb" },
    },
    // openssl: libhiredis_ssl.
    .depends = .{ "glibc", "openssl" },
    .build_depends = .{},
}
