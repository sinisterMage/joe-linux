        .{ .url = "https://www.linuxfromscratch.org/patches/blfs/svn/avahi-0.9-rc5-ipv6_race_condition_fix-1.patch", .sha256 = "218c909581d0ca2c86c8145bb0797050d987a6b0ae3417949dbe2a6d55c49360" },
    },
    .depends = .{ "glibc", "glib", "dbus", "expat", "libdaemon", "libevent", "gdbm", "systemd", "python", "dbus-python" },
