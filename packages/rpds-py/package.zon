.{
    .name = "rpds-py",
    .version = "2026.9.1",
    .release = 1,
    .description = "Python bindings to the Rust rpds crate's persistent data structures, used by jsonschema",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/r/rpds-py/rpds_py-2026.9.1.tar.gz", .sha256 = "4793ef7f78268b124b73fa933440f01d258bbae01de9fa53e9080c9ab0425a12" },
    },
    // cargo downloads the crates rpds-py depends on from crates.io; they
    // are not vendored yet.
    .network = true,
    // A pyo3 extension module; libgcc_s (gcc) for unwinding.
    .depends = .{ "glibc", "gcc", "python" },
    .build_depends = .{ "python", "maturin", "rust" },
}
