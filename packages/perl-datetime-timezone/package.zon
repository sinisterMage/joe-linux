.{
    .name = "perl-datetime-timezone",
    .version = "2.68",
    .release = 1,
    .description = "Time zone objects for Perl's DateTime",
    .license = "Artistic-1.0-Perl OR GPL-1.0-or-later",
    .sources = .{
        .{ .url = "https://cpan.metacpan.org/authors/id/D/DR/DROLSKY/DateTime-TimeZone-2.68.tar.gz", .sha256 = "1c1285d911027d276f235b32a888ee7425c9ab356ee62cd126c4b3ee3ea659b3" },
    },
    // The time zone rules are Perl modules generated by upstream from the
    // Olson database (2026b in this release). The module cannot read the
    // system's compiled /usr/share/zoneinfo for its rules, so they stay as
    // upstream ships them. It does use /etc/localtime and /usr/share/zoneinfo
    // (tzdata), when present, to work out the name of the local zone.
    .depends = .{ "perl", "perl-class-singleton", "perl-module-runtime", "perl-params-validationcompiler", "perl-specio", "perl-try-tiny", "perl-namespace-autoclean" },
    .build_depends = .{"perl"},
}
