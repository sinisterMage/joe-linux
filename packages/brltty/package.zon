.{
    .name = "brltty",
    .version = "6.9.1",
    .release = 2,
    .description = "Daemon that gives braille displays access to the console, and BrlAPI, through which Orca uses them",
    .license = "LGPL-2.1-or-later",
    .sources = .{
        // Upstream publishes no checksum or signature for its tarballs.
        .{ .url = "https://brltty.app/archive/brltty-6.9.1.tar.xz", .sha256 = "cf4619ce1471690e4ecc5544ee6289cef6c5bdf5855a1ac8dcc63f5beedf108d" },
    },
    // Linked: libcap (dropping privileges), libsystemd and libudev (the
    // service, HID devices), ICU, expat (CLDR tables), liblouis
    // (contracted braille), PCRE2, Polkit (BrlAPI authorization, through
    // GLib), D-Bus and BlueZ (Bluetooth displays), ALSA (tones), ncurses
    // (brltty-pty, the TTY driver), eSpeak NG and Speech Dispatcher (the
    // speech drivers). python: the brlapi module. acl: the udev rules give
    // the brltty user access to devices with setfacl.
    .depends = .{
        "glibc",      "libcap",  "systemd",   "icu",       "expat",
        "liblouis",   "pcre2",   "polkit",    "glib",      "dbus",
        "bluez",      "alsa-lib", "ncurses",  "espeak-ng", "speech-dispatcher",
        "python",     "acl",     "bash",
    },
    // cython: the Python bindings. tcl runs the script that writes the
    // udev rules; doxygen makes BrlAPI's manual pages; gettext the
    // translations.
    .build_depends = .{ "pkgconf", "gettext", "cython", "setuptools", "tcl", "doxygen" },
}
