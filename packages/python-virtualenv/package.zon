.{
    .name = "python-virtualenv",
    .version = "21.15.6",
    .release = 2,
    .description = "Tool to create isolated Python environments",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://files.pythonhosted.org/packages/source/v/virtualenv/virtualenv-21.15.6.tar.gz", .sha256 = "c8b65c7d206ca6ef18de9352c160b3f04f66fff9f6b0ec8fd31f14688eba52c4" },
    },
    // The license is virtualenv's own. The pip and setuptools wheels it carries
    // to seed new environments keep theirs (MIT, plus what pip vendors).
    .depends = .{ "python", "distlib", "filelock", "packaging", "platformdirs", "python-discovery" },
    .build_depends = .{ "python", "hatchling", "hatch-vcs", "hatch-fancy-pypi-readme", "packaging" },
}
