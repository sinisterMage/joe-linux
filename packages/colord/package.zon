.{
    .name = "colord",
    .version = "1.4.8",
    .release = 1,
    .description = "System service that manages colour profiles of devices",
    .license = "GPL-2.0-or-later AND LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://www.freedesktop.org/software/colord/releases/colord-1.4.8.tar.xz", .sha256 = "21500bd68975312a7f0f3ce6019d9f75f42aacaa75ca7115ec720b5445406896" },
    },
    .depends = .{ "glibc", "glib", "lcms2", "sqlite", "libgusb", "libgudev", "polkit", "systemd", "dbus", "hwdata" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "vala", "gettext" },
}
