.{
    .name = "libjpeg-turbo",
    .version = "3.2.1",
    .release = 1,
    .description = "JPEG image codec that uses SIMD instructions, with the libjpeg API",
    .license = "IJG AND BSD-3-Clause AND Zlib",
    .sources = .{
        .{ .url = "https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/3.2.1/libjpeg-turbo-3.2.1.tar.gz", .sha256 = "c27ad72a68da151177929aa969ae773a2da5ac2af9ce946079314fdac8cece7f" },
    },
    .depends = .{"glibc"},
    // nasm assembles the SIMD routines.
    .build_depends = .{ "cmake", "nasm" },
}
