.{
    .name = "zoxide",
    .version = "0.10.0",
    .release = 1,
    .description = "Smarter cd command that remembers the directories you use most",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://github.com/ajeetdsouza/zoxide/archive/v0.10.0/zoxide-0.10.0.tar.gz", .sha256 = "4fcd4272b013a10b637dbcc299c58a9924b94470a9042677ca1a204cc2e9150e" },
    },
    // cargo downloads the crates zoxide depends on from crates.io; they are
    // not vendored yet.
    .network = true,
    // libgcc_s (gcc) for unwinding. Interactive selection ("zi", "zoxide
    // query -i") runs fzf when it is installed.
    .depends = .{ "glibc", "gcc" },
    .build_depends = .{"rust"},
}
