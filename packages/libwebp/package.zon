.{
    .name = "libwebp",
    .version = "1.6.0",
    .release = 1,
    .description = "Library and tools for the WebP image format",
    .license = "BSD-3-Clause",
    .sources = .{
        .{ .url = "https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.6.0.tar.gz", .sha256 = "e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564" },
    },
    // The image libraries are used by cwebp, dwebp and gif2webp to read and
    // write those formats.
    .depends = .{ "glibc", "libjpeg-turbo", "libpng", "tiff", "giflib" },
    .build_depends = .{ "pkgconf" },
}
