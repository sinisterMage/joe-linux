# Runs only on the first boots of a new deployment: boot-complete.target is
# pulled in by systemd-bless-boot-generator when the boot loader is counting
# attempts. systemd-bless-boot.service is ordered after boot-complete.target,
# so the deployment is marked good only if this check passes. If it fails, the
# machine reboots; after three failed attempts the boot loader returns to the
# previously chosen deployment on its own.
[Unit]
Description=Check that a new joe Linux deployment is healthy
After=multi-user.target
Before=boot-complete.target
FailureAction=reboot

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/dave boot-check
StandardOutput=journal+console
StandardError=journal+console
