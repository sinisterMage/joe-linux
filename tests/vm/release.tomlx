# A desktop nobody has set up yet, booted the way `make vm` and `make
# run-vm` boot one, and what living in that machine depends on: the root
# file system grows to fill a disk larger than the image, the first boot
# offers to create an account instead of a login prompt nobody could
# pass, a sound card appears, and a host directory can be shared.
#
# The image differs from the release image in one way: root is logged in
# on the serial console (--test), which is how the tests look inside.
#
#   release          the first boot and the second
#   release-share    a host directory shared with the machine (needs virtiofsd)

[tasks.joe-firstboot-image]
description = "build/images/joe-firstboot.img: the release image, with root on the serial console"
deps = ["dave"]
env = { PATH = "${path}" }
requires = { files = ["build/repo/repo.zon", "build/keys/joe.pub"], commands = ["mcopy", "unshare"] }
command = '''
mkdir -p build/images
dave/zig-out/bin/dave image build image/release.zon --test \
    --repo "joe,$PWD/build/repo,http://10.0.2.2:8643,$PWD/build/keys/joe.pub" \
    --out build/images/joe-firstboot.img
'''
inputs = ["image/**", "build/repo/repo.zon", "build/keys/joe.pub", "dave/zig-out/bin/dave"]
outputs = ["build/images/joe-firstboot.img"]
timeout = "1h"

# A new machine's disk, made by image/run.sh as `make vm` makes one.
[tasks.release-machine]
description = "build/images/release-machine/disk.img: the image on a new machine's 40G disk, by image/run.sh --persist --create"
deps = ["joe-firstboot-image"]
cache = false
command = '''
rm -rf build/images/release-machine
image/run.sh --persist build/images/release-machine --create --disk-size 40G build/images/joe-firstboot.img
size=$(stat -c %s build/images/release-machine/disk.img)
[ "$size" = $((40 << 30)) ] || { echo "the new disk is $size bytes, not 40G"; exit 1; }
'''

[machines.joe-release]
description = "a new machine with the release image, as make vm makes it"
use = "scaffold"
disk = "build/images/release-machine/disk.img"
memory = "6G"
cpus = 8
display = true
boot_timeout = "10m"
# A sound card with nowhere to play: only the guest's side is examined.
extra_args = ["-audiodev", "none,id=snd0", "-device", "intel-hda", "-device", "hda-duplex,audiodev=snd0"]

[tests.release]
description = "a new machine's first boot: the disk is filled, nobody has an account, the first-run setup starts, there is sound"
tags = ["vm", "joe", "release"]
deps = ["release-machine"]
machine = "joe-release"
timeout = "40m"
on_failure = [
  { run = 'systemctl --failed --no-legend --plain; journalctl -b --no-pager | tail -n 40' },
  { screenshot = "failed.png" },
]
steps = [
  { section = "the root file system grew to fill the disk on the first boot" },
  { run = 'systemctl is-active systemd-repart.service', exit = "any", equals = "active" },
  { run = 'systemctl is-active systemd-growfs-root.service', exit = "any", equals = "active" },
  { run = 'df -B1 --output=size / | tail -n 1', capture = "root_size" },
  { run = 'test {{root_size}} -gt $((38 << 30))', name = "/ is more than 38 GiB on a 40G disk ({{root_size}} bytes)" },
  # The partition table's backup was moved to the new end of the disk.
  { run = 'sfdisk --verify /dev/vda 2>&1', exit = "any", contains = "No errors detected" },

  { section = "nobody has an account, and root has no password" },
  { run = "awk -F: '$3 >= 1000 && $3 <= 60000 { print $1 }' /etc/passwd", equals = "", name = "no accounts" },
  { run = "grep -c '^root:!' /etc/shadow", equals = "1", name = "root is locked" },

  { section = "a sound card with playback and capture" },
  { run = 'cat /proc/asound/cards', contains = "HDA" },
  { run = 'cat /proc/asound/pcm', exit = "any", contains = ["playback", "capture"] },

  { section = "the display manager starts the first-run setup" },
  { run = 'systemctl is-active graphical.target', wait = "5m", interval = "3s" },
  { run = 'systemctl is-active gdm.service', wait = "3m", interval = "3s" },
  { run = 'pgrep -u gnome-initial-setup -f /usr/libexec/gnome-initial-setup', wait = "4m", interval = "3s", name = "gnome-initial-setup is running" },
  { run = 'sleep 20', name = "let it draw" },
  { screenshot = "1-initial-setup.png" },
  { run = 'systemctl --failed --no-legend --plain', exit = "any", name = "failed units" },

  { section = "a second boot changes nothing" },
  { reboot = {}, timeout = "10m" },
  { run = 'df -B1 --output=size / | tail -n 1', equals = "{{root_size}}", name = "/ is the size it was" },
  { run = 'systemctl is-failed systemd-repart.service', exit = "any", lacks = "failed", name = "systemd-repart.service did not fail" },
  { run = 'systemctl is-failed systemd-growfs-root.service', exit = "any", lacks = "failed", name = "systemd-growfs-root.service did not fail" },
  { run = 'pgrep -u gnome-initial-setup -f /usr/libexec/gnome-initial-setup', wait = "4m", interval = "3s", name = "gnome-initial-setup is running again" },
]

# On its own, since only it needs virtiofsd: without it, this test is
# skipped and the rest still run.
[tests.release-share]
description = "a host directory shared with a new machine, as make run-vm VM_ARGS='--share DIR' shares one"
tags = ["vm", "joe", "release"]
deps = ["release-machine"]
machine = { use = "joe-release", shares = [{ dir = "build/images/release-share", tag = "host" }] }
autoboot = false
timeout = "20m"
steps = [
  { host = '''
rm -rf build/images/release-share
mkdir -p build/images/release-share
echo "written on the host" > build/images/release-share/from-host
''', name = "a directory to share, with a file in it" },
  { boot = true },
  { run = 'mount -t virtiofs host /mnt' },
  { run = 'cat /mnt/from-host', equals = "written on the host" },
  # Everything there appears to belong to the first account, and what the
  # guest writes belongs on the host to whoever started the machine.
  { run = 'stat -c %u /mnt/from-host', equals = "1000", name = "the host's file belongs to the first account" },
  { run = 'echo written in the guest > /mnt/from-guest && umount /mnt' },
  { host = 'cat build/images/release-share/from-guest', equals = "written in the guest" },
  { host = 'test "$(stat -c %u build/images/release-share/from-guest)" = "$(id -u)"', name = "the guest's file belongs to this user on the host" },
]
