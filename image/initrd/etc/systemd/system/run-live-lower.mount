# The root as it was built: a compressed, read-only SquashFS image on the
# medium.
[Unit]
Description=joe Linux live root image
DefaultDependencies=no
RequiresMountsFor=/run/live/medium
Before=initrd-root-fs.target

[Mount]
What=/run/live/medium/joe/root.squashfs
Where=/run/live/lower
Type=squashfs
Options=loop,ro
