# The root as it was built: a compressed, read-only image on the medium.
[Unit]
Description=joe Linux live root image
DefaultDependencies=no
RequiresMountsFor=/run/live/medium
Before=initrd-root-fs.target

[Mount]
What=/run/live/medium/joe/root.erofs
Where=/run/live/lower
Type=erofs
Options=loop,ro
